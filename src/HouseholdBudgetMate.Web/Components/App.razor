@using HouseholdBudgetMate.Application.Shared
<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet"/>
    <link rel="icon" type="image/x-icon" href="@Constants.Favicon" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["HouseholdBudgetMate.Web.styles.css"]"/>
    <ImportMap/>
    <HeadOutlet @rendermode="InteractiveServer"/>
    <title>@Constants.Title</title>
</head>

<body>
<Routes @rendermode="InteractiveServer"/>
<ReconnectModal/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="_content/MudBlazor/MudBlazor.min.js"></script>
<script>
    window.downloadFile = function (fileName, base64String) {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = 'data:application/pdf;base64,' + base64String;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };
</script>
</body>

</html>
