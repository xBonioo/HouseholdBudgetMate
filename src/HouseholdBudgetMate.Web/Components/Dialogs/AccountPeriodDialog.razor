@using System.Globalization
@using HouseholdBudgetMate.Abstractions.Contracts.Accounts.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Common.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Dto
@using MudBlazor

<MudDialog>
    <DialogContent>
        <ActionForm OnSubmit="Save">
        <MudStack Spacing="3">
            <div>
                <MudText Typo="Typo.subtitle1">Wybierz miesiąc sald</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">Przełącz okres bez przewijania długiej listy miesięcy.</MudText>
            </div>

            <MudSelect T="int" @bind-Value="_year" Label="Rok" Variant="Variant.Outlined">
                @foreach (var year in AvailableYears)
                {
                    <MudSelectItem Value="@year">@year</MudSelectItem>
                }
            </MudSelect>

            <div class="account-period-grid">
                @foreach (var month in _months)
                {
                    var isSelectable = CanSelectPeriod(month.Value);
                    <MudButton Variant="@(_month == month.Value ? Variant.Filled : Variant.Outlined)"
                               Color="@(_month == month.Value ? Color.Primary : Color.Secondary)"
                               Class="@GetMonthButtonClass(month.Value, isSelectable)"
                               ButtonType="ButtonType.Button"
                               Disabled="@(!isSelectable)"
                               OnClick="() => SelectMonth(month.Value)">
                        <span>@month.Label</span>
                    </MudButton>
                }
            </div>
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Text" ButtonType="ButtonType.Button" OnClick="Cancel">Anuluj</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Check"
                           Disabled="@(!CanSelectPeriod(_month))"
                           ButtonType="ButtonType.Submit">
                    Wybierz
                </MudButton>
            </MudStack>
        </MudStack>
        </ActionForm>
    </DialogContent>
</MudDialog>

@code {
    private readonly IReadOnlyList<MonthOptionDto> _months = Enumerable.Range(1, 12)
        .Select(month => new MonthOptionDto(month, new DateTime(2000, month, 1).ToString("MMM", new CultureInfo("pl-PL"))))
        .ToList();

    private int _year;
    private int _month;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int SelectedYear { get; set; }
    [Parameter] public int SelectedMonth { get; set; }
    [Parameter] public int CurrentYear { get; set; }
    [Parameter] public int CurrentMonth { get; set; }
    [Parameter] public IReadOnlyList<int> AvailableYears { get; set; } = [];
    [Parameter] public IReadOnlyList<AvailableMonthDto> AvailablePlanMonths { get; set; } = [];
    protected override void OnInitialized()
    {
        _year = SelectedYear;
        _month = SelectedMonth;

        if (!AvailableYears.Contains(_year))
        {
            AvailableYears = AvailableYears.Append(_year).Distinct().OrderByDescending(x => x).ToList();
        }
    }

    private bool CanSelectPeriod(int month)
    {
        return HasMonthPlan(month) || IsPastOrCurrentMonth(month);
    }

    private bool HasMonthPlan(int month)
    {
        return AvailablePlanMonths.Any(x => x.Year == _year && x.Month == month);
    }

    private bool IsPastOrCurrentMonth(int month)
    {
        return ToMonthKey(_year, month) <= ToMonthKey(CurrentYear, CurrentMonth);
    }

    private static int ToMonthKey(int year, int month)
    {
        return (year * 12) + month;
    }

    private string GetMonthButtonClass(int month, bool isSelectable)
    {
        var classes = "account-period-month";

        if (_month == month)
        {
            classes += " account-period-month-selected";
        }

        if (!isSelectable)
        {
            classes += " account-period-month-empty";
        }

        return classes;
    }

    private void SelectMonth(int month)
    {
        _month = month;
    }

    private void Save()
    {
        if (!CanSelectPeriod(_month))
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(new AccountPeriodSelectionDto(_year, _month)));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
