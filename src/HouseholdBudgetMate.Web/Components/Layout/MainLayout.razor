@using HouseholdBudgetMate.Web.Components.Themes
@using HouseholdBudgetMate.Application.Kernel.Timing
@using System.Globalization
@using HouseholdBudgetMate.Abstractions.Contracts.Common.Dto
@using HouseholdBudgetMate.Abstractions.Interfaces
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Dto
@using HouseholdBudgetMate.Web.Services
@using MudBlazor

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject IDateTimeProvider DateTimeProvider
@inject IExpenseService ExpenseService
@inject ArchiveMonthsCacheService ArchiveCache
@inject IUserSessionService UserSessionService
@inject IDialogService DialogService
@inject IJSRuntime JS

@* Required *@
<MudThemeProvider Theme="@AppTheme.Default" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<UnsavedChangesGuard />

@if (!_sessionReady)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="py-12">
        <MudPaper Class="pa-6" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
                <MudText Typo="Typo.subtitle1">Przygotowuję profil użytkownika...</MudText>
            </MudStack>
        </MudPaper>
    </MudContainer>
}
else
{
    <div class="layout-root">
        <MudLayout>
        <MudAppBar Elevation="0" Dense="true" Class="app-shell-bar">
            
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="ToggleDrawer" Class="mobile-menu-button" aria-label="Otwórz menu" />
            
            @* ── Left nav (hidden on mobile via CSS, no JS needed) ── *@
            <div class="nav-desktop">
                <MudButton Variant="Variant.Text" Class="@GetNavClass("/")" StartIcon="@Icons.Material.Filled.Dashboard"
                           Href="/">
                    Dashboard
                </MudButton>

                <MudButton Variant="Variant.Text" Class="@GetNavClass("/plan")"
                           StartIcon="@Icons.Material.Filled.CalendarMonth" Href="@CurrentMonthHref">
                    Plan
                </MudButton>

                <MudButton Variant="Variant.Text" Class="@GetNavClass("/accounts")"
                           StartIcon="@Icons.Material.Filled.AccountBalanceWallet" Href="/accounts">
                    Konta
                </MudButton>

                <MudButton Variant="Variant.Text" Class="@GetNavClass("/recurring")"
                           StartIcon="@Icons.Material.Filled.Repeat" Href="/recurring">
                    Cykliczne
                </MudButton>

                <MudButton Variant="Variant.Text" Class="@GetNavClass("/statistics")"
                           StartIcon="@Icons.Material.Filled.BarChart" Href="/statistics">
                    Statystyki
                </MudButton>
            </div>

            @* ── Centered logo (absolute positioning in CSS) ── *@
            <div class="appbar-logo-center">
                <img src="images/logo.png" alt="logo" class="brand-logo" />
            </div>

            @* ── Push right nav to the right edge ── *@
            <MudSpacer />

            @* ── Right nav (hidden on mobile via CSS, no JS needed) ── *@
            <div class="nav-desktop">
                <MudButton Variant="Variant.Text"
                           Class="appbar-button"
                           StartIcon="@Icons.Material.Filled.Person"
                           OnClick="SwitchUserAsync">
                    @CurrentUserLabel
                </MudButton>

                <MudButton Variant="Variant.Text" Class="@GetNavClass("/categories")"
                           StartIcon="@Icons.Material.Filled.Category" Href="/categories">
                    Kategorie
                </MudButton>

                @if (IsAdminSession)
                {
                    <MudMenu Variant="Variant.Text"
                             Color="Color.Inherit"
                             Label="Admin"
                             Class="@GetNavClass("/admin")"
                             StartIcon="@Icons.Material.Filled.AdminPanelSettings">

                            <MudMenuItem Href="/admin/audit" Icon="@Icons.Material.Filled.ManageSearch">
                            Audyt
                        </MudMenuItem>
                        <MudMenuItem Href="/admin/config" Icon="@Icons.Material.Filled.Settings">
                            Konfiguracja
                        </MudMenuItem>
                        <MudMenuItem Href="/admin/backup" Icon="@Icons.Material.Filled.Backup">
                            Backup
                        </MudMenuItem>
                    </MudMenu>
                }

                <MudMenu Variant="Variant.Text" Color="Color.Inherit" Label="Archiwum" Class="appbar-button"
                         StartIcon="@Icons.Material.Filled.DateRange" MaxHeight="400">
                    @if (_monthGroups.Count == 0)
                    {
                        <MudMenuItem Disabled="true">Brak danych</MudMenuItem>
                    }
                    else
                    {
                        @for (var i = 0; i < _monthGroups.Count; i++)
                        {
                            var yearGroup = _monthGroups[i];
                            <MudMenuItem Disabled="true">@yearGroup.Year</MudMenuItem>
                            @foreach (var monthItem in yearGroup.Months.OrderByDescending(x => x.Month))
                            {
                                var href = $"/plan/{monthItem.Year}/{monthItem.Month}";
                                <MudMenuItem Href="@href">
                                    @monthItem.Label
                                </MudMenuItem>
                            }

                            @if (i < _monthGroups.Count - 1)
                            {
                                <MudDivider />
                            }
                        }
                    }
                </MudMenu>
            </div>

            @* ── Always-visible action button ── *@
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add"
                       Class="quick-add-button d-none d-sm-flex" Href="@($"{CurrentMonthHref}?addExpense=true")">
                Dodaj wydatek
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Secondary" Variant="Variant.Filled"
                           Class="quick-add-button d-flex d-sm-none" Href="@($"{CurrentMonthHref}?addExpense=true")"
                           aria-label="Dodaj wydatek" />

            @* ── Dark mode toggle ── *@
            <MudTooltip Text="@(_isDarkMode ? "Jasny motyw" : "Ciemny motyw")" Placement="Placement.Bottom">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                Color="Color.Inherit" OnClick="ToggleDarkMode" aria-label="Przełącz motyw" />
            </MudTooltip>
        </MudAppBar>

        <div class="mobile-sidebar-overlay @(_drawerOpen ? "is-open" : string.Empty)" @onclick="CloseDrawer"></div>

        <aside class="mobile-sidebar @(_drawerOpen ? "is-open" : string.Empty)">
            <MudStack Class="pa-3" Spacing="1">
                <MudText Typo="Typo.subtitle2" Class="px-2 pb-1 mobile-side-nav-title">Menu</MudText>
                <MudNavMenu Dense="true" Class="mobile-nav-menu">
                    <MudNavLink Class="mobile-nav-link" Href="/" Icon="@Icons.Material.Filled.Dashboard"
                                Match="NavLinkMatch.All" OnClick="CloseDrawer">Dashboard</MudNavLink>
                    <MudNavLink Class="mobile-nav-link" Href="@CurrentMonthHref"
                                Icon="@Icons.Material.Filled.CalendarMonth" OnClick="CloseDrawer">Plan</MudNavLink>
                    <MudNavLink Class="mobile-nav-link" Href="/accounts"
                                Icon="@Icons.Material.Filled.AccountBalanceWallet" OnClick="CloseDrawer">Konta</MudNavLink>
                    <MudNavLink Class="mobile-nav-link" Href="/recurring" Icon="@Icons.Material.Filled.Repeat"
                                OnClick="CloseDrawer">Cykliczne</MudNavLink>
                    <MudNavLink Class="mobile-nav-link" Href="/statistics" Icon="@Icons.Material.Filled.BarChart"
                                OnClick="CloseDrawer">Statystyki</MudNavLink>
                    <MudNavLink Class="mobile-nav-link" Href="/categories" Icon="@Icons.Material.Filled.Category"
                                OnClick="CloseDrawer">Kategorie</MudNavLink>
                    @if (IsAdminSession)
                    {
                        <MudNavLink Class="mobile-nav-link" Href="/admin/audit"
                                    Icon="@Icons.Material.Filled.ManageSearch" OnClick="CloseDrawer">Audyt</MudNavLink>
                        <MudText Typo="Typo.caption" Class="px-2 pt-2 hb-muted">Admin</MudText>
                        <MudNavLink Class="mobile-nav-link" Href="/admin/config"
                                    Icon="@Icons.Material.Filled.Settings" OnClick="CloseDrawer">Konfiguracja</MudNavLink>
                        <MudNavLink Class="mobile-nav-link" Href="/admin/backup"
                                    Icon="@Icons.Material.Filled.Backup" OnClick="CloseDrawer">Backup</MudNavLink>
                    }
                    <MudNavLink Class="mobile-nav-link" Icon="@Icons.Material.Filled.Person" OnClick="SwitchUserFromMobileAsync">
                        @CurrentUserLabel
                    </MudNavLink>
                </MudNavMenu>
            </MudStack>
        </aside>

        <MudMainContent Class="app-main-content">
            <MudContainer MaxWidth="@(IsPlanPage? MaxWidth.False: MaxWidth.Large)" Class="py-6">
                <CascadingValue Name="IsDarkMode" Value="@_isDarkMode">
                    @Body
                </CascadingValue>
            </MudContainer>
        </MudMainContent>
        </MudLayout>
    </div>
}

<div id="blazor-error-ui" data-nosnippet
     style="background-color:#c62828;color:white;padding:12px 16px;border-radius:4px;">
    An unhandled error has occurred.
    <a href="." class="reload" style="color:#fff;font-weight:bold;">Reload</a>
    <span class="dismiss" style="cursor:pointer;">🗙</span>
</div>

@code {
    private readonly CultureInfo _culture = new("pl-PL");
    private List<ArchiveYearMonthGroupDto> _monthGroups = [];
    private bool _drawerOpen;
    private bool _sessionReady;
    private bool _sessionInitializationStarted;
    private bool _isDarkMode;

    private string CurrentUserLabel => UserSessionService.CurrentUser?.Username ?? "Użytkownik";
    private string? CurrentBudgetOwnerUserId => UserSessionService.CurrentUser?.BudgetOwnerUserId;
    private bool IsAdminSession => UserSessionService.CurrentUser?.IsAdmin == true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }
    
    /// <summary>Computed once per render — safe to call before OnInitializedAsync.</summary>
    private string CurrentMonthHref
    {
        get
        {
            var now = DateTimeProvider.GetLocalDateTime();
            return $"/plan/{now.Year}/{now.Month}";
        }
    }

    private bool IsPlanPage
        => NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .StartsWith("plan/", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        ArchiveCache.CacheChanged += HandleArchiveCacheChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionInitializationStarted)
        {
            return;
        }

        _sessionInitializationStarted = true;
        await EnsureUserSessionAsync();
    }

    private async Task EnsureUserSessionAsync()
    {
        try
        {
            var restored = await UserSessionService.TryRestoreFromCookieAsync(CancellationToken.None);
            if (!restored)
            {
                await OpenUserLoginDialogAsync();
            }

            _sessionReady = UserSessionService.CurrentUser is not null;
            if (!_sessionReady)
            {
                return;
            }

            await LoadAndCacheMonthsAsync();

            // Restore dark-mode preference from cookie (per-user)
            var darkCookieName = $"hbm-dark-{UserSessionService.CurrentUser?.Id}";
            var darkCookie = await JS.InvokeAsync<string?>("householdBudgetMate.cookies.get", darkCookieName);
            if (darkCookie == "1")
            {
                _isDarkMode = true;
                await JS.InvokeVoidAsync("document.documentElement.classList.add", "hbm-dark");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // If DB is unavailable, fall back to the current month so the bar stays functional.
            if (_monthGroups.Count == 0)
                SetFallbackMonthGroup();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenUserLoginDialogAsync()
    {
        while (UserSessionService.CurrentUser is null)
        {
            var options = new DialogOptions
            {
                CloseButton = false,
                MaxWidth = MaxWidth.Small,
                FullWidth = true
            };

            var dialog = await DialogService.ShowAsync<UserLoginDialog>("Logowanie", options);
            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                return;
            }
        }
    }

    private async Task SwitchUserAsync()
    {
        _sessionReady = false;
        _monthGroups = [];
        ArchiveCache.Invalidate();
        await InvokeAsync(StateHasChanged);

        await UserSessionService.SignOutAsync();
        await OpenUserLoginDialogAsync();

        _sessionReady = UserSessionService.CurrentUser is not null;
        if (_sessionReady)
        {
            await LoadAndCacheMonthsAsync();
            NavigationManager.NavigateTo("/");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SwitchUserFromMobileAsync()
    {
        CloseDrawer();
        await SwitchUserAsync();
    }

    private void HandleArchiveCacheChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (ArchiveCache.TryGetCache(CurrentBudgetOwnerUserId, out var cached))
            {
                _monthGroups = BuildMonthGroups(cached);
            }
            else
            {
                await LoadAndCacheMonthsAsync();
            }

            StateHasChanged();
        });
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!_drawerOpen)
            return;

        _drawerOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ArchiveCache.CacheChanged -= HandleArchiveCacheChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    /// <summary>
    /// Uses the semaphore to avoid a cache stampede when many circuits initialise at once.
    /// The timeout ensures we never hang the layout for longer than ~10 s even with EF retries.
    /// </summary>
    private async Task LoadAndCacheMonthsAsync()
    {
        // Wait at most 10 s to enter the lock (another circuit may already be loading).
        if (!await ArchiveCache.Semaphore.WaitAsync(TimeSpan.FromSeconds(10)))
        {
            // Timed out waiting for the lock — try the cache one more time, then give up.
            if (ArchiveCache.TryGetCache(CurrentBudgetOwnerUserId, out var cached))
                _monthGroups = BuildMonthGroups(cached);
            else
                SetFallbackMonthGroup();
            return;
        }

        try
        {
            // Double-check: another circuit may have populated the cache while we were waiting.
            if (ArchiveCache.TryGetCache(CurrentBudgetOwnerUserId, out var cached))
            {
                _monthGroups = BuildMonthGroups(cached);
                return;
            }

            // Limit the DB call to 5 s — prevents EF retry logic from blocking for minutes.
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            var months = await ExpenseService.GetAvailableMonthsAsync(cts.Token);

            ArchiveCache.UpdateCache(CurrentBudgetOwnerUserId, months);
            _monthGroups = BuildMonthGroups(months);

            if (_monthGroups.Count == 0)
                SetFallbackMonthGroup();
        }
        finally
        {
            ArchiveCache.Semaphore.Release();
        }
    }

    private List<ArchiveYearMonthGroupDto> BuildMonthGroups(IReadOnlyList<AvailableMonthDto> months)
    {
        var groups = months
            .GroupBy(x => x.Year)
            .OrderByDescending(x => x.Key)
            .Select(yearGroup => new ArchiveYearMonthGroupDto
            {
                Year = yearGroup.Key,
                Months = yearGroup
                    .OrderByDescending(x => x.Month)
                    .Select(x => new ArchiveMonthLinkDto
                    {
                        Year = x.Year,
                        Month = x.Month,
                        Label = $"{(x.IsClosed ? "(🔒) " : string.Empty)}{new DateTime(x.Year, x.Month, 1).ToString("MMMM", _culture)}"
                    })
                    .ToList()
            })
            .ToList();

        return groups;
    }

    private void SetFallbackMonthGroup()
    {
        var now = DateTimeProvider.GetLocalDateTime();
        _monthGroups =
        [
            new ArchiveYearMonthGroupDto
            {
                Year = now.Year,
                Months = [new ArchiveMonthLinkDto { Year = now.Year, Month = now.Month, Label = now.ToString("MMMM", _culture) }]
            }
        ];
    }

    private string GetNavClass(string pathPrefix)
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var normalized = string.IsNullOrWhiteSpace(currentPath) ? "/" : $"/{currentPath}";

        var isActive = pathPrefix == "/"
            ? normalized == "/"
            : normalized.StartsWith(pathPrefix, StringComparison.OrdinalIgnoreCase);

        return isActive
            ? "appbar-button appbar-button-active"
            : "appbar-button";
    }

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("document.documentElement.classList.toggle", "hbm-dark", _isDarkMode);
        var darkCookieName = $"hbm-dark-{UserSessionService.CurrentUser?.Id}";
        await JS.InvokeVoidAsync("householdBudgetMate.cookies.set", darkCookieName, _isDarkMode ? "1" : "0", 365);
    }
}
