@using Microsoft.AspNetCore.Components.Web

<form class="@GetCssClass()"
      @onsubmit="HandleFormSubmitAsync"
      @onsubmit:preventDefault="true"
      @onsubmit:stopPropagation="true"
      @onkeydown="HandleKeyDownAsync">
    @ChildContent
</form>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool SubmitOnEnter { get; set; } = true;

    private bool _isSubmitting;
    private DateTimeOffset _lastKeyboardSubmitAt;

    private string GetCssClass()
    {
        return string.IsNullOrWhiteSpace(Class)
            ? "hb-action-form"
            : $"hb-action-form {Class}";
    }

    private async Task HandleFormSubmitAsync()
    {
        if (DateTimeOffset.UtcNow - _lastKeyboardSubmitAt < TimeSpan.FromMilliseconds(250))
        {
            return;
        }

        await SubmitAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (!SubmitOnEnter
            || (args.Key != "Enter" && args.Key != "NumpadEnter")
            || args.ShiftKey
            || args.CtrlKey
            || args.AltKey
            || args.MetaKey)
        {
            return;
        }

        _lastKeyboardSubmitAt = DateTimeOffset.UtcNow;
        await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        if (_isSubmitting || !OnSubmit.HasDelegate)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            await OnSubmit.InvokeAsync();
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
