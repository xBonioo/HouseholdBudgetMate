@using HouseholdBudgetMate.Application.Shared
@using HouseholdBudgetMate.Abstractions.Contracts.Files.Dto
@using HouseholdBudgetMate.Abstractions.Enums
@using HouseholdBudgetMate.Abstractions.Extensions
@using HouseholdBudgetMate.Abstractions.Interfaces
@using HouseholdBudgetMate.Web.Components.Dialogs
@using MudBlazor
@inject IFileService FileService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudCard Outlined="true" Class="pa-4" Elevation="@Elevation">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-3">Załączone pliki (@Files.Count)</MudText>

        @if (Files.Any())
        {
            @if (ShowAsTable)
            {
                <MudTable Items="@Files" Hover="true" Dense="true" Class="mb-4">
                    <HeaderContent>
                        <MudTh>Nazwa pliku</MudTh>
                        <MudTh>Rozmiar</MudTh>
                        <MudTh>Data dodania</MudTh>
                        <MudTh Style="text-align: right;">Akcje</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Nazwa">
                            <MudLink Href="@GetFileUrl(context.Name)" Target="_blank">
                                @context.Name
                            </MudLink>
                        </MudTd>
                        <MudTd DataLabel="Rozmiar">@FormatSize(context.Length)</MudTd>
                        <MudTd DataLabel="Data">@context.CreationTime.ToString("dd.MM.yyyy HH:mm:ss")</MudTd>
                        <MudTd DataLabel="Akcje" Style="text-align: right;">
                            <MudTooltip Text="Podgląd">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Href="@GetFileUrl(context.Name)"
                                               Target="_blank"/>
                            </MudTooltip>
                            <MudTooltip Text="Usuń">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => FileDeletionConfirmation(context.Name))"/>
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudList T="FileInfo">
                    @foreach (var file in Files)
                    {
                        <MudListItem>
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudLink Href="@GetFileUrl(file.Name)" Target="_blank" Typo="Typo.body2">
                                        @file.Name
                                    </MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @FormatSize(file.Length) • @file.CreationTime.ToString("dd.MM.yyyy HH:mm:ss")
                                    </MudText>
                                </MudStack>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Href="@GetFileUrl(file.Name)"
                                                   Target="_blank"
                                                   Title="Podgląd"/>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => FileDeletionConfirmation(file.Name))"
                                                   Title="Usuń"/>
                                </MudStack>
                            </MudStack>
                        </MudListItem>
                        <MudDivider/>
                    }
                </MudList>
            }
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Brak załączonych plików
            </MudAlert>
        }

        <MudDivider Class="my-3"/>
        
        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                       Accept="@string.Join(",", Constants.AllowedExtensions)"
                       OnFilesChanged="OnInputFileChange"
                       AppendMultipleFiles="true"
                       Hidden="false"
                       InputClass="file-upload-input"
                       @ondrop="ClearDragClass"
                       @ondragenter="SetDragClass"
                       @ondragleave="ClearDragClass"
                       @ondragend="ClearDragClass">

            <CustomContent>
                <MudPaper Height="500px"
                          Outlined="true"
                          Class="@_dragClass">

                    <MudStack AlignItems="AlignItems.Center"
                              Justify="Justify.Center"
                              Style="height:100%">

                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload"
                                 Size="Size.Large"/>

                        <MudText Typo="Typo.subtitle1">
                            Przeciągnij pliki tutaj lub kliknij aby wybrać
                        </MudText>

                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            PDF, JPG, PNG, DOC, DOCX, XLS, XLSX (max 10MB)
                        </MudText>

                    </MudStack>

                </MudPaper>
            </CustomContent>
        </MudFileUpload>

    </MudCardContent>
</MudCard>

@code {
    [Parameter] public int EntityId { get; set; }
    [Parameter] public FileContextType ContextType { get; set; }
    [Parameter] public List<FileInfo> Files { get; set; } = new();
    [Parameter] public EventCallback OnFileAdded { get; set; }

    [Parameter] public bool ShowAsTable { get; set; }
    [Parameter] public int Elevation { get; set; }
    [Parameter] public Size ButtonSize { get; set; } = Size.Medium;
    [Parameter] public bool AutoRefresh { get; set; } = true;
    
    private const string DefaultDragClass =
        "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full";
    private string _dragClass = DefaultDragClass;
    
    private bool _uploading;
    private const long MaxFileSize = 10 * 1024 * 1024; // 10 MB

    private void SetDragClass()
    {
        _dragClass = $"{DefaultDragClass} mud-border-primary";
    }

    private void ClearDragClass()
    {
        _dragClass = DefaultDragClass;
    }
    
    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        _uploading = true;
        var errors = new List<string>();

        try
        {
            var files = e.GetMultipleFiles();
            foreach (var file in files)
            {
                var memoryStream = new MemoryStream();

                await using (var stream = file.OpenReadStream(MaxFileSize))
                {
                    await stream.CopyToAsync(memoryStream);
                }

                memoryStream.Position = 0;

                var model = new FileUploadDto
                {
                    Name = file.Name,
                    Size = file.Size,
                    Content = memoryStream
                };

                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));

                var fileErrors = await FileService.SaveFileAsync(EntityId, model, ContextType, cts.Token);
                errors.AddRange(fileErrors);
            }

            if (errors.Any())
            {
                foreach (var error in errors)
                {
                    Snackbar.Add(error, Severity.Error);
                }
            }
            else
            {
                Snackbar.Add("Pliki zostały dodane", Severity.Success);

                if (AutoRefresh)
                {
                    RefreshFileList();
                }

                await OnFileAdded.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
            ClearDragClass();
        }
    }

    private async Task FileDeletionConfirmation(string nazwaPliku)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Czy na pewno chcesz usunąć plik \"{nazwaPliku}\"?",
            ["ButtonText"] = "Usuń",
            ["Color"] = Color.Error
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = await DialogService.ShowAsync<DeleteFileDialog>("Potwierdź usunięcie", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await DeleteFile(nazwaPliku);
        }
    }

    private async Task DeleteFile(string nazwaPliku)
    {
        try
        {
            //FileService.DeleteFile(EntityId, nazwaPliku, ContextType);
            Snackbar.Add("Plik został usunięty", Severity.Success);

            if (AutoRefresh)
            {
                RefreshFileList();
            }

            await OnFileAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd podczas usuwania pliku: {ex.Message}", Severity.Error);
        }
    }

    private void RefreshFileList()
    {
        //Files = FileService.GetFiles(EntityId, ContextType);
        StateHasChanged();
    }

    public void Refresh()
    {
        RefreshFileList();
    }

    private string FormatSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        var order = 0;

        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }

    private string GetFileUrl(string fileName)
    {
        return $"/files/{ContextType.GetDisplayName()}-{EntityId}/{Uri.EscapeDataString(fileName)}";
    }

}