@page "/accounts"
@using System.Globalization
@using HouseholdBudgetMate.Abstractions.Contracts.Accounts.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Accounts.Requests
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Dto
@using HouseholdBudgetMate.Abstractions.Enums
@using HouseholdBudgetMate.Abstractions.Extensions
@using HouseholdBudgetMate.Abstractions.Interfaces
@using HouseholdBudgetMate.Application.Kernel.Timing
@using MudBlazor

@inject IDateTimeProvider DateTimeProvider
@inject IAccountService AccountService
@inject IExpenseService ExpenseService
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

<MudOverlay Visible="@_isLoading" Absolute="true" DarkBackground="true">
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
</MudOverlay>

<div class="accounts-drag">
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Filled">
            Nie udało się załadować kont: @_loadError
        </MudAlert>
    }

    <MudPaper Class="hb-page-header">
        <MudText Typo="Typo.h4">Stan kont na koniec miesiąca</MudText>
        <MudText Typo="Typo.body2" Class="hb-muted">
            Salda edytujesz szybko dla wybranego miesiąca.
        </MudText>
    </MudPaper>
    <MudGrid Class="mt-4">
        <MudItem xs="12" md="4">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Liczba kont</MudText>
                <MudText Class="hb-kpi-value">@_accounts.Count</MudText>
            </MudPaper>
        </MudItem>
        @if (!IsSelectedMonthClosed())
        {
            <MudItem xs="12" md="4">
                <MudPaper Class="hb-kpi-card">
                    <MudText Typo="Typo.caption" Class="hb-muted">Łączne saldo aktywnych kont</MudText>
                    <MudText Class="hb-kpi-value">@GetActiveNonSavingsTotalForSelectedMonth().ToString("0.00", _culture) PLN</MudText>
                </MudPaper>
            </MudItem>
        }
        else
        {
            <MudItem xs="12" md="4">
                <MudPaper Class="hb-kpi-card">
                    <MudText Typo="Typo.caption" Class="hb-muted">Łączne saldo kont</MudText>
                    <MudText Class="hb-kpi-value">@GetAllTotalForSelectedMonth().ToString("0.00", _culture) PLN</MudText>
                </MudPaper>
            </MudItem>
        }
        <MudItem xs="12" md="4">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Saldo + oszczędności</MudText>
                <MudText Class="hb-kpi-value">@GetActiveTotalForSelectedMonth().ToString("0.00", _culture) PLN</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
    <MudPaper Class="pa-4 mt-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Nowe konto</MudText>
        <ActionForm OnSubmit="CreateAccountAsync">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_createModel.Name" Label="Nazwa" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="AccountType" @bind-Value="_createModel.Type" Label="Typ" Variant="Variant.Outlined">
                    @foreach (var accountType in _accountTypes)
                    {
                        <MudSelectItem Value="@accountType">@accountType.GetDisplayName()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField T="string" @bind-Value="_createClosingBalanceInput"
                              Label="Saldo"
                              Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Dodaj konto
                </MudButton>
            </MudItem>
        </MudGrid>
        </ActionForm>
    </MudPaper>
    <MudPaper Class="pa-4 mt-4 hb-panel">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6">Salda miesięczne</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudSelect T="int" Value="_selectedYear" ValueChanged="OnSelectedYearChanged" Label="Rok"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var year in _availableYears)
                    {
                        <MudSelectItem Value="@year">@year</MudSelectItem>
                    }
                </MudSelect>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    @foreach (var month in _availableMonthsForSelectedYear)
                    {
                        <MudChip T="int"
                                 Value="@month"
                                 Variant="@(_selectedMonth == month ? Variant.Filled : Variant.Outlined)"
                                 Color="@(_selectedMonth == month ? Color.Primary : Color.Default)"
                                 OnClick="() => OnSelectedMonthChipClicked(month)">
                            @GetMonthLabel(month)
                        </MudChip>
                    }
                    @if (TryGetNextMonthCandidate() is { } nextMonth)
                    {
                        <MudChip T="int" Variant="Variant.Outlined" Color="Color.Secondary"
                                 OnClick="() => AddNextMonthToSelection(nextMonth)">
                            + @GetMonthLabel(nextMonth)
                        </MudChip>
                    }
                </MudStack>
            </MudStack>
        </MudStack>
        @if (IsSelectedMonthClosed())
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2 mb-2">
                Wybrany miesiąc jest zamknięty. Możesz tylko podejrzeć zapisane salda.
            </MudAlert>
        }
        <ActionForm OnSubmit="SaveAllSelectedMonthBalancesAsync">
        <MudTable Items="GetAccountsForSelectedMonth()" Dense="true" Hover="true"
                  Class="mt-2">
            <HeaderContent>
                <MudTh>Konto</MudTh>
                <MudTh>Typ</MudTh>
                <MudTh>Saldo dla wybranego miesiąca</MudTh>
            </HeaderContent>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-3 hb-muted">@(IsSelectedMonthClosed() ? "Brak sald dla kont w wybranym zamkniętym miesiącu." : "Brak aktywnych kont.")</MudText>
            </NoRecordsContent>
            <RowTemplate Context="account">
                <MudTd>@account.Name</MudTd>
                <MudTd>@account.Type.GetDisplayName()</MudTd>
                <MudTd>
                    @if (IsSelectedMonthClosed())
                    {
                        <MudText Typo="Typo.body2">@GetSelectedMonthAmount(account.Id).ToString("0.00", _culture)</MudText>
                    }
                    else
                    {
                        <MudTextField T="string" Value="GetSelectedMonthAmountInput(account.Id)"
                                      ValueChanged="(value) => SetSelectedMonthAmountInputAsync(account.Id, value)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"/>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="IsSelectedMonthClosed()" ButtonType="ButtonType.Submit">Zapisz
                wszystkie
            </MudButton>
        </MudStack>
        </ActionForm>
    </MudPaper>
    <MudPaper Class="pa-4 mt-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Konta</MudText>
        <MudTable Items="_accounts.OrderBy(x => x.Order).ToList()" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh Class="account-order-cell">Kolejność</MudTh>
                <MudTh>Nazwa</MudTh>
                <MudTh>Typ</MudTh>
                <MudTh>Saldo</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Akcje</MudTh>
            </HeaderContent>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-3 hb-muted">Brak kont do wyświetlenia.</MudText>
            </NoRecordsContent>
            <RowTemplate Context="account">
                <MudTd Class="account-order-cell">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption">@account.Order</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                       Size="Size.Small"
                                       Class="manual-order-action"
                                       Disabled="@IsFirstAccount(account.Id)"
                                       OnClick="() => MoveAccountAsync(account.Id, -1)"/>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                       Size="Size.Small"
                                       Class="manual-order-action"
                                       Disabled="@IsLastAccount(account.Id)"
                                       OnClick="() => MoveAccountAsync(account.Id, 1)"/>
                    </MudStack>
                </MudTd>

                @if (_editModel?.Id == account.Id)
                {
                    <ActionForm OnSubmit="SaveEditAsync">
                    <MudTd>
                        <MudTextField @bind-Value="_editModel.Name" Margin="Margin.Dense" Variant="Variant.Outlined"/>
                    </MudTd>
                    <MudTd>
                        <MudSelect T="AccountType" @bind-Value="_editModel.Type" Margin="Margin.Dense"
                                   Variant="Variant.Outlined">
                            @foreach (var type in _accountTypes)
                            {
                                <MudSelectItem Value="@type">@type.GetDisplayName()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd>@account.CurrentBalance.ToString("0.00") PLN</MudTd>
                    <MudTd>
                        <MudChip T="bool" Color="@(account.IsArchived ? Color.Warning : Color.Success)">
                            @(account.IsArchived ? "Archiwalne" : "Aktywne")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" ButtonType="ButtonType.Submit">Zapisz</MudButton>
                        <MudButton Size="Size.Small" ButtonType="ButtonType.Button" OnClick="CancelEdit">Anuluj</MudButton>
                    </MudTd>
                    </ActionForm>
                }
                else
                {
                    <MudTd>@account.Name</MudTd>
                    <MudTd>@account.Type.GetDisplayName()</MudTd>
                    <MudTd>@account.CurrentBalance.ToString("0.00") zł</MudTd>
                    <MudTd>
                        <MudChip T="bool" Color="@(account.IsArchived ? Color.Warning : Color.Success)">
                            @(account.IsArchived ? "Archiwalne" : "Aktywne")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" OnClick="() => BeginEdit(account)">Edytuj</MudButton>
                        <MudButton Size="Size.Small" OnClick="() => ToggleArchiveAsync(account)">
                            @(account.IsArchived ? "Przywróć" : "Archiwizuj")
                        </MudButton>
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAccountAsync(account)">
                            Usuń
                        </MudButton>
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>

        @if (_accounts.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mt-2 hb-muted">Brak kont do wyświetlenia.</MudText>
        }
    </MudPaper>
</div>

@code {
    private bool _isLoading;
    private List<AccountDto> _accounts = [];
    private readonly CultureInfo _culture = new("pl-PL");

    private CreateAccountRequest _createModel = new() { Type = AccountType.Bank };
    private string _createClosingBalanceInput = string.Empty;
    private UpdateAccountRequest? _editModel;
    private readonly AccountType[] _accountTypes = Enum.GetValues<AccountType>();

    private readonly IReadOnlyList<MonthOption> _monthOptions = Enumerable.Range(1, 12)
        .Select(month => new MonthOption(month, new DateTime(2000, month, 1).ToString("MMMM", new CultureInfo("pl-PL"))))
        .ToList();

    private int _selectedYear;
    private int _selectedMonth;
    private List<int> _availableYears = [];
    private List<int> _availableMonthsForSelectedYear = [];
    private IReadOnlyList<AvailableMonthDto> _availablePlanMonths = [];
    private readonly Dictionary<int, decimal> _selectedMonthAmounts = new();
    private readonly Dictionary<int, string> _selectedMonthAmountInputs = new();
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        var today = DateTimeProvider.GetLocalDateOnly();
        _selectedYear = today.Year;
        _selectedMonth = today.Month;
        _availableYears = [today.Year];

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            _accounts = (await AccountService.GetAllAsync(CancellationToken.None)).OrderBy(x => x.Order).ToList();

            var availablePlanMonths = await ExpenseService.GetAvailableMonthsAsync(CancellationToken.None);
            _availablePlanMonths = availablePlanMonths;
            _availableYears = availablePlanMonths
                .Select(x => x.Year)
                .Concat(_accounts.SelectMany(x => x.MonthBalances).Select(x => x.Year))
                .Distinct()
                .OrderByDescending(x => x)
                .ToList();

            var currentYear = DateTimeProvider.GetLocalDateOnly().Year;
            if (!_availableYears.Contains(_selectedYear))
            {
                _selectedYear = _availableYears.Count > 0 ? _availableYears[0] : currentYear;
            }

            SyncAvailableMonthsForSelectedYear();
            SyncSelectedMonthAmounts();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateAccountAsync()
    {
        if (!TryParseLocalizedDecimal(_createClosingBalanceInput, out var closingBalance))
        {
            Snackbar.Add("Niepoprawny format salda. Uzyj np. 1234,56 lub 1234.56.", Severity.Warning);
            return;
        }

        _createModel.ClosingBalance = closingBalance;

        try
        {
            await AccountService.CreateAccountAsync(_createModel, CancellationToken.None);
            _createModel = new CreateAccountRequest { Type = AccountType.Bank };
            _createClosingBalanceInput = string.Empty;
            await LoadAsync();
            Snackbar.Add("Dodano konto.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void BeginEdit(AccountDto account)
    {
        _editModel = new UpdateAccountRequest
        {
            Id = account.Id,
            Name = account.Name,
            Type = account.Type
        };
    }

    private async Task SaveEditAsync()
    {
        if (_editModel is null)
        {
            return;
        }

        try
        {
            await AccountService.UpdateAccountAsync(_editModel, CancellationToken.None);
            _editModel = null;
            await LoadAsync();
            Snackbar.Add("Zapisano konto.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelEdit()
    {
        _editModel = null;
    }

    private async Task DeleteAccountAsync(AccountDto account)
    {
        var confirmation = await JsRuntime.InvokeAsync<bool>("confirm", $"Usunac konto '{account.Name}'?");
        if (!confirmation)
        {
            return;
        }

        try
        {
            await AccountService.DeleteAccountAsync(new DeleteAccountRequest { Id = account.Id }, CancellationToken.None);
            await LoadAsync();
            Snackbar.Add("Usunieto konto.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ToggleArchiveAsync(AccountDto account)
    {
        try
        {
            await AccountService.SetAccountArchivedAsync(new SetAccountArchivedRequest
            {
                Id = account.Id,
                IsArchived = !account.IsArchived
            }, CancellationToken.None);

            await LoadAsync();
            Snackbar.Add(account.IsArchived ? "Przywrócono konto." : "Zarchiwizowano konto.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task MoveAccountAsync(int accountId, int direction)
    {
        var ordered = _accounts.OrderBy(x => x.Order).ToList();
        var index = ordered.FindIndex(x => x.Id == accountId);

        if (index == -1)
        {
            return;
        }

        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= ordered.Count)
            return;

        (ordered[index], ordered[newIndex]) = (ordered[newIndex], ordered[index]);

        try
        {
            await AccountService.ReorderAccountsAsync(new ReorderAccountsRequest
            {
                AccountIds = ordered.Select(x => x.Id).ToList()
            }, CancellationToken.None);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private bool IsFirstAccount(int accountId)
    {
        var ordered = _accounts.OrderBy(x => x.Order).ToList();
        return ordered.Count == 0 || ordered[0].Id == accountId;
    }

    private bool IsLastAccount(int accountId)
    {
        var ordered = _accounts.OrderBy(x => x.Order).ToList();
        return ordered.Count == 0 || ordered[^1].Id == accountId;
    }

    private AccountMonthBalanceDto? TryGetSelectedMonthBalance(int accountId)
    {
        return _accounts.FirstOrDefault(x => x.Id == accountId)?.MonthBalances
            .FirstOrDefault(x => x.Year == _selectedYear && x.Month == _selectedMonth);
    }

    private decimal GetSelectedMonthAmount(int accountId)
    {
        if (_selectedMonthAmounts.TryGetValue(accountId, out var value))
        {
            return value;
        }

        var fallback = TryGetSelectedMonthBalance(accountId)?.ClosingBalance ?? 0;
        _selectedMonthAmounts[accountId] = fallback;
        return fallback;
    }

    private string GetSelectedMonthAmountInput(int accountId)
    {
        if (_selectedMonthAmountInputs.TryGetValue(accountId, out var textValue))
        {
            return textValue;
        }

        var amount = GetSelectedMonthAmount(accountId);
        var formatted = amount.ToString("0.00", _culture);
        _selectedMonthAmountInputs[accountId] = formatted;
        return formatted;
    }

    private void SetSelectedMonthAmountInput(int accountId, string? input)
    {
        var normalizedInput = input ?? string.Empty;
        _selectedMonthAmountInputs[accountId] = normalizedInput;

        if (TryParseLocalizedDecimal(normalizedInput, out var parsedAmount))
        {
            _selectedMonthAmounts[accountId] = parsedAmount;
        }
    }

    private Task SetSelectedMonthAmountInputAsync(int accountId, string? input)
    {
        SetSelectedMonthAmountInput(accountId, input);
        return Task.CompletedTask;
    }

    private async Task SaveAllSelectedMonthBalancesAsync()
    {
        try
        {
            foreach (var account in _accounts.Where(x => !x.IsArchived))
            {
                var input = GetSelectedMonthAmountInput(account.Id);
                if (!TryParseLocalizedDecimal(input, out var amount))
                {
                    Snackbar.Add($"Niepoprawna kwota dla konta '{account.Name}'.", Severity.Warning);
                    return;
                }

                var existing = TryGetSelectedMonthBalance(account.Id);

                if (existing is null)
                {
                    await AccountService.UpsertMonthBalanceAsync(new UpsertAccountMonthBalanceRequest
                    {
                        AccountId = account.Id,
                        Year = _selectedYear,
                        Month = _selectedMonth,
                        ClosingBalance = amount
                    }, CancellationToken.None);
                }
                else
                {
                    await AccountService.UpdateMonthBalanceAmountAsync(new UpdateAccountMonthBalanceAmountRequest
                    {
                        Id = existing.Id,
                        ClosingBalance = amount
                    }, CancellationToken.None);
                }
            }

            await LoadAsync();
            Snackbar.Add("Zapisano salda dla wszystkich aktywnych kont.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void SyncSelectedMonthAmounts()
    {
        foreach (var account in _accounts.Where(x => !x.IsArchived))
        {
            var existing = account.MonthBalances.FirstOrDefault(x => x.Year == _selectedYear && x.Month == _selectedMonth);
            var amount = existing?.ClosingBalance ?? 0;
            _selectedMonthAmounts[account.Id] = amount;
            _selectedMonthAmountInputs[account.Id] = amount.ToString("0.00", _culture);
        }

        var accountIds = _accounts.Where(x => !x.IsArchived).Select(x => x.Id).ToHashSet();
        var staleKeys = _selectedMonthAmounts.Keys.Where(x => !accountIds.Contains(x)).ToList();
        foreach (var key in staleKeys)
        {
            _selectedMonthAmounts.Remove(key);
            _selectedMonthAmountInputs.Remove(key);
        }
    }

    private bool TryParseLocalizedDecimal(string? rawValue, out decimal value)
    {
        value = 0;

        if (string.IsNullOrWhiteSpace(rawValue))
        {
            return true;
        }

        var normalized = rawValue.Trim().Replace(',', '.');
        if (!decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed))
        {
            return false;
        }

        value = parsed;
        return true;
    }

    private Task OnSelectedYearChanged(int value)
    {
        _selectedYear = value;
        SyncAvailableMonthsForSelectedYear();
        SyncSelectedMonthAmounts();
        return Task.CompletedTask;
    }

    private Task OnSelectedMonthChipClicked(int value)
    {
        _selectedMonth = value;
        SyncSelectedMonthAmounts();
        return Task.CompletedTask;
    }

    private void SyncAvailableMonthsForSelectedYear()
    {
        _availableMonthsForSelectedYear = _accounts
            .SelectMany(x => x.MonthBalances)
            .Where(x => x.Year == _selectedYear)
            .Select(x => x.Month)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        if (_availableMonthsForSelectedYear.Count > 0 && !_availableMonthsForSelectedYear.Contains(_selectedMonth))
        {
            _selectedMonth = _availableMonthsForSelectedYear[0];
        }
    }

    private int? TryGetNextMonthCandidate()
    {
        if (_availableMonthsForSelectedYear.Count == 0)
        {
            return 1;
        }

        var maxMonth = _availableMonthsForSelectedYear.Max();
        return maxMonth < 12 ? maxMonth + 1 : null;
    }

    private void AddNextMonthToSelection(int month)
    {
        if (!_availableMonthsForSelectedYear.Contains(month))
        {
            _availableMonthsForSelectedYear.Add(month);
            _availableMonthsForSelectedYear = _availableMonthsForSelectedYear.OrderBy(x => x).ToList();
        }

        _selectedMonth = month;
        SyncSelectedMonthAmounts();
    }

    private string GetMonthLabel(int month)
    {
        return _monthOptions.FirstOrDefault(x => x.Value == month).Label ?? month.ToString();
    }

    private decimal GetActiveNonSavingsTotalForSelectedMonth()
    {
        return GetAccountsForSelectedMonth()
            .Where(x => x.Type != AccountType.Savings)
            .Sum(x => GetSelectedMonthAmount(x.Id));
    }

    private decimal GetActiveTotalForSelectedMonth()
    {
        return GetAccountsForSelectedMonth()
            .Sum(x => GetSelectedMonthAmount(x.Id));
    }

    private decimal GetAllTotalForSelectedMonth()
    {
        return _accounts
            .Where(x => x.Type != AccountType.Savings)
            .Sum(x => GetSelectedMonthAmount(x.Id));
    }

    private bool IsSelectedMonthClosed()
    {
        var plan = _availablePlanMonths.FirstOrDefault(x => x.Year == _selectedYear && x.Month == _selectedMonth);
        return plan?.IsClosed ?? false;
    }

    private IReadOnlyList<AccountDto> GetAccountsForSelectedMonth()
    {
        if (IsSelectedMonthClosed())
        {
            return _accounts
                .Where(x => x.MonthBalances.Any(b => b.Year == _selectedYear && b.Month == _selectedMonth))
                .OrderBy(x => x.Order)
                .ToList();
        }

        return _accounts
            .Where(x => !x.IsArchived)
            .OrderBy(x => x.Order)
            .ToList();
    }

    private readonly record struct MonthOption(int Value, string Label);

}
