@page "/accounts"
@using HouseholdBudgetMate.Abstractions.Contracts.Accounts.Dto
@using HouseholdBudgetMate.Abstractions.Enums
@using HouseholdBudgetMate.Abstractions.Extensions
@using MudBlazor

<DirtyStateMonitor @ref="_dirtyStateMonitor"
                   CurrentState="GetDirtyState()"
                   ResetKey="_dirtyResetVersion"
                   Enabled="@(!_isInitialLoading && _loadError is null)"
                   Label="konta"/>

<div class="accounts-dashboard">
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="accounts-alert">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <MudText>Nie udało się załadować kont: @_loadError</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" OnClick="LoadAsync">
                    Spróbuj ponownie
                </MudButton>
            </MudStack>
        </MudAlert>
    }

    <MudPaper Class="accounts-hero hb-page-header">
        <div class="accounts-hero-main">
            <div>
                <MudText Typo="Typo.h4" Class="accounts-title">Konta i płynność</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">
                    Zobacz stan finansów, salda kont, oszczędności i obszary budżetu wymagające uwagi.
                </MudText>
            </div>

            <div class="accounts-period-picker" aria-label="Wybór miesiąca sald">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               Color="Color.Primary"
                               Variant="Variant.Outlined"
                               aria-label="Poprzedni miesiąc"
                               title="Poprzedni miesiąc"
                               Disabled="@(!CanMoveSelectedPeriod(-1))"
                               OnClick="() => MoveSelectedPeriodAsync(-1)"/>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Class="accounts-period-button"
                           StartIcon="@Icons.Material.Filled.CalendarMonth"
                           EndIcon="@Icons.Material.Filled.ExpandMore"
                           OnClick="OpenPeriodDialogAsync">
                    <span>@SelectedPeriodLabel</span>
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                               Color="Color.Primary"
                               Variant="Variant.Outlined"
                               aria-label="Następny miesiąc"
                               title="Następny miesiąc"
                               Disabled="@(!CanMoveSelectedPeriod(1))"
                               OnClick="() => MoveSelectedPeriodAsync(1)"/>
            </div>
        </div>

        <div class="accounts-hero-actions">
            <MudChip T="string" Color="@(_overview.IsMonthClosed ? Color.Info : Color.Success)" Variant="Variant.Filled">
                @(_overview.IsMonthClosed ? "Miesiąc zamknięty" : "Miesiąc otwarty")
            </MudChip>
            @if (_hasSelectedMonthPlan)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CalendarMonth"
                           Href="@SelectedMonthPlanHref">
                    Otwórz plan miesiąca
                </MudButton>
            }
        </div>
    </MudPaper>

    @if (_isInitialLoading)
    {
        <div class="accounts-kpi-grid">
            @for (var i = 0; i < 6; i++)
            {
                <MudPaper Class="hb-kpi-card accounts-kpi-card">
                    <MudSkeleton Width="45%" Height="16px"/>
                    <MudSkeleton Width="70%" Height="32px" Class="mt-2"/>
                    <MudSkeleton Width="55%" Height="14px" Class="mt-2"/>
                </MudPaper>
            }
        </div>
    }
    else
    {
        @if (!_overview.HasCompleteBalanceBase)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="accounts-alert">
                @BalanceBaseGuidance
            </MudAlert>
        }

        <div class="accounts-kpi-grid">
            <MudPaper Class="hb-kpi-card accounts-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Live balance</MudText>
                <MudText Class="hb-kpi-value">@(_overview.HasCompleteBalanceBase ? FormatMoney(_overview.LiveBalance) : "Brak danych")</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">Saldo live</MudText>
            </MudPaper>
            <MudPaper Class="hb-kpi-card accounts-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Konta bieżące</MudText>
                <MudText Class="hb-kpi-value">@FormatMoney(_overview.CheckingBalance)</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">Bez kont oszczędnościowych</MudText>
            </MudPaper>
            <MudPaper Class="hb-kpi-card accounts-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Konta + oszczędności</MudText>
                <MudText Class="hb-kpi-value">@FormatMoney(_overview.SavingsBalance)</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">Suma wszystkich kont dla wybranego miesiąca</MudText>
            </MudPaper>
            <MudPaper Class="hb-kpi-card accounts-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Wpływy / wydatki</MudText>
                <MudText Class="hb-kpi-value accounts-kpi-pair">
                    <span class="accounts-positive">@FormatMoney(_overview.IncomesTotal)</span>
                    <span class="hb-muted">/</span>
                    <span class="accounts-negative">@FormatMoney(_overview.ExpensesTotal)</span>
                </MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">Ruchy wybranego miesiąca</MudText>
            </MudPaper>
            <MudPaper Class="hb-kpi-card accounts-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Aktywny dług</MudText>
                <MudText Class="hb-kpi-value">@FormatMoney(_debtSummary.ActiveDebt)</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">@FormatActiveLoanCount(_debtSummary.ActiveLoanCount)</MudText>
            </MudPaper>
            <MudPaper Class="@AttentionKpiClass">
                <MudText Typo="Typo.caption" Class="hb-muted">Kategorie przekroczone</MudText>
                <MudText Class="hb-kpi-value">@_overview.OverspentCategoryCount</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">@(_overview.OverspentCategoryCount > 0 ? "Wymagają decyzji" : "Kategorie wyglądają stabilnie")</MudText>
            </MudPaper>
        </div>
    }

    <div class="accounts-insight-grid">
        <MudPaper Class="hb-panel accounts-panel">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="accounts-section-heading">
                <div>
                    <MudText Typo="Typo.h6">Budżet wymaga uwagi</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">Kategorie z przekroczeniami i największym buforem.</MudText>
                </div>
                <MudChip T="int" Color="@(_overspentCategories.Count > 0 ? Color.Warning : Color.Success)">
                    @_overspentCategories.Count
                </MudChip>
            </MudStack>

            @if (!_hasSelectedMonthPlan)
            {
                <div class="accounts-empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Info"/>
                    <MudText Typo="Typo.subtitle2">Brak planu dla wybranego miesiąca.</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">Wybierz miesiąc z istniejącym planem, aby zobaczyć alerty budżetowe.</MudText>
                </div>
            }
            else if (_overspentCategories.Count == 0)
            {
                <div class="accounts-empty-state accounts-success-state">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"/>
                    <MudText Typo="Typo.subtitle2">Kategorie wyglądają stabilnie.</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">Nie ma przekroczeń limitów kopertowych w tym miesiącu.</MudText>
                </div>
            }
            else
            {
                <MudList T="BudgetHealthItemDto" Dense="true" Class="accounts-health-list">
                    @foreach (var item in _overspentCategories)
                    {
                        <MudListItem T="BudgetHealthItemDto">
                            <div class="accounts-health-row">
                                <div>
                                    <MudText Typo="Typo.body2" Class="accounts-row-title">@item.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="hb-muted">Wydano @FormatMoney(item.SpentAmount) z limitu @FormatMoney(item.LimitAmount)</MudText>
                                </div>
                                <MudChip T="string" Color="Color.Error" Variant="Variant.Filled">
                                    @FormatMoney(item.RemainingAmount)
                                </MudChip>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }

            @if (_safeCategories.Count > 0)
            {
                <MudDivider Class="my-3"/>
                <MudText Typo="Typo.subtitle2">Największy bufor</MudText>
                <MudList T="BudgetHealthItemDto" Dense="true" Class="accounts-health-list">
                    @foreach (var item in _safeCategories)
                    {
                        <MudListItem T="BudgetHealthItemDto">
                            <div class="accounts-health-row">
                                <div>
                                    <MudText Typo="Typo.body2" Class="accounts-row-title">@item.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="hb-muted">Pozostało z limitu koperty</MudText>
                                </div>
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">
                                    @FormatMoney(item.RemainingAmount)
                                </MudChip>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>

        <MudPaper Class="hb-panel accounts-panel">
            <MudText Typo="Typo.h6">Oszczędności i dług</MudText>
            <MudText Typo="Typo.body2" Class="hb-muted">Krótki obraz celów oszczędnościowych i zobowiązań.</MudText>

            <div class="accounts-summary-split">
                <div class="accounts-summary-box">
                    <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Success"/>
                    <MudText Typo="Typo.caption" Class="hb-muted">Transfery oszczędnościowe</MudText>
                    <MudText Typo="Typo.h6">@FormatMoney(_savingsSummary.MonthlyTransfers)</MudText>
                    <MudText Typo="Typo.caption" Class="hb-muted">@FormatMonthlyTransferCount(_savingsSummary.TransferCount)</MudText>
                </div>
                <div class="accounts-summary-box">
                    <MudIcon Icon="@Icons.Material.Filled.CreditScore" Color="Color.Warning"/>
                    <MudText Typo="Typo.caption" Class="hb-muted">Pozostały kapitał</MudText>
                    <MudText Typo="Typo.h6">@FormatMoney(_debtSummary.ActiveDebt)</MudText>
                    <MudText Typo="Typo.caption" Class="hb-muted">@FormatActiveLoanCount(_debtSummary.ActiveLoanCount)</MudText>
                </div>
            </div>

            @if (_debtSummary.ActiveLoanCount == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    Brak aktywnych kredytów do pokazania w tym podsumowaniu.
                </MudAlert>
            }
        </MudPaper>
    </div>

    <MudPaper Class="hb-panel accounts-panel">
        <ActionForm OnSubmit="SaveAllSelectedMonthBalancesAsync">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="accounts-section-heading">
            <div>
                <MudText Typo="Typo.h6">Salda kont</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">
                    @(_overview.IsMonthClosed ? "Miesiąc jest zamknięty, więc salda są tylko do odczytu." : "Edytuj salda dla wybranego miesiąca i zapisz je jednym kliknięciem.")
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@(!_canEditSelectedMonth || _isBusy || _balanceRows.Count == 0)"
                       ButtonType="ButtonType.Submit">
                Zapisz salda
            </MudButton>
        </MudStack>

        @if (_overview.IsMonthClosed)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                Wybrany miesiąc jest zamknięty. Możesz tylko podejrzeć zapisane salda.
            </MudAlert>
        }

        @if (_balanceRows.Count == 0)
        {
            <div class="accounts-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Info"/>
                <MudText Typo="Typo.subtitle2">@(_overview.IsMonthClosed ? "Brak sald dla zamkniętego miesiąca." : "Brak aktywnych kont.")</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">Dodaj konto, aby rozpocząć prowadzenie sald miesięcznych.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateAccountDialogAsync">
                    Dodaj pierwsze konto
                </MudButton>
            </div>
        }
        else
        {
            <div class="accounts-balance-list">
                @foreach (var row in _balanceRows)
                {
                    <div class="accounts-balance-card @(row.IsArchived ? "is-archived" : string.Empty) @(row.Type == AccountType.Savings ? "is-savings" : string.Empty)">
                        <div class="accounts-balance-main">
                            <MudIcon Icon="@GetAccountIcon(row.Type)" Color="@GetAccountIconColor(row.Type)"/>
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="accounts-row-title">@row.Name</MudText>
                                <MudText Typo="Typo.caption" Class="hb-muted">@row.TypeLabel</MudText>
                            </div>
                        </div>
                        <div class="accounts-balance-status">
                            <MudChip T="string" Color="@(row.IsArchived ? Color.Warning : Color.Success)" Variant="Variant.Outlined" Size="Size.Small">
                                @(row.IsArchived ? "Archiwalne" : "Aktywne")
                            </MudChip>
                            <MudChip T="string" Color="@(row.HasRecordedBalance ? Color.Info : Color.Warning)" Variant="Variant.Outlined" Size="Size.Small">
                                @(row.HasRecordedBalance ? "Saldo zapisane" : "Brak zapisu")
                            </MudChip>
                        </div>
                        <div class="accounts-balance-amount">
                            @if (_overview.IsMonthClosed)
                            {
                                <MudText Typo="Typo.h6">@FormatMoney(row.Amount)</MudText>
                            }
                            else
                            {
                                <MudTextField T="string"
                                              Value="GetSelectedMonthAmountInput(row.Id)"
                                              ValueChanged="(value) => SetSelectedMonthAmountInputAsync(row.Id, value)"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              InputMode="DecimalInputMode"
                                              Adornment="Adornment.End"
                                              AdornmentText="PLN"
                                              Error="@HasBalanceInputError(row.Id)"
                                              ErrorText="@GetBalanceInputError(row.Id)"
                                              aria-label="@($"Saldo konta {row.Name}")"/>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        </ActionForm>
    </MudPaper>

    <MudPaper Class="hb-panel accounts-panel">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="accounts-section-heading">
            <div>
                <MudText Typo="Typo.h6">Zarządzanie kontami</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">Edycja nazw, typów, archiwizacja i kolejność wyświetlania.</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateAccountDialogAsync">
                Dodaj konto
            </MudButton>
        </MudStack>

        <MudTable Items="_accountRows" Dense="true" Hover="true" Class="accounts-management-table">
            <HeaderContent>
                <MudTh Class="account-order-cell">Kolejność</MudTh>
                <MudTh>Nazwa</MudTh>
                <MudTh>Typ</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Class="accounts-actions-cell">Akcje</MudTh>
            </HeaderContent>
            <NoRecordsContent>
                <div class="accounts-empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Info"/>
                    <MudText Typo="Typo.subtitle2">Brak kont do wyświetlenia.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateAccountDialogAsync">
                        Dodaj pierwsze konto
                    </MudButton>
                </div>
            </NoRecordsContent>
            <RowTemplate Context="account">
                <MudTd DataLabel="Kolejność" Class="account-order-cell">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption">@account.Order</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                       Size="Size.Small"
                                       Class="manual-order-action"
                                       Disabled="@IsFirstAccount(account.Id)"
                                       aria-label="@($"Przenieś konto {account.Name} wyżej")"
                                       title="@($"Przenieś konto {account.Name} wyżej")"
                                       OnClick="() => MoveAccountAsync(account.Id, -1)"/>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                       Size="Size.Small"
                                       Class="manual-order-action"
                                       Disabled="@IsLastAccount(account.Id)"
                                       aria-label="@($"Przenieś konto {account.Name} niżej")"
                                       title="@($"Przenieś konto {account.Name} niżej")"
                                       OnClick="() => MoveAccountAsync(account.Id, 1)"/>
                    </MudStack>
                </MudTd>

                @if (_editModel?.Id == account.Id)
                {
                    <MudTd DataLabel="Nazwa">
                        <MudTextField @bind-Value="_editModel.Name"
                                      Margin="Margin.Dense"
                                      Variant="Variant.Outlined"
                                      Error="@(!string.IsNullOrWhiteSpace(_editNameError))"
                                      ErrorText="@_editNameError"
                                      aria-label="Nazwa edytowanego konta"/>
                    </MudTd>
                    <MudTd DataLabel="Typ">
                        <MudSelect T="AccountType" @bind-Value="_editModel.Type" Margin="Margin.Dense"
                                   Variant="Variant.Outlined" aria-label="Typ edytowanego konta">
                            @foreach (var type in _accountTypes)
                            {
                                <MudSelectItem Value="@type">@type.GetDisplayName()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@(account.IsArchived ? Color.Warning : Color.Success)">
                            @(account.IsArchived ? "Archiwalne" : "Aktywne")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Akcje" Class="accounts-actions-cell">
                        <div class="accounts-actions-row">
                            <MudIconButton Icon="@Icons.Material.Filled.Save"
                                           Color="Color.Primary"
                                           aria-label="Zapisz konto"
                                           title="Zapisz konto"
                                           OnClick="SaveEditAsync"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           aria-label="Anuluj edycję"
                                           title="Anuluj edycję"
                                           OnClick="CancelEdit"/>
                        </div>
                    </MudTd>
                }
                else
                {
                    <MudTd DataLabel="Nazwa">
                        <MudText Typo="Typo.body2" Class="accounts-row-title">@account.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="Typ">@account.TypeLabel</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@(account.IsArchived ? Color.Warning : Color.Success)" Variant="Variant.Outlined">
                            @(account.IsArchived ? "Archiwalne" : "Aktywne")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Akcje" Class="accounts-actions-cell">
                        <div class="accounts-actions-row">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           aria-label="@($"Edytuj konto {account.Name}")"
                                           title="@($"Edytuj konto {account.Name}")"
                                           OnClick="() => BeginEdit(account)"/>
                            <MudIconButton Icon="@(account.IsArchived ? Icons.Material.Filled.Unarchive : Icons.Material.Filled.Archive)"
                                           Color="Color.Secondary"
                                           aria-label="@($"{(account.IsArchived ? "Przywróć" : "Archiwizuj")} konto {account.Name}")"
                                           title="@($"{(account.IsArchived ? "Przywróć" : "Archiwizuj")} konto {account.Name}")"
                                           OnClick="() => ToggleArchiveAsync(account)"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           aria-label="@($"Usuń konto {account.Name}")"
                                           title="@($"Usuń konto {account.Name}")"
                                           OnClick="() => DeleteAccountAsync(account)"/>
                        </div>
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>
    </MudPaper>
</div>

<MudOverlay Visible="@_isBusy" Absolute="true" DarkBackground="true">
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
</MudOverlay>
