@page "/admin/backup"
@using HouseholdBudgetMate.Abstractions.Contracts.Backup
@using HouseholdBudgetMate.Abstractions.Contracts.Backup.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Backup.Requests
@using HouseholdBudgetMate.Abstractions.Interfaces
@using HouseholdBudgetMate.Web.Services
@using MudBlazor

@inject IBackupService BackupService
@inject IUserSessionService UserSessionService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@implements IAsyncDisposable

@if (!IsAdminSession)
{
    <MudPaper Class="pa-4 hb-panel">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            Nie masz uprawnień do zarządzania backupami.
        </MudAlert>
    </MudPaper>
}
else
{
    <MudStack Spacing="0">
        <MudPaper Class="hb-page-header">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">Backup i eksport</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">
                        Eksportuj CSV, twórz wrażliwe pliki JSON backupu, przywracaj dane i zarządzaj harmonogramem.
                    </MudText>
                </MudStack>
                <MudChip T="string" Color="Color.Error" Variant="Variant.Filled">
                    Tylko administrator
                </MudChip>
            </MudStack>

        </MudPaper>

        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
            Wrażliwy plik backupu: plain JSON backup can contain household financial data, profile records, and PIN hashes.
            Przechowuj go poza publicznymi katalogami i udostępniaj tylko zaufanym administratorom.
        </MudAlert>

        <MudGrid Class="mt-1">
            <MudItem xs="12" lg="6">
                <MudPaper Class="pa-4 mt-4 hb-panel">
                    <MudStack Spacing="3">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">Eksport CSV</MudText>
                            <MudText Typo="Typo.body2" Class="hb-muted">
                                Oddzielny eksport wydatków i wpływów do arkusza, niezależny od backupu JSON.
                            </MudText>
                        </MudStack>

                        <MudGrid>
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="int" Label="Rok" @bind-Value="_csvYear" Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="2100" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField T="int?" Label="Miesiąc (opcjonalnie)" @bind-Value="_csvMonth" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="BackupCsvExportKind" Label="Zakres" @bind-Value="_csvKind" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="BackupCsvExportKind.ExpensesAndIncomes">Wydatki i wpływy</MudSelectItem>
                                    <MudSelectItem Value="BackupCsvExportKind.Expenses">Tylko wydatki</MudSelectItem>
                                    <MudSelectItem Value="BackupCsvExportKind.Incomes">Tylko wpływy</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>

                        <MudSwitch T="bool" Label="Dołącz soft-deleted rows" Color="Color.Warning" @bind-Value="_csvIncludeDeleted" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.TableView"
                                   ButtonType="ButtonType.Button"
                                   OnClick="ExportCsvAsync"
                                   Disabled="_isBusy">
                            Pobierz CSV
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="6">
                <MudPaper Class="pa-4 mt-4 hb-panel">
                    <MudStack Spacing="3">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">Backup JSON</MudText>
                            <MudText Typo="Typo.body2" Class="hb-muted">
                                Modułowy snapshot aplikacji. Pełny backup zawiera profile i hashe PIN, jeśli zaznaczysz tę sekcję.
                            </MudText>
                        </MudStack>

                        <MudGrid>
                            <MudItem xs="12" sm="6" md="4">
                                <MudCheckBox T="bool" Label="Budget data" @bind-Value="_manualBudget" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudCheckBox T="bool" Label="Profiles and PIN hashes" @bind-Value="_manualProfiles" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudCheckBox T="bool" Label="Categories and tags" @bind-Value="_manualTaxonomy" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudCheckBox T="bool" Label="Audit" @bind-Value="_manualAudit" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudCheckBox T="bool" Label="Logs" @bind-Value="_manualLogs" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudCheckBox T="bool" Label="Settings metadata" @bind-Value="_manualSettingsMetadata" />
                            </MudItem>
                        </MudGrid>

                        <MudSwitch T="bool"
                                   Label="Ogranicz dane budżetowe do zakresu miesięcy"
                                   Color="Color.Warning"
                                   @bind-Value="_manualLimitBudgetPeriod"
                                   Disabled="@(!_manualBudget)" />

                        @if (_manualBudget && _manualLimitBudgetPeriod)
                        {
                            <MudGrid>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudNumericField T="int" Label="Od roku" @bind-Value="_manualFromYear" Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="3000" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudNumericField T="int" Label="Od miesiąca" @bind-Value="_manualFromMonth" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudNumericField T="int" Label="Do roku" @bind-Value="_manualToYear" Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="3000" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudNumericField T="int" Label="Do miesiąca" @bind-Value="_manualToMonth" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12" />
                                </MudItem>
                            </MudGrid>
                            <MudText Typo="Typo.caption" Class="hb-muted">
                                Zakres dotyczy sekcji Budget data. Kategorie/tagi i profile są eksportowane zgodnie z zaznaczonymi sekcjami.
                            </MudText>
                        }

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   ButtonType="ButtonType.Button"
                                   OnClick="CreateJsonBackupAsync"
                                   Disabled="_isBusy">
                            Pobierz JSON backup
                        </MudButton>

                        @if (_lastBackupWarnings.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                @string.Join(" ", _lastBackupWarnings)
                            </MudAlert>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-4 mt-4 hb-panel backup-restore-danger">
            <MudStack Spacing="3">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6" Color="Color.Error">Przywracanie backupu</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">
                        Restore jest destrukcyjny. Przed zmianą danych aplikacja tworzy automatic pre-restore backup copy.
                    </MudText>
                </MudStack>

                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    Przywracanie wymaga pliku JSON, walidacji i wpisania frazy <strong>@RestoreConfirmationPhrase</strong>.
                    Zła fraza albo błędny plik blokuje operację.
                </MudAlert>

                <label class="backup-drop-zone" @ref="_restoreDropZone">
                    <InputFile class="backup-drop-zone-input"
                               OnChange="OnRestoreFileSelectedAsync"
                               accept=".json,application/json" />
                    <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Warning" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle1">Przeciągnij plik backupu JSON tutaj</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">
                        Albo kliknij box, wybierz plik i uruchom walidację przed restore.
                    </MudText>
                </label>

                @if (!string.IsNullOrWhiteSpace(_restoreFileName))
                {
                    <MudText Typo="Typo.caption" Class="hb-muted">Wybrany plik: @_restoreFileName</MudText>
                }

                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.FactCheck"
                               ButtonType="ButtonType.Button"
                               OnClick="ValidateRestoreAsync"
                               Disabled="@(_isBusy || _restoreFileContent.Length == 0)">
                        Waliduj backup
                    </MudButton>
                </MudStack>

                @if (_restorePreview is not null)
                {
                    @if (_restorePreview.IsAllowed)
                    {
                        <MudText Typo="Typo.subtitle2">Co przywrócić z backupu</MudText>
                        @if (_restorePreview.Users.Count > 0)
                        {
                            <MudTable Items="@_restorePreview.Users" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>Profil / budżet</MudTh>
                                    <MudTh>Budżet</MudTh>
                                    <MudTh>Profil i PIN</MudTh>
                                    <MudTh>Audyt</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="user">
                                    <MudTd>
                                        <MudText>@user.Username</MudText>
                                        <MudText Typo="Typo.caption" Class="hb-muted">@user.UserId</MudText>
                                    </MudTd>
                                    <MudTd>
                                        <MudCheckBox T="bool"
                                                     Value="@IsRestoreUserSectionSelected(user.UserId, BackupSection.Budget)"
                                                     ValueChanged="@((bool value) => OnRestoreUserSectionChanged(user.UserId, BackupSection.Budget, value))"
                                                     Disabled="@(!user.AvailableSections.HasFlag(BackupSection.Budget))" />
                                    </MudTd>
                                    <MudTd>
                                        <MudCheckBox T="bool"
                                                     Value="@IsRestoreUserSectionSelected(user.UserId, BackupSection.Profiles)"
                                                     ValueChanged="@((bool value) => OnRestoreUserSectionChanged(user.UserId, BackupSection.Profiles, value))"
                                                     Disabled="@(!user.AvailableSections.HasFlag(BackupSection.Profiles))" />
                                    </MudTd>
                                    <MudTd>
                                        <MudCheckBox T="bool"
                                                     Value="@IsRestoreUserSectionSelected(user.UserId, BackupSection.Audit)"
                                                     ValueChanged="@((bool value) => OnRestoreUserSectionChanged(user.UserId, BackupSection.Audit, value))"
                                                     Disabled="@(!user.AvailableSections.HasFlag(BackupSection.Audit))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudGrid>
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCheckBox T="bool"
                                                 Label="Dane budżetowe"
                                                 Value="@_restoreBudget"
                                                 ValueChanged="@OnRestoreBudgetChanged"
                                                 Disabled="@(!IsRestoreSectionAvailable(BackupSection.Budget))" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCheckBox T="bool"
                                                 Label="Profile i hashe PIN"
                                                 @bind-Value="_restoreProfiles"
                                                 Disabled="@(!IsRestoreSectionAvailable(BackupSection.Profiles))" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCheckBox T="bool"
                                                 Label="Kategorie i tagi"
                                                 @bind-Value="_restoreTaxonomy"
                                                 Disabled="@(!IsRestoreSectionAvailable(BackupSection.Taxonomy) || _restoreBudget)" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCheckBox T="bool"
                                                 Label="Audyt"
                                                 @bind-Value="_restoreAudit"
                                                 Disabled="@(!IsRestoreSectionAvailable(BackupSection.Audit))" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCheckBox T="bool"
                                                 Label="Logi"
                                                 @bind-Value="_restoreLogs"
                                                 Disabled="@(!IsRestoreSectionAvailable(BackupSection.Logs))" />
                                </MudItem>
                            </MudGrid>
                        }
                        @if (_restoreBudget && IsRestoreSectionAvailable(BackupSection.Taxonomy))
                        {
                            <MudText Typo="Typo.caption" Class="hb-muted">
                                Dane budżetowe przywracają też powiązane kategorie i tagi z pliku backupu.
                            </MudText>
                        }
                    }
                    @if (_restorePreview.CountsByTable.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2">Restore preview counts</MudText>
                        <MudList T="KeyValuePair<string, int>" Dense="true">
                            @foreach (var count in _restorePreview.CountsByTable.OrderBy(x => x.Key, StringComparer.Ordinal))
                            {
                                <MudListItem T="KeyValuePair<string, int>">@count.Key: @count.Value</MudListItem>
                            }
                        </MudList>
                    }
                    @foreach (var error in _restorePreview.Errors)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@error</MudText>
                    }
                    @foreach (var warning in _restorePreview.Warnings)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@warning</MudText>
                    }
                }

                <MudTextField T="string"
                              Label="Wpisz RESTORE BACKUP"
                              @bind-Value="_restoreConfirmation"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Restore"
                           ButtonType="ButtonType.Button"
                           OnClick="RestoreBackupAsync"
                           Disabled="@(!CanRestoreBackup)">
                    Przywróć backup
                </MudButton>

            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 mt-4 hb-panel">
            <MudStack Spacing="3">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">Harmonogram backupu</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">
                        Scheduled backup writes selected sections to a configured local path.
                    </MudText>
                </MudStack>

                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                    Harmonogram działa tylko wtedy, gdy proces aplikacji jest uruchomiony. Jeśli hosting usypia aplikację
                    albo nikt jej nie używa, background task nie wykona backupu do czasu ponownego wybudzenia.
                    Dla krytycznych backupów użyj zewnętrznego schedulera lub ręcznego `Run backup now`.
                </MudAlert>

                <MudSwitch T="bool" Label="Automatyczny backup włączony" Color="Color.Success" @bind-Value="_scheduleEnabled" />

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Ścieżka backupu" @bind-Value="_schedulePath" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.FolderOpen"
                                   ButtonType="ButtonType.Button"
                                   OnClick="OpenBackupFolderPickerAsync"
                                   Disabled="_isBusy"
                                   Class="mt-1">
                            Wybierz folder
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="BackupScheduleFrequency" Label="Częstotliwość" @bind-Value="_scheduleFrequency" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="BackupScheduleFrequency.Daily">Daily</MudSelectItem>
                            <MudSelectItem Value="BackupScheduleFrequency.Weekly">Weekly</MudSelectItem>
                            <MudSelectItem Value="BackupScheduleFrequency.Monthly">Monthly</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="Lokalny czas HH:mm" @bind-Value="_scheduleLocalTimeInput" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>

                <MudGrid>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCheckBox T="bool" Label="Budget data" @bind-Value="_scheduleBudget" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCheckBox T="bool" Label="Profiles and PIN hashes" @bind-Value="_scheduleProfiles" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCheckBox T="bool" Label="Categories and tags" @bind-Value="_scheduleTaxonomy" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCheckBox T="bool" Label="Audit" @bind-Value="_scheduleAudit" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCheckBox T="bool" Label="Logs" @bind-Value="_scheduleLogs" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCheckBox T="bool" Label="Settings metadata" @bind-Value="_scheduleSettingsMetadata" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               ButtonType="ButtonType.Button"
                               OnClick="SaveScheduleAsync"
                               Disabled="_isBusy">
                        Zapisz harmonogram
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               ButtonType="ButtonType.Button"
                               OnClick="RunBackupNowAsync"
                               Disabled="_isBusy">
                        Run backup now
                    </MudButton>
                </MudStack>

                <MudAlert Severity="Severity.Info" Dense="true">
                    Last-run status: @(_scheduleLastStatus ?? "brak uruchomień")
                    @if (_scheduleLastRunAtUtc is not null)
                    {
                        <span> (@_scheduleLastRunAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span>
                    }
                </MudAlert>
            </MudStack>
        </MudPaper>
    </MudStack>
}

@code {
    private const string RestoreConfirmationPhrase = "RESTORE BACKUP";

    private bool _isBusy;

    private int _csvYear = DateTime.Now.Year;
    private int? _csvMonth = DateTime.Now.Month;
    private BackupCsvExportKind _csvKind = BackupCsvExportKind.ExpensesAndIncomes;
    private bool _csvIncludeDeleted;

    private bool _manualBudget = true;
    private bool _manualProfiles = true;
    private bool _manualTaxonomy = true;
    private bool _manualAudit = true;
    private bool _manualLogs = true;
    private bool _manualSettingsMetadata = true;
    private bool _manualLimitBudgetPeriod;
    private int _manualFromYear = DateTime.Now.Year;
    private int _manualFromMonth = DateTime.Now.Month;
    private int _manualToYear = DateTime.Now.Year;
    private int _manualToMonth = DateTime.Now.Month;
    private List<string> _lastBackupWarnings = [];

    private byte[] _restoreFileContent = [];
    private string _restoreFileName = string.Empty;
    private string _restoreConfirmation = string.Empty;
    private BackupRestorePreviewDto? _restorePreview;
    private bool _restoreBudget;
    private bool _restoreProfiles;
    private bool _restoreTaxonomy;
    private bool _restoreAudit;
    private bool _restoreLogs;
    private Dictionary<string, BackupSection> _restoreUserSections = new(StringComparer.Ordinal);
    private ElementReference _restoreDropZone;
    private IJSObjectReference? _backupDropZoneModule;
    private IJSObjectReference? _backupDropZoneRegistration;

    private bool _scheduleEnabled;
    private string _schedulePath = string.Empty;
    private BackupScheduleFrequency _scheduleFrequency = BackupScheduleFrequency.Daily;
    private string _scheduleLocalTimeInput = "02:00";
    private bool _scheduleBudget = true;
    private bool _scheduleProfiles = true;
    private bool _scheduleTaxonomy = true;
    private bool _scheduleAudit = true;
    private bool _scheduleLogs = true;
    private bool _scheduleSettingsMetadata = true;
    private DateTime? _scheduleLastRunAtUtc;
    private string? _scheduleLastStatus;

    private bool IsAdminSession => UserSessionService.CurrentUser?.IsAdmin == true;

    protected override async Task OnInitializedAsync()
    {
        if (!IsAdminSession)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadScheduleAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !IsAdminSession)
        {
            return;
        }

        _backupDropZoneModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/backup-drop-zone.js");
        _backupDropZoneRegistration = await _backupDropZoneModule.InvokeAsync<IJSObjectReference>(
            "registerBackupDropZone",
            _restoreDropZone);
    }

    private async Task LoadScheduleAsync()
    {
        await RunAdminActionAsync(async () =>
        {
            var settings = await BackupService.GetBackupSettingsAsync(CancellationToken.None);
            _scheduleEnabled = settings.IsEnabled;
            _schedulePath = settings.BackupPath;
            _scheduleFrequency = settings.Frequency;
            _scheduleLocalTimeInput = settings.LocalTime.ToString("HH:mm");
            _scheduleLastRunAtUtc = settings.LastRunAtUtc;
            _scheduleLastStatus = settings.LastStatus;
            ApplyScheduleSections(settings.Sections);
        });
    }

    private async Task ExportCsvAsync()
    {
        await RunAdminActionAsync(async () =>
        {
            var result = await BackupService.ExportCsvAsync(
                new ExportCsvRequest
                {
                    Year = _csvYear,
                    Month = _csvMonth,
                    Kind = _csvKind,
                    IncludeDeleted = _csvIncludeDeleted
                },
                CancellationToken.None);

            await DownloadAsync(result.FileName, result.Content, result.ContentType);
            ShowSuccess($"CSV gotowy: {result.ExpenseRowCount} wydatków, {result.IncomeRowCount} wpływów.");
        });
    }

    private async Task CreateJsonBackupAsync()
    {
        await RunAdminActionAsync(async () =>
        {
            var result = await BackupService.CreateBackupAsync(
                new CreateBackupRequest
                {
                    Sections = BuildManualSections(),
                    IncludeAllBudgetOwners = BuildManualSections().HasFlag(BackupSection.Profiles),
                    FromYear = _manualLimitBudgetPeriod ? _manualFromYear : null,
                    FromMonth = _manualLimitBudgetPeriod ? _manualFromMonth : null,
                    ToYear = _manualLimitBudgetPeriod ? _manualToYear : null,
                    ToMonth = _manualLimitBudgetPeriod ? _manualToMonth : null
                },
                CancellationToken.None);

            _lastBackupWarnings = result.Warnings.ToList();
            await DownloadAsync(result.FileName, result.Content, result.ContentType);
            ShowSuccess($"Backup JSON gotowy: {result.FileName}");
        });
    }

    private async Task OnRestoreFileSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        await using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        _restoreFileContent = buffer.ToArray();
        _restoreFileName = file.Name;
        _restorePreview = null;
        _restoreConfirmation = string.Empty;
        ApplyRestoreSections(BackupSection.None);
    }

    private async Task ValidateRestoreAsync()
    {
        await RunAdminActionAsync(async () =>
        {
            await using var stream = new MemoryStream(_restoreFileContent);
            _restorePreview = await BackupService.PreviewRestoreAsync(stream, _restoreFileName, CancellationToken.None);
            ApplyRestoreSections(_restorePreview.RestorableSections);
            ApplyRestoreUserSections(_restorePreview.Users);
            if (_restorePreview.IsAllowed)
            {
                ShowSuccess("Backup przeszedł walidację. Wpisz RESTORE BACKUP, aby przywrócić dane.");
            }
            else
            {
                ShowError("Backup nie przeszedł walidacji. Dane nie zostały zmienione.");
            }
        });
    }

    private async Task RestoreBackupAsync()
    {
        if (!HasValidRestoreRequest)
        {
            ShowError("Najpierw wybierz plik, uruchom poprawną walidację i wpisz frazę RESTORE BACKUP.");
            return;
        }

        await RunAdminActionAsync(async () =>
        {
            await using var stream = new MemoryStream(_restoreFileContent);
            var restoreResult = await BackupService.RestoreBackupAsync(
                new RestoreBackupRequest
                {
                    Content = stream,
                    FileName = _restoreFileName,
                    ConfirmationPhrase = _restoreConfirmation.Trim(),
                    Sections = BuildRestoreSections(),
                    UserSections = BuildRestoreUserSections()
                },
                CancellationToken.None);

            if (restoreResult.IsSuccess)
            {
                ShowSuccess(restoreResult.Message);
            }
            else
            {
                ShowError(restoreResult.Message);
            }
        });
    }

    private async Task SaveScheduleAsync()
    {
        await RunAdminActionAsync(async () =>
        {
            if (!TimeOnly.TryParse(_scheduleLocalTimeInput, out var localTime))
            {
                ShowError("Podaj lokalny czas w formacie HH:mm.");
                return;
            }

            var settings = await BackupService.SaveBackupSettingsAsync(
                new SaveBackupSettingsRequest
                {
                    IsEnabled = _scheduleEnabled,
                    BackupPath = _schedulePath,
                    Frequency = _scheduleFrequency,
                    LocalTime = localTime,
                    Sections = BuildScheduleSections()
                },
                CancellationToken.None);

            _scheduleLastRunAtUtc = settings.LastRunAtUtc;
            _scheduleLastStatus = settings.LastStatus;
            ShowSuccess("Harmonogram backupu zapisany.");
        });
    }

    private async Task OpenBackupFolderPickerAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(BackupFolderPickerDialog.CurrentPath)] = _schedulePath
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium
        };

        var dialog = await DialogService.ShowAsync<BackupFolderPickerDialog>(
            "Wybierz folder backupu",
            parameters,
            options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string selectedPath }
            && !string.IsNullOrWhiteSpace(selectedPath))
        {
            _schedulePath = selectedPath;
        }
    }

    private async Task RunBackupNowAsync()
    {
        await RunAdminActionAsync(async () =>
        {
            var result = await BackupService.RunScheduledBackupNowAsync(CancellationToken.None);
            ShowSuccess($"Run backup now zapisano plik: {result.WrittenPath ?? result.FileName}");
            await LoadScheduleAsync();
        });
    }

    private BackupSection BuildManualSections()
        => BuildSections(_manualBudget, _manualProfiles, _manualTaxonomy, _manualAudit, _manualLogs, _manualSettingsMetadata);

    private bool CanRestoreBackup => !_isBusy && HasValidRestoreRequest;

    private bool HasValidRestoreRequest =>
        _restoreFileContent.Length > 0
        && _restorePreview?.IsAllowed == true
        && BuildRestoreSections() != BackupSection.None
        && IsRestoreConfirmationValid();

    private bool IsRestoreConfirmationValid()
        => string.Equals(
            _restoreConfirmation.Trim(),
            RestoreConfirmationPhrase,
            StringComparison.OrdinalIgnoreCase);

    private BackupSection BuildScheduleSections()
        => BuildSections(_scheduleBudget, _scheduleProfiles, _scheduleTaxonomy, _scheduleAudit, _scheduleLogs, _scheduleSettingsMetadata);

    private BackupSection BuildRestoreSections()
    {
        if (_restoreUserSections.Count > 0)
        {
            return _restoreUserSections.Values.Aggregate(BackupSection.None, (current, sections) => current | sections);
        }

        var sections = BackupSection.None;
        if (_restoreBudget) sections |= BackupSection.Budget;
        if (_restoreProfiles) sections |= BackupSection.Profiles;
        if (_restoreTaxonomy) sections |= BackupSection.Taxonomy;
        if (_restoreAudit) sections |= BackupSection.Audit;
        if (_restoreLogs) sections |= BackupSection.Logs;

        if (_restoreBudget && IsRestoreSectionAvailable(BackupSection.Taxonomy))
        {
            sections |= BackupSection.Taxonomy;
        }

        return sections & (_restorePreview?.RestorableSections ?? BackupSection.None);
    }

    private IReadOnlyDictionary<string, BackupSection> BuildRestoreUserSections()
        => _restoreUserSections
            .Where(x => x.Value != BackupSection.None)
            .ToDictionary(x => x.Key, x => x.Value, StringComparer.Ordinal);

    private bool IsRestoreSectionAvailable(BackupSection section)
        => _restorePreview?.RestorableSections.HasFlag(section) == true;

    private Task OnRestoreBudgetChanged(bool value)
    {
        _restoreBudget = value;
        if (value && IsRestoreSectionAvailable(BackupSection.Taxonomy))
        {
            _restoreTaxonomy = true;
        }

        return Task.CompletedTask;
    }

    private void ApplyRestoreSections(BackupSection sections)
    {
        _restoreBudget = sections.HasFlag(BackupSection.Budget);
        _restoreProfiles = sections.HasFlag(BackupSection.Profiles);
        _restoreTaxonomy = sections.HasFlag(BackupSection.Taxonomy);
        _restoreAudit = sections.HasFlag(BackupSection.Audit);
        _restoreLogs = sections.HasFlag(BackupSection.Logs);
        _restoreUserSections = new Dictionary<string, BackupSection>(StringComparer.Ordinal);
    }

    private void ApplyRestoreUserSections(IReadOnlyList<BackupRestoreUserScopeDto> users)
    {
        _restoreUserSections = users
            .ToDictionary(
                x => x.UserId,
                x => x.AvailableSections & (BackupSection.Budget | BackupSection.Profiles | BackupSection.Audit | BackupSection.Taxonomy),
                StringComparer.Ordinal);
    }

    private bool IsRestoreUserSectionSelected(string userId, BackupSection section)
        => _restoreUserSections.TryGetValue(userId, out var sections) && sections.HasFlag(section);

    private Task OnRestoreUserSectionChanged(string userId, BackupSection section, bool value)
    {
        _restoreUserSections.TryGetValue(userId, out var sections);
        sections = value ? sections | section : sections & ~section;
        if (section == BackupSection.Budget && value)
        {
            sections |= BackupSection.Taxonomy;
        }

        _restoreUserSections[userId] = sections;
        return Task.CompletedTask;
    }

    private static BackupSection BuildSections(
        bool budget,
        bool profiles,
        bool taxonomy,
        bool audit,
        bool logs,
        bool settingsMetadata)
    {
        var sections = BackupSection.None;
        if (budget) sections |= BackupSection.Budget;
        if (profiles) sections |= BackupSection.Profiles;
        if (taxonomy) sections |= BackupSection.Taxonomy;
        if (audit) sections |= BackupSection.Audit;
        if (logs) sections |= BackupSection.Logs;
        if (settingsMetadata) sections |= BackupSection.SettingsMetadata;
        return sections == BackupSection.None ? BackupSection.Budget : sections;
    }

    private void ApplyScheduleSections(BackupSection sections)
    {
        _scheduleBudget = sections.HasFlag(BackupSection.Budget);
        _scheduleProfiles = sections.HasFlag(BackupSection.Profiles);
        _scheduleTaxonomy = sections.HasFlag(BackupSection.Taxonomy);
        _scheduleAudit = sections.HasFlag(BackupSection.Audit);
        _scheduleLogs = sections.HasFlag(BackupSection.Logs);
        _scheduleSettingsMetadata = sections.HasFlag(BackupSection.SettingsMetadata);
    }

    private async Task DownloadAsync(string fileName, byte[] content, string contentType)
    {
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(content), contentType);
    }

    private async Task RunAdminActionAsync(Func<Task> action)
    {
        _isBusy = true;

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ShowSuccess(string message)
    {
        Snackbar.Add(message, Severity.Success);
    }

    private void ShowError(string message)
    {
        Snackbar.Add(message, Severity.Error);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_backupDropZoneRegistration is not null)
            {
                await _backupDropZoneRegistration.InvokeVoidAsync("dispose");
                await _backupDropZoneRegistration.DisposeAsync();
            }

            if (_backupDropZoneModule is not null)
            {
                await _backupDropZoneModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The Blazor Server circuit can already be gone while the component is being disposed.
        }
    }
}
