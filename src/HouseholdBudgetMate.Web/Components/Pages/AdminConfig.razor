@page "/admin/config"
@using HouseholdBudgetMate.Abstractions.Contracts.Users.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Users.Requests
@using HouseholdBudgetMate.Abstractions.Enums
@using HouseholdBudgetMate.Abstractions.Interfaces
@using HouseholdBudgetMate.Application.Helpers
@using HouseholdBudgetMate.Domain.Entities
@using HouseholdBudgetMate.Web.Services
@using HouseholdBudgetMate.Web.Setup
@using MudBlazor

@inject IAdminConfigurationService AdminConfigurationService
@inject CoreDataSeedService CoreDataSeedService
@inject IUserService UserService
@inject IUserSessionService UserSessionService
@inject RuntimeConfigurationState RuntimeConfigurationState
@inject IRealDataReadinessService RealDataReadinessService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<DirtyStateMonitor @ref="_dirtyStateMonitor"
                   CurrentState="GetDirtyState()"
                   ResetKey="_dirtyResetVersion"
                   Enabled="IsAdminSession"
                   Label="administracja"/>

@if (!IsAdminSession)
{
    <MudPaper Class="pa-4 hb-panel">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            Nie masz uprawnień do ustawień administracyjnych.
        </MudAlert>
    </MudPaper>
}
else
{
    <MudStack Spacing="0">
        <MudPaper Class="hb-page-header">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">Administracja</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">
                        Zarządzaj profilami gospodarstwa, dostępem do budżetu, uprawnieniami administratora i połączeniem z bazą.
                    </MudText>
                    <MudText Typo="Typo.caption" Class="mt-1">Ścieżka konfiguracji: @RuntimeConfigurationState.ConfigFilePath</MudText>
                </MudStack>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                    Zalogowano jako @UserSessionService.CurrentUser?.Username
                </MudChip>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <MudAlert Severity="@_statusSeverity" Dense="true" Class="mt-4">@_statusMessage</MudAlert>
            }
        </MudPaper>

        <MudPaper Class="pa-4 mt-4 hb-panel">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">Profile gospodarstwa</MudText>
                        <MudText Typo="Typo.body2" Class="hb-muted">
                            Nowe profile wymagają PIN-u. Uprawnienia administratora trzeba nadać ręcznie.
                        </MudText>
                    </MudStack>
                    <MudChip T="int" Color="Color.Secondary" Variant="Variant.Outlined">Profile: @_users.Count</MudChip>
                </MudStack>

                <MudPaper Class="pa-4 hb-panel" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Dodaj profil</MudText>
                    <ActionForm OnSubmit="CreateUserAsync">
                    <MudGrid>
                        <MudItem xs="12" md="3">
                            <MudTextField T="string" Label="Nazwa profilu" @bind-Value="_newUsername" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <PinKeypadInput Label="PIN" @bind-Value="_newUserPin"/>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="HouseholdMode" Label="Tryb budżetu" @bind-Value="_newUserMode" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="HouseholdMode.SeparateBudget">Osobny budżet</MudSelectItem>
                                <MudSelectItem Value="HouseholdMode.SharedBudget">Wspólny budżet</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" Label="Wspólny z" @bind-Value="_newUserBudgetOwnerId" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_newUserMode == HouseholdMode.SeparateBudget)">
                                <MudSelectItem Value="@User.DefaultUserId">Wspólny budżet gospodarstwa</MudSelectItem>
                                @foreach (var user in _users)
                                {
                                    <MudSelectItem Value="@user.Id">@user.Username</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="1" Class="d-flex align-center">
                            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="_isBusy">
                                Dodaj
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                    </ActionForm>
                </MudPaper>

                <MudGrid>
                    @foreach (var user in _users)
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-4 hb-panel user-admin-card" Elevation="0">
                                <ActionForm OnSubmit="() => SaveUserAsync(user.Id)">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.NoWrap">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1">@user.Username</MudText>
                                            <MudText Typo="Typo.caption" Class="hb-muted">@user.Id</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd">
                                            @if (user.IsAdmin)
                                            {
                                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Administrator</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Default" Size="Size.Small">Standardowy</MudChip>
                                            }

                                        </MudStack>
                                    </MudStack>

                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="HouseholdMode"
                                                       Label="Tryb budżetu"
                                                       Value="@_userModes[user.Id]"
                                                       ValueChanged="mode => _userModes[user.Id] = mode"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense">
                                                <MudSelectItem Value="HouseholdMode.SeparateBudget">Osobny budżet</MudSelectItem>
                                                <MudSelectItem Value="HouseholdMode.SharedBudget">Wspólny budżet</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="string"
                                                       Label="Właściciel budżetu"
                                                       Value="@_userOwners[user.Id]"
                                                       ValueChanged="ownerId => _userOwners[user.Id] = ownerId"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Disabled="@(_userModes[user.Id] == HouseholdMode.SeparateBudget)">
                                                <MudSelectItem Value="@User.DefaultUserId">Wspólny budżet gospodarstwa</MudSelectItem>
                                                @foreach (var owner in _users)
                                                {
                                                    <MudSelectItem Value="@owner.Id">@owner.Username</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudSwitch T="bool"
                                                       Label="Uprawnienia administratora"
                                                       Color="Color.Error"
                                                       Value="@_userAdmins[user.Id]"
                                                       ValueChanged="value => _userAdmins[user.Id] = value"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" Class="d-flex align-center">
                                            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Dialpad" ButtonType="ButtonType.Button" OnClick="() => ChangePinAsync(user.Id)" Disabled="_isBusy">
                                                Zmień PIN
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>

                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" ButtonType="ButtonType.Submit" Disabled="_isBusy">
                                        Zapisz użytkownika
                                    </MudButton>
                                </MudStack>
                                </ActionForm>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 mt-4 hb-panel">
            <MudStack Spacing="3">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">Dane aplikacji</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">
                        Reset usuwa dane budżetowe, kategorie, tagi, audyt i logi, ale zostawia profile użytkowników oraz konfigurację połączenia.
                    </MudText>
                </MudStack>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteForever"
                               ButtonType="ButtonType.Button"
                               OnClick="ClearDatabaseAsync"
                               Disabled="_isBusy">
                        Wyczyść bazę danych
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               ButtonType="ButtonType.Button"
                               OnClick="SeedDatabaseAsync"
                               Disabled="_isBusy">
                        Uruchom seed
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 mt-4 hb-panel">
            <MudText Typo="Typo.h6">Połączenie z bazą danych</MudText>
            <MudText Typo="Typo.body2" Class="hb-muted mt-1">
                Użyj tej sekcji, gdy zmienisz hasło PostgreSQL albo przenosisz bazę. Aplikacja sprawdzi połączenie i wykona migracje przed zapisem.
            </MudText>
            <ActionForm OnSubmit="SaveDatabaseAsync">
            <MudGrid Class="mt-3">
                <MudItem xs="12" md="3">
                    <MudTextField T="string" Label="Host" @bind-Value="_dbHost" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField T="int" Label="Port" @bind-Value="_dbPort" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="65535"/>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudTextField T="string" Label="Login" @bind-Value="_dbUsername" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="Hasło PostgreSQL"
                                  @bind-Value="_dbPassword"
                                  InputType="@(_showDbPassword ? InputType.Text : InputType.Password)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showDbPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="ToggleDatabasePasswordVisibility"/>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudTextField T="string" Label="Baza danych" @bind-Value="_dbName" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" ButtonType="ButtonType.Submit" Disabled="_isBusy">
                Sprawdź i zapisz połączenie
            </MudButton>
            </ActionForm>
        </MudPaper>

            <MudPaper Class="pa-4 mt-4 hb-panel">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">Real data readiness</MudText>
                            <MudText Typo="Typo.body2" Class="hb-muted">
                                Checklist dla wejścia w realne dane: automatyczne kontrole aplikacji oraz ręczne evidence przed
                                pilotem MVP.
                            </MudText>
                        </MudStack>
                        @if (_readinessReport is not null)
                        {
                            <MudChip T="string" Color="@(_readinessReport.IsAppCheckReady ? Color.Success : Color.Warning)"
                                     Variant="Variant.Filled">
                                @(_readinessReport.IsAppCheckReady ? "App checks ready" : "App checks need attention")
                            </MudChip>
                        }
                    </MudStack>

                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        Free Render jest zaakceptowanym ryzykiem pilota MVP, nie pełną trwałą produkcją.
                        Decyzja real-data wymaga ręcznego `pg_dump`, restore smoke testu i przeglądu migracji.
                    </MudAlert>

                    @if (_readinessReport is null)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle1">Automatyczne kontrole</MudText>
                        <MudList T="RealDataReadinessCheck" Dense="true">
                            @foreach (var check in _readinessReport.AutomatedChecks)
                            {
                                <MudListItem T="RealDataReadinessCheck">
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Wrap="Wrap.NoWrap">
                                        <MudIcon
                                        Icon="@(check.IsReady ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
                                        Color="@(check.IsReady ? Color.Success : Color.Warning)" />
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body1">@check.Name</MudText>
                                            <MudText Typo="Typo.caption" Class="hb-muted">@check.Description</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>

                        <MudText Typo="Typo.subtitle1">Ręczne evidence</MudText>
                        <MudText Typo="Typo.caption" Class="hb-muted">
                            Zapisuj w: @_readinessReport.EvidencePath
                        </MudText>
                        <MudList T="RealDataReadinessManualItem" Dense="true">
                            @foreach (var item in _readinessReport.ManualItems)
                            {
                                <MudListItem T="RealDataReadinessManualItem">
                                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Wrap="Wrap.NoWrap">
                                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" />
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body1">@item.Name</MudText>
                                            <MudText Typo="Typo.caption" Class="hb-muted">@item.Description</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudStack>
            </MudPaper>
    </MudStack>
}

@code {
    private bool _isBusy;
    private string? _statusMessage;
    private Severity _statusSeverity = Severity.Info;
    private List<UserDto> _users = [];
    private readonly Dictionary<string, HouseholdMode> _userModes = [];
    private readonly Dictionary<string, string> _userOwners = [];
    private readonly Dictionary<string, bool> _userAdmins = [];
    private RealDataReadinessReport? _readinessReport;
    private DirtyStateMonitor? _dirtyStateMonitor;
    private int _dirtyResetVersion;

    private string _newUsername = string.Empty;
    private string _newUserPin = string.Empty;
    private HouseholdMode _newUserMode = HouseholdMode.SeparateBudget;
    private string _newUserBudgetOwnerId = User.DefaultUserId;

    private string _dbHost = "localhost";
    private int _dbPort = 5432;
    private string _dbUsername = "postgres";
    private string _dbPassword = string.Empty;
    private string _dbName = "household_budget_mate";
    private bool _showDbPassword;

    private bool IsAdminSession => UserSessionService.CurrentUser?.IsAdmin == true;

    protected override async Task OnInitializedAsync()
    {
        if (!IsAdminSession)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isBusy = true;
        _statusMessage = null;

        try
        {
            await LoadUsersAsync();
            LoadDatabaseFields();
            _readinessReport = await RealDataReadinessService.GetReportAsync(CancellationToken.None);
            MarkDirtyStatePristine();
        }
        catch (Exception ex)
        {
            ShowError($"Nie można wczytać danych administracyjnych: {ex.Message}");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        _users = (await UserService.GetUsersAsync(CancellationToken.None))
            .Where(x => x.IsInteractive)
            .ToList();
        _userModes.Clear();
        _userOwners.Clear();
        _userAdmins.Clear();

        foreach (var user in _users)
        {
            _userModes[user.Id] = user.HouseholdMode;
            _userOwners[user.Id] = user.BudgetOwnerUserId;
            _userAdmins[user.Id] = user.IsAdmin;
        }

        _newUserBudgetOwnerId = User.DefaultUserId;
    }

    private void LoadDatabaseFields()
    {
        var database = RuntimeConfigurationState.GetDatabaseConfiguration();
        if (database is null)
        {
            return;
        }

        _dbHost = database.Host;
        _dbPort = database.Port;
        _dbUsername = database.Username;
        _dbPassword = database.Password;
        _dbName = database.Database;
    }

    private async Task CreateUserAsync()
    {
        await RunAdminActionAsync(async () =>
        {
            await UserService.CreateUserAsync(
                new CreateUserRequest
                {
                    Username = _newUsername,
                    Pin = _newUserPin,
                    HouseholdMode = _newUserMode,
                    BudgetOwnerUserId = _newUserBudgetOwnerId
                },
                CancellationToken.None);

            _newUsername = string.Empty;
            _newUserPin = string.Empty;
            _newUserMode = HouseholdMode.SeparateBudget;
            await LoadUsersAsync();
            MarkDirtyStatePristine();
            ShowSuccess("Profil dodany.");
        });
    }

    private async Task SaveUserAsync(string userId)
    {
        await RunAdminActionAsync(async () =>
        {
            await UserService.UpdateUserBudgetModeAsync(
                new UpdateUserBudgetModeRequest
                {
                    UserId = userId,
                    HouseholdMode = _userModes[userId],
                    BudgetOwnerUserId = _userOwners[userId]
                },
                CancellationToken.None);

            await UserService.UpdateUserAdminRoleAsync(
                new UpdateUserAdminRoleRequest
                {
                    UserId = userId,
                    IsAdmin = _userAdmins[userId]
                },
                CancellationToken.None);

            await LoadUsersAsync();
            MarkDirtyStatePristine();
            ShowSuccess("Profil zapisany.");
        });
    }

    private async Task ChangePinAsync(string userId)
    {
        var parameters = new DialogParameters
        {
            ["Label"] = "Nowy PIN"
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<PinKeypadDialog>("Zmień PIN", parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not string pin)
        {
            return;
        }

        await RunAdminActionAsync(async () =>
        {
            await UserService.UpdateUserPinAsync(
                new UpdateUserPinRequest
                {
                    UserId = userId,
                    Pin = pin
                },
                CancellationToken.None);

            ShowSuccess("PIN zmieniony.");
        });
    }

    private async Task ClearDatabaseAsync()
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Message)] = "Wyczyścić dane budżetowe, kategorie, tagi, audyt i logi? Profile użytkowników oraz konfiguracja połączenia zostaną zachowane. Tej operacji nie można cofnąć."
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Wyczyść bazę danych", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        await RunAdminActionAsync(async () =>
        {
            await CoreDataSeedService.ClearBudgetDataAsync(CancellationToken.None);
            await LoadUsersAsync();
            ShowSuccess("Baza danych została wyczyszczona. Profile użytkowników zostały zachowane.");
        });
    }

    private async Task SeedDatabaseAsync()
    {
        await RunAdminActionAsync(async () =>
        {
            await CoreDataSeedService.SeedDefaultsForCurrentBudgetAsync(CancellationToken.None);
            await CoreDataSeedService.EnsureCurrentMonthPlanForCurrentBudgetAsync(CancellationToken.None);
            ShowSuccess("Seed został uruchomiony dla bieżącego budżetu.");
        });
    }

    private async Task SaveDatabaseAsync()
    {
        await RunAdminActionAsync(async () =>
        {
            var result = await AdminConfigurationService.SaveDatabaseConfigurationAsync(
                new RuntimeDatabaseConfiguration
                {
                    Host = _dbHost.Trim(),
                    Port = _dbPort,
                    Username = _dbUsername.Trim(),
                    Password = _dbPassword,
                    Database = _dbName.Trim()
                },
                CancellationToken.None);

            if (!result.IsSuccess)
            {
                ShowError(result.ErrorMessage);
                return;
            }

            ShowSuccess("Połączenie z bazą zapisane.");
            MarkDirtyStatePristine();
        });
    }

    private async Task RunAdminActionAsync(Func<Task> action)
    {
        _isBusy = true;
        _statusMessage = null;

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ToggleDatabasePasswordVisibility()
    {
        _showDbPassword = !_showDbPassword;
    }

    private void ShowSuccess(string message)
    {
        _statusMessage = message;
        _statusSeverity = Severity.Success;
    }

    private void ShowError(string message)
    {
        _statusMessage = message;
        _statusSeverity = Severity.Error;
    }

    private void MarkDirtyStatePristine()
    {
        _dirtyResetVersion++;
        _dirtyStateMonitor?.Reset(GetDirtyState());
    }

    private object GetDirtyState() => new
    {
        NewUser = new
        {
            _newUsername,
            _newUserPin,
            _newUserMode,
            _newUserBudgetOwnerId
        },
        Users = _users
            .OrderBy(user => user.Id, StringComparer.Ordinal)
            .Select(user => new
            {
                user.Id,
                Mode = _userModes.GetValueOrDefault(user.Id),
                Owner = _userOwners.GetValueOrDefault(user.Id),
                IsAdmin = _userAdmins.GetValueOrDefault(user.Id)
            })
            .ToList(),
        Database = new
        {
            _dbHost,
            _dbPort,
            _dbUsername,
            _dbPassword,
            _dbName
        }
    };
}
