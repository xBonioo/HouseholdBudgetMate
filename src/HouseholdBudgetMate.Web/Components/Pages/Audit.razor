@page "/admin/audit"
@using HouseholdBudgetMate.Abstractions.Contracts.Audit.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Audit.Requests
@using HouseholdBudgetMate.Abstractions.Contracts.Common.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Loans.Requests
@using HouseholdBudgetMate.Abstractions.Contracts.Users.Dto
@using HouseholdBudgetMate.Abstractions.Interfaces
@using HouseholdBudgetMate.Application.Kernel.Exceptions
@using HouseholdBudgetMate.Domain
@using HouseholdBudgetMate.Web.Components.Dialogs
@using HouseholdBudgetMate.Web.Services
@using MudBlazor

@inject IAuditService AuditService
@inject ILoanService LoanService
@inject IUserService UserService
@inject IUserSessionService UserSessionService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (!HasBudgetSession)
{
    <MudPaper Class="pa-4 hb-panel">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            Nie masz uprawnień do dziennika audytu.
        </MudAlert>
    </MudPaper>
}
else
{
    <MudOverlay Visible="@_isLoading" Absolute="true" DarkBackground="true">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
    </MudOverlay>

    <MudStack Spacing="0">
        <MudPaper Class="hb-page-header">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">Audyt zmian</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">
                        Historia zmian finansowych w bieżącym budżecie.
                    </MudText>
                </MudStack>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                    Wyniki: @_logs.Count
                </MudChip>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 mt-4 hb-panel">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h6">Operacje kredytowe</MudText>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudSelect T="string"
                               Label="Typ operacji"
                               @bind-Value="_loanOperationType"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var option in LoanOperationTypeOptions)
                        {
                            <MudSelectItem Value="@option.Value">@option.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="SearchAsync"
                               Disabled="_isLoading">
                        Szukaj
                    </MudButton>
                </MudStack>
            </MudStack>

            @if (_loanOperations.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="hb-muted">Brak operacji kredytowych dla wybranych filtrów.</MudText>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <MudTable Items="_loanOperations" Dense="true" Hover="true" RowsPerPage="50">
                        <HeaderContent>
                            <MudTh>Data</MudTh>
                            <MudTh>Użytkownik</MudTh>
                            <MudTh>Kredyt</MudTh>
                            <MudTh>Operacja</MudTh>
                            <MudTh>Szczegóły</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Akcje</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="operation">
                            <MudTd DataLabel="Data" Style="white-space: nowrap;">@FormatDate(operation.OccurredAtUtc)</MudTd>
                            <MudTd DataLabel="Użytkownik">@operation.UserName</MudTd>
                            <MudTd DataLabel="Kredyt">@operation.LoanName</MudTd>
                            <MudTd DataLabel="Operacja">
                                <MudChip T="string" Size="Size.Small" Color="@GetLoanOperationColor(operation.OperationType)">
                                    @GetLoanOperationLabel(operation.OperationType)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="SzczegĂłĹ‚y">@operation.OperationContext</MudTd>
                            <MudTd DataLabel="Status">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@GetLoanOperationStatusLabel(operation.Status)</MudText>
                                    @if (!operation.CanRevert && !string.IsNullOrWhiteSpace(operation.RevertBlockedReason))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning">@operation.RevertBlockedReason</MudText>
                                    }
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="Akcje">
                                @if (IsSupportedLoanOperation(operation))
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Undo"
                                               Disabled="@(!operation.CanRevert)"
                                               OnClick="() => RevertLoanOperationAsync(operation)">
                                        Cofnij
                                    </MudButton>
                                }
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="@PageSizeOptions"
                                           RowsPerPageString="Wierszy na stronÄ™"
                                           InfoFormat="{first_item}-{last_item} z {all_items}"/>
                        </PagerContent>
                    </MudTable>
                </div>
            }
        </MudPaper>

        @if (IsAdminSession)
        {
        <MudPaper Class="pa-4 mt-4 hb-panel">
            <MudText Typo="Typo.h6" Class="mb-3">Dziennik encji</MudText>
            <ActionForm OnSubmit="SearchAsync">
                <MudGrid>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="string"
                                   Label="Typ encji"
                                   @bind-Value="_entityType"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true">
                            @foreach (var option in EntityTypeOptions)
                            {
                                <MudSelectItem Value="@option.Value">@option.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="string"
                                   Label="Operacja"
                                   @bind-Value="_operation"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true">
                            @foreach (var option in OperationOptions)
                            {
                                <MudSelectItem Value="@option.Value">@option.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="string"
                                   Label="Użytkownik"
                                   @bind-Value="_userId"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true">
                            @foreach (var user in _users)
                            {
                                <MudSelectItem Value="@user.Id">@user.Username</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudDatePicker Label="Od"
                                       Date="@_fromDate"
                                       DateChanged="date => _fromDate = date"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudDatePicker Label="Do"
                                       Date="@_toDate"
                                       DateChanged="date => _toDate = date"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="_isLoading">
                            Szukaj
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </ActionForm>
        </MudPaper>

        <MudPaper Class="pa-4 mt-4 hb-panel">
            @if (_logs.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="hb-muted">Brak wpisów dla wybranych filtrów.</MudText>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <MudTable Items="_logs" Dense="true" Hover="true" RowsPerPage="50">
                        <HeaderContent>
                            <MudTh></MudTh>
                            <MudTh>Data</MudTh>
                            <MudTh>Użytkownik</MudTh>
                            <MudTh>Typ encji</MudTh>
                            <MudTh>Operacja</MudTh>
                            <MudTh>Dotyczy</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="log">
                            <MudTd>
                                <MudIconButton Size="Size.Small"
                                               Icon="@(IsExpanded(log.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                               OnClick="() => ToggleExpanded(log.Id)"/>
                            </MudTd>
                            <MudTd DataLabel="Data" Style="white-space: nowrap;">@FormatDate(log.ChangedAtUtc)</MudTd>
                            <MudTd DataLabel="Użytkownik">@log.UserName</MudTd>
                            <MudTd DataLabel="Typ encji">@GetEntityTypeLabel(log.EntityType)</MudTd>
                            <MudTd DataLabel="Operacja">
                                <MudChip T="string" Size="Size.Small" Color="@GetOperationColor(log.Operation)">
                                    @GetOperationLabel(log.Operation)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Dotyczy">@log.EntityContext</MudTd>
                        </RowTemplate>
                        <ChildRowContent Context="log">
                            @if (IsExpanded(log.Id))
                            {
                                <MudTd colspan="6" Class="pa-3">
                                    <MudStack Spacing="1" Class="mb-3">
                                        <MudText Typo="Typo.subtitle2">Dotyczy</MudText>
                                        <MudText Typo="Typo.body2">@log.EntityContext</MudText>
                                        <MudText Typo="Typo.caption" Class="hb-muted">
                                            @GetEntityTypeLabel(log.EntityType) #@log.EntityId
                                        </MudText>
                                    </MudStack>
                                    @if (log.DiffItems.Count == 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="hb-muted">Brak szczegółów zmiany.</MudText>
                                    }
                                    else
                                    {
                                        <MudSimpleTable Dense="true" Hover="true">
                                            <thead>
                                            <tr>
                                                <th>Pole</th>
                                                <th>Przed zmianą</th>
                                                <th>Po zmianie</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var diff in log.DiffItems)
                                            {
                                                <tr>
                                                    <td>@diff.DisplayName</td>
                                                    <td>@diff.OldValue</td>
                                                    <td>@diff.NewValue</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </MudSimpleTable>
                                    }
                                </MudTd>
                            }
                        </ChildRowContent>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="@PageSizeOptions"
                                           RowsPerPageString="Wierszy na stronę"
                                           InfoFormat="{first_item}-{last_item} z {all_items}"/>
                        </PagerContent>
                    </MudTable>
                </div>
            }
        </MudPaper>
        }
    </MudStack>
}

@code {
    private static readonly IReadOnlyList<SelectOptionDto> EntityTypeOptions =
    [
        new("Expense", "Wydatek"),
        new("Income", "Wpływ"),
        new("Account", "Konto"),
        new("AccountMonthBalance", "Saldo miesięczne"),
        new("ExpenseLineItem", "Pozycja wydatku"),
        new("MonthSavingsTransferItem", "Oszczędności"),
        new("Category", "Kategoria"),
        new("LoanInstallment", "Rata kredytu"),
        new("RegularExpenseDefinition", "Cykliczny wydatek"),
        new("RegularIncomeDefinition", "Cykliczny wpływ")
    ];

    private static readonly IReadOnlyList<SelectOptionDto> OperationOptions =
    [
        new("Create", "Utworzenie"),
        new("Update", "Aktualizacja"),
        new("Delete", "Usunięcie")
    ];
    private static readonly IReadOnlyList<SelectOptionDto> LoanOperationTypeOptions =
    [
        new(LoanOperationAuditTypes.LoanPrepayment, "Nadplata kredytu"),
        new(LoanOperationAuditTypes.LoanRateEntry, "Aktualizacja WIBOR"),
        new(LoanOperationAuditTypes.LoanOperationRevert, "Cofniecie")
    ];

    private static readonly int[] PageSizeOptions = [50];

    private bool _isLoading;
    private string? _entityType;
    private string? _operation;
    private string? _loanOperationType;
    private string? _userId;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private List<UserDto> _users = [];
    private IReadOnlyList<AuditLogDto> _logs = [];
    private IReadOnlyList<LoanOperationAuditDto> _loanOperations = [];
    private readonly HashSet<int> _expandedLogIds = [];

    private bool HasBudgetSession => UserSessionService.CurrentUser is not null;
    private bool IsAdminSession => UserSessionService.CurrentUser?.IsAdmin == true;

    protected override async Task OnInitializedAsync()
    {
        if (!HasBudgetSession)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        _toDate = DateTime.Today;
        _fromDate = DateTime.Today.AddDays(-30);
        await LoadUsersAndLogsAsync();
    }

    private async Task LoadUsersAndLogsAsync()
    {
        _isLoading = true;

        try
        {
            if (IsAdminSession)
            {
                _users = (await UserService.GetUsersAsync(CancellationToken.None)).ToList();
            }
            await SearchCoreAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie można wczytać audytu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        _isLoading = true;
        _expandedLogIds.Clear();

        try
        {
            await SearchCoreAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie można wyszukać wpisów audytu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SearchCoreAsync()
    {
        var fromUtc = ToUtcStartOfDay(_fromDate);
        var toUtc = ToUtcEndOfDay(_toDate);
        var userId = string.IsNullOrWhiteSpace(_userId) ? null : _userId;

        _loanOperations = await AuditService.SearchLoanOperationsAsync(
            new SearchAuditLogsRequest
            {
                Operation = string.IsNullOrWhiteSpace(_loanOperationType) ? null : _loanOperationType,
                UserId = userId,
                FromUtc = fromUtc,
                ToUtc = toUtc
            },
            CancellationToken.None);

        if (!IsAdminSession)
        {
            _logs = [];
            return;
        }

        _logs = await AuditService.SearchAsync(
            new SearchAuditLogsRequest
            {
                EntityType = string.IsNullOrWhiteSpace(_entityType) ? null : _entityType,
                Operation = string.IsNullOrWhiteSpace(_operation) ? null : _operation,
                UserId = userId,
                FromUtc = fromUtc,
                ToUtc = toUtc
            },
            CancellationToken.None);
    }

    private static DateTime? ToUtcStartOfDay(DateTime? date)
    {
        return date is null
            ? null
            : DateTime.SpecifyKind(date.Value.Date, DateTimeKind.Local).ToUniversalTime();
    }

    private static DateTime? ToUtcEndOfDay(DateTime? date)
    {
        return date is null
            ? null
            : DateTime.SpecifyKind(date.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Local).ToUniversalTime();
    }

    private bool IsExpanded(int id)
    {
        return _expandedLogIds.Contains(id);
    }

    private void ToggleExpanded(int id)
    {
        if (!_expandedLogIds.Add(id))
        {
            _expandedLogIds.Remove(id);
        }
    }

    private static string GetEntityTypeLabel(string entityType)
    {
        return EntityTypeOptions.FirstOrDefault(x => x.Value == entityType)?.Label ?? entityType;
    }

    private static string GetOperationLabel(string operation)
    {
        return OperationOptions.FirstOrDefault(x => x.Value == operation)?.Label ?? operation;
    }

    private static Color GetOperationColor(string operation)
    {
        return operation switch
        {
            "Create" => Color.Success,
            "Update" => Color.Info,
            "Delete" => Color.Error,
            _ => Color.Default
        };
    }

    private static bool IsSupportedLoanOperation(LoanOperationAuditDto operation)
    {
        return operation.OperationType is LoanOperationAuditTypes.LoanPrepayment
            or LoanOperationAuditTypes.LoanRateEntry;
    }

    private static string GetLoanOperationLabel(string operationType)
    {
        return LoanOperationTypeOptions.FirstOrDefault(x => x.Value == operationType)?.Label ?? operationType;
    }

    private static string GetLoanOperationStatusLabel(string status)
    {
        return status switch
        {
            LoanOperationAuditStatuses.Active => "Aktywna",
            LoanOperationAuditStatuses.Reverted => "Cofnieta",
            _ => status
        };
    }

    private static Color GetLoanOperationColor(string operationType)
    {
        return operationType switch
        {
            LoanOperationAuditTypes.LoanPrepayment => Color.Success,
            LoanOperationAuditTypes.LoanRateEntry => Color.Info,
            LoanOperationAuditTypes.LoanOperationRevert => Color.Secondary,
            _ => Color.Default
        };
    }

    private async Task RevertLoanOperationAsync(LoanOperationAuditDto operation)
    {
        if (!await ConfirmRevertAsync(operation))
        {
            return;
        }

        _isLoading = true;

        try
        {
            await LoanService.RevertLoanOperationAsync(
                new RevertLoanOperationRequest
                {
                    LoanOperationAuditId = operation.Id,
                    ExpectedScheduleVersion = operation.ScheduleVersionAfter
                },
                CancellationToken.None);

            Snackbar.Add("Operacja kredytowa została cofnięta.", Severity.Success);
            await SearchCoreAsync();
        }
        catch (ConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await SearchCoreAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie można cofnąć operacji kredytowej: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<bool> ConfirmRevertAsync(LoanOperationAuditDto operation)
    {
        var message = $"Cofnąć operacje {GetLoanOperationLabel(operation.OperationType)} dla kredytu {operation.LoanName}? "
                      + $"{operation.OperationContext}. Jeśli po tej zmianie harmonogram kredytu został zmieniony, cofanie zostanie zablokowane.";
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Message)] = message
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Cofnij operacje kredytu", parameters, options);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private static string FormatDate(DateTime changedAtUtc)
    {
        return changedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

}
