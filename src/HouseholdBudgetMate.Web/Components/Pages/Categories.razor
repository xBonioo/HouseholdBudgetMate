@page "/categories"
@using System.Globalization
@using System.Text.RegularExpressions
@using HouseholdBudgetMate.Abstractions.Contracts.Categories.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Categories.Requests
@using HouseholdBudgetMate.Abstractions.Contracts.Categories.Responses
@using HouseholdBudgetMate.Abstractions.Interfaces
@using HouseholdBudgetMate.Abstractions.Parsing
@using HouseholdBudgetMate.Web.Components.Dialogs
@using HouseholdBudgetMate.Web.Services
@using MudBlazor

@inject ICategoryService CategoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IUserSessionService UserSessionService

<DirtyStateMonitor @ref="_dirtyStateMonitor"
                   CurrentState="GetDirtyState()"
                   ResetKey="_dirtyResetVersion"
                   Enabled="@(!_isLoading && IsAdminSession)"
                   Label="kategorie"/>

<MudOverlay Visible="@_isLoading" Absolute="true" DarkBackground="true">
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
</MudOverlay>

<div class="categories-page-root">
    <MudStack Spacing="0" Class="categories-page">
        <MudPaper Class="categories-header hb-page-header">
            <div class="categories-header-content">
                <div>
                    <MudText Typo="Typo.h4" Class="categories-title">Kategorie</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">@GetHeaderDescription()</MudText>
                </div>

                <div class="categories-header-stats">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">Kategorie: @_categories.Count</MudChip>
                    <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">Tagi: @_categories.Sum(x => x.Tags.Count)</MudChip>
                </div>
            </div>
        </MudPaper>

        <MudPaper Class="hb-panel categories-panel mt-4">
            <div class="categories-toolbar">
                <div>
                    <MudText Typo="Typo.h6">@(IsAdminSession ? "Nowa kategoria" : "Podgląd kategorii")</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">@GetToolbarDescription()</MudText>
                </div>

                <MudTextField @bind-Value="_searchText"
                              Label="Szukaj kategorii lub tagu"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true"
                              Class="categories-search-field"
                              aria-label="Szukaj kategorii lub tagu"/>
            </div>

            @if (IsAdminSession)
            {
                <ActionForm OnSubmit="CreateCategoryAsync">
                    <MudGrid Class="categories-create-grid">
                    <MudItem xs="12" md="3">
                        <MudTextField
                            @bind-Value="_newCategory.Name"
                            Label="Nazwa kategorii"
                            Variant="Variant.Outlined"
                            Required="true"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudTextField @bind-Value="_newCategoryEnvelopeLimitInput"
                                      Label="Limit"
                                      Variant="Variant.Outlined"
                                      Immediate="true"/>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="color-editor-inline">
                            <input type="color"
                                   class="hb-color-picker"
                                   @bind="_newCategory.Color"
                                   aria-label="Wybierz kolor kategorii"/>
                            <MudTextField
                                @bind-Value="_newCategory.Color"
                                Label="Kolor HEX"
                                Variant="Variant.Outlined"
                                Required="true"
                                Margin="Margin.Dense"/>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2" Class="d-flex align-center">
                        <MudSwitch
                            @bind-Value="_newCategory.SupportsLineItems"
                            Color="Color.Secondary"
                            Label="Pozycje"/>
                    </MudItem>
                    <MudItem xs="12" md="2" Class="d-flex align-center justify-end">
                        <MudButton
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            ButtonType="ButtonType.Submit"
                            Class="categories-submit-button">
                            Dodaj
                        </MudButton>
                    </MudItem>
                    </MudGrid>
                </ActionForm>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    Kategorie i tagi może zmieniać tylko administrator.
                </MudAlert>
            }
        </MudPaper>

        @{
            var filteredCategories = FilteredCategories;
        }

        @if (_categories.Count == 0)
        {
            <MudPaper Class="hb-panel categories-panel mt-4">
                <div class="categories-empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary"/>
                    <MudText Typo="Typo.subtitle1">Brak kategorii</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">@GetEmptyCategoriesDescription()</MudText>
                </div>
            </MudPaper>
        }
        else if (filteredCategories.Count == 0)
        {
            <MudPaper Class="hb-panel categories-panel mt-4">
                <div class="categories-empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Default"/>
                    <MudText Typo="Typo.subtitle1">Brak wyników</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">@GetEmptySearchDescription()</MudText>
                </div>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="2" Class="mt-4">
                @foreach (var category in filteredCategories)
                {
                    <MudPaper Class="pa-4 hb-panel category-card">
                        @if (_editCategory is not null && _editCategory.Id == category.Id && IsAdminSession)
                        {
                            <ActionForm OnSubmit="SaveCategoryEditAsync">
                                <div class="category-edit-layout">
                                    <MudTextField @bind-Value="_editCategory.Name"
                                                  Label="Nazwa"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Class="category-name-field"/>
                                    <input type="color"
                                           class="hb-color-picker"
                                           @bind="_editCategory.Color"
                                           aria-label="Wybierz kolor kategorii"/>
                                    <MudTextField @bind-Value="_editCategory.Color"
                                                  Label="HEX"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Class="category-hex-field"/>
                                    <MudSwitch
                                        @bind-Value="_editCategory.SupportsLineItems"
                                        Color="Color.Secondary"
                                        Label="Pozycje"/>
                                    <MudTextField @bind-Value="_editCategoryEnvelopeLimitInput"
                                                  Label="Limit"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  Class="category-limit-field"/>
                                    <MudChip T="string" Variant="Variant.Outlined">Tagi: @category.Tags.Count</MudChip>

                                    <div class="category-row-actions">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   ButtonType="ButtonType.Submit">
                                            Zapisz
                                        </MudButton>
                                        <MudButton Variant="Variant.Text"
                                                   ButtonType="ButtonType.Button"
                                                   OnClick="CancelCategoryEdit">
                                            Anuluj
                                        </MudButton>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       aria-label="@($"Usuń kategorię {category.Name}")"
                                                       title="@($"Usuń kategorię {category.Name}")"
                                                       OnClick="() => DeleteCategoryAsync(category)"/>
                                    </div>
                                </div>
                            </ActionForm>
                        }
                        else
                        {
                            <div class="category-card-header">
                                <div class="category-title-group">
                                    <span class="category-color-dot"
                                          style="@($"background-color:{category.Color}")"
                                          aria-hidden="true"></span>
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="categories-row-title">@category.Name</MudText>
                                        <MudText Typo="Typo.caption" Class="hb-muted">
                                            Kolor @category.Color
                                        </MudText>
                                    </div>
                                </div>

                                <div class="category-row-actions">
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.LocalOffer"
                                               OnClick="() => ToggleCategoryTags(category.Id)">
                                        @(IsCategoryExpanded(category.Id) ? "Zwiń tagi" : "Tagi")
                                    </MudButton>
                                    @if (IsAdminSession)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Color="Color.Primary"
                                                       aria-label="@($"Edytuj kategorię {category.Name}")"
                                                       title="@($"Edytuj kategorię {category.Name}")"
                                                       OnClick="() => BeginCategoryEdit(category)"/>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       aria-label="@($"Usuń kategorię {category.Name}")"
                                                       title="@($"Usuń kategorię {category.Name}")"
                                                       OnClick="() => DeleteCategoryAsync(category)"/>
                                    }
                                </div>
                            </div>

                            <div class="category-meta-row">
                                <MudChip T="string" Variant="Variant.Outlined">Tagi: @category.Tags.Count</MudChip>
                                <MudChip T="string"
                                         Variant="Variant.Outlined"
                                         Color="@(category.SupportsLineItems ? Color.Secondary : Color.Default)">
                                    @(category.SupportsLineItems ? "Pozycje: tak" : "Pozycje: nie")
                                </MudChip>
                                @if (category.EnvelopeLimit.HasValue)
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">
                                        Limit: @FormatMoney(category.EnvelopeLimit.Value)
                                    </MudChip>
                                }
                            </div>
                        }

                        @if (IsCategoryExpanded(category.Id))
                        {
                            <MudDivider Class="my-3"/>

                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">Tagi i podtagi</MudText>

                                @if (category.Tags.Count == 0)
                                {
                                    <div class="categories-empty-state categories-compact-empty">
                                        <MudText Typo="Typo.body2" Class="hb-muted">Brak tagów w tej kategorii.</MudText>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var rootTag in GetRootTagsForDisplay(category))
                                    {
                                        <MudPaper Class="pa-2 hb-panel tag-inline-row tag-inline-row-root">
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                @if (_editTag is not null && _editTag.Id == rootTag.Id && IsAdminSession)
                                                {
                                                    <ActionForm OnSubmit="SaveTagEditAsync">
                                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="tag-inline-main">
                                                            <MudTextField @bind-Value="_editTag.Name"
                                                                          Label="Edytuj tag"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"/>
                                                            <MudSelect T="int?"
                                                                       @bind-Value="_editTag.ParentTagId"
                                                                       Label="Tag główny"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       ToStringFunc="GetParentTagSelectText"
                                                                       Class="hb-select-ellipsis">
                                                                <MudSelectItem T="int?" Value="@((int?)null)">Brak</MudSelectItem>
                                                                @foreach (var rootTagOption in GetRootTagOptions(category.Id, _editTag.Id))
                                                                {
                                                                    <MudSelectItem T="int?" Value="@rootTagOption.Id">@rootTagOption.Name</MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                            <MudSelect T="bool?"
                                                                       @bind-Value="_editTag.SupportsLineItemsOverride"
                                                                       Label="Pozycje"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense">
                                                                <MudSelectItem T="bool?" Value="@((bool?)null)">Dziedzicz</MudSelectItem>
                                                                <MudSelectItem T="bool?" Value="true">Tak</MudSelectItem>
                                                                <MudSelectItem T="bool?" Value="false">Nie</MudSelectItem>
                                                            </MudSelect>
                                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Zapisz</MudButton>
                                                            <MudButton Variant="Variant.Text" ButtonType="ButtonType.Button" OnClick="CancelTagEdit">Anuluj</MudButton>
                                                        </MudStack>
                                                    </ActionForm>
                                                }
                                                else
                                                {
                                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                        <MudText Typo="Typo.subtitle2">@rootTag.Name</MudText>
                                                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">
                                                            @GetTagLineItemsLabel(rootTag.SupportsLineItemsOverride)
                                                        </MudChip>
                                                    </MudStack>
                                                }

                                                @if (IsAdminSession)
                                                {
                                                    <MudStack Row="true" Spacing="1" Class="tag-inline-actions">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                       Color="Color.Primary"
                                                                       aria-label="@($"Edytuj tag {rootTag.Name}")"
                                                                       title="@($"Edytuj tag {rootTag.Name}")"
                                                                       OnClick="() => BeginTagEdit(rootTag)"/>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                       Color="Color.Error"
                                                                       aria-label="@($"Usuń tag {rootTag.Name}")"
                                                                       title="@($"Usuń tag {rootTag.Name}")"
                                                                       OnClick="() => DeleteTagAsync(rootTag.Id)"/>
                                                    </MudStack>
                                                }
                                            </MudStack>
                                        </MudPaper>

                                        @if (GetChildTagsForDisplay(category, rootTag.Id).Count > 0)
                                        {
                                            <MudStack Spacing="1" Class="tag-children-list">
                                                @foreach (var childTag in GetChildTagsForDisplay(category, rootTag.Id))
                                                {
                                                    <MudPaper Class="pa-2 hb-panel tag-inline-row tag-inline-row-child">
                                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                            @if (_editTag is not null && _editTag.Id == childTag.Id && IsAdminSession)
                                                            {
                                                                <ActionForm OnSubmit="SaveTagEditAsync">
                                                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="tag-inline-main">
                                                                        <MudTextField @bind-Value="_editTag.Name"
                                                                                      Label="Edytuj tag"
                                                                                      Variant="Variant.Outlined"
                                                                                      Margin="Margin.Dense"/>
                                                                        <MudSelect T="int?"
                                                                                   @bind-Value="_editTag.ParentTagId"
                                                                                   Label="Tag główny"
                                                                                   Variant="Variant.Outlined"
                                                                                   Margin="Margin.Dense"
                                                                                   ToStringFunc="GetParentTagSelectText"
                                                                                   Class="hb-select-ellipsis">
                                                                            <MudSelectItem T="int?" Value="@((int?)null)">Brak</MudSelectItem>
                                                                            @foreach (var rootTagOption in GetRootTagOptions(category.Id, _editTag.Id))
                                                                            {
                                                                                <MudSelectItem T="int?" Value="@rootTagOption.Id">@rootTagOption.Name</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                        <MudSelect T="bool?"
                                                                                   @bind-Value="_editTag.SupportsLineItemsOverride"
                                                                                   Label="Pozycje"
                                                                                   Variant="Variant.Outlined"
                                                                                   Margin="Margin.Dense">
                                                                            <MudSelectItem T="bool?" Value="@((bool?)null)">Dziedzicz</MudSelectItem>
                                                                            <MudSelectItem T="bool?" Value="true">Tak</MudSelectItem>
                                                                            <MudSelectItem T="bool?" Value="false">Nie</MudSelectItem>
                                                                        </MudSelect>
                                                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Zapisz</MudButton>
                                                                        <MudButton Variant="Variant.Text" ButtonType="ButtonType.Button" OnClick="CancelTagEdit">Anuluj</MudButton>
                                                                    </MudStack>
                                                                </ActionForm>
                                                            }
                                                            else
                                                            {
                                                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                                    <MudText Typo="Typo.subtitle2">@childTag.Name</MudText>
                                                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">
                                                                        @GetTagLineItemsLabel(childTag.SupportsLineItemsOverride)
                                                                    </MudChip>
                                                                </MudStack>
                                                            }

                                                            @if (IsAdminSession)
                                                            {
                                                                <MudStack Row="true" Spacing="1" Class="tag-inline-actions">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                                   Color="Color.Primary"
                                                                                   aria-label="@($"Edytuj tag {childTag.Name}")"
                                                                                   title="@($"Edytuj tag {childTag.Name}")"
                                                                                   OnClick="() => BeginTagEdit(childTag)"/>
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                                   Color="Color.Error"
                                                                                   aria-label="@($"Usuń tag {childTag.Name}")"
                                                                                   title="@($"Usuń tag {childTag.Name}")"
                                                                                   OnClick="() => DeleteTagAsync(childTag.Id)"/>
                                                                </MudStack>
                                                            }
                                                        </MudStack>
                                                    </MudPaper>
                                                }
                                            </MudStack>
                                        }
                                    }
                                }

                                @if (IsAdminSession)
                                {
                                    <ActionForm OnSubmit="() => CreateTagAsync(category.Id)">
                                        <MudStack Row="true"
                                                  Spacing="2"
                                                  AlignItems="AlignItems.Center"
                                                  Wrap="Wrap.Wrap"
                                                  Class="tag-create-row">
                                            <MudTextField
                                                @bind-Value="GetTagCreateModel(category.Id).Name"
                                                Label="Nowy tag lub podtag"
                                                Variant="Variant.Outlined"
                                                Margin="Margin.Dense"
                                                Class="tag-create-name"/>
                                            <MudSelect T="int?"
                                                       @bind-Value="GetTagCreateModel(category.Id).ParentTagId"
                                                       Label="Tag główny"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       ToStringFunc="GetParentTagSelectText"
                                                       Class="hb-select-ellipsis">
                                                <MudSelectItem T="int?" Value="@((int?)null)">Brak</MudSelectItem>
                                                @foreach (var rootTag in GetRootTagOptions(category.Id, null))
                                                {
                                                    <MudSelectItem T="int?" Value="@rootTag.Id">@rootTag.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudSelect T="bool?"
                                                       @bind-Value="GetTagCreateModel(category.Id).SupportsLineItemsOverride"
                                                       Label="Pozycje"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense">
                                                <MudSelectItem T="bool?" Value="@((bool?)null)">Dziedzicz</MudSelectItem>
                                                <MudSelectItem T="bool?" Value="true">Tak</MudSelectItem>
                                                <MudSelectItem T="bool?" Value="false">Nie</MudSelectItem>
                                            </MudSelect>
                                            <MudButton
                                                Variant="Variant.Outlined"
                                                Color="Color.Primary"
                                                StartIcon="@Icons.Material.Filled.Add"
                                                ButtonType="ButtonType.Submit">
                                                Dodaj tag
                                            </MudButton>
                                        </MudStack>
                                    </ActionForm>
                                }
                            </MudStack>
                        }
                    </MudPaper>
                }
            </MudStack>
        }
    </MudStack>
</div>

@code {
    private bool _isLoading;
    private string _searchText = string.Empty;
    private List<CategoryDto> _categories = [];

    private CreateCategoryRequest _newCategory = new()
    {
        Color = "#4CAF50"
    };

    private UpdateCategoryRequest? _editCategory;
    private UpdateTagRequest? _editTag;

    private readonly Dictionary<int, TagCreateRequest> _tagCreateModels = new();
    private readonly HashSet<int> _expandedCategoryIds = [];
    private static readonly CultureInfo Culture = new("pl-PL");
    private string _newCategoryEnvelopeLimitInput = string.Empty;
    private string _editCategoryEnvelopeLimitInput = string.Empty;
    private DirtyStateMonitor? _dirtyStateMonitor;
    private int _dirtyResetVersion;

    private static readonly Regex HexColorRegex = new("^#(?:[0-9a-fA-F]{6})$", RegexOptions.Compiled);

    private List<CategoryDto> FilteredCategories => _categories
        .Where(IsCategoryMatch)
        .OrderBy(x => x.Name)
        .ToList();

    private bool IsAdminSession => UserSessionService.CurrentUser?.IsAdmin == true;

    private string GetHeaderDescription()
    {
        return IsAdminSession
            ? "Dodawaj kategorie, tagi i podtagi używane w planie budżetu."
            : "Przeglądaj kategorie, tagi i podtagi używane w planie budżetu.";
    }

    private string GetToolbarDescription()
    {
        return IsAdminSession
            ? "Nazwa i kolor wystarczą. Limit oraz pozycje są opcjonalne."
            : "Możesz wyszukiwać i rozwijać kategorie. Zmiany wprowadza administrator.";
    }

    private string GetEmptyCategoriesDescription()
    {
        return IsAdminSession
            ? "Dodaj pierwszą kategorię, aby zacząć porządkować wydatki."
            : "Administrator nie dodał jeszcze kategorii.";
    }

    private string GetEmptySearchDescription()
    {
        return IsAdminSession
            ? "Zmień filtr lub dodaj nową kategorię."
            : "Zmień filtr, aby znaleźć kategorię lub tag.";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            _categories = (await CategoryService.GetAllAsync(CancellationToken.None)).ToList();
            _expandedCategoryIds.RemoveWhere(categoryId => _categories.All(x => x.Id != categoryId));
            MarkDirtyStatePristine();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool IsCategoryMatch(CategoryDto category)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            return true;
        }

        var query = _searchText.Trim();

        return category.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
               || category.Tags.Any(t => t.Name.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private bool EnsureAdminCanManageCategories()
    {
        if (IsAdminSession)
        {
            return true;
        }

        Snackbar.Add("Kategorie i tagi może zmieniać tylko administrator.", Severity.Warning);
        return false;
    }

    private async Task CreateCategoryAsync()
    {
        if (!EnsureAdminCanManageCategories())
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_newCategory.Name))
        {
            Snackbar.Add("Podaj nazwę kategorii.", Severity.Warning);
            return;
        }

        if (!IsValidHexColor(_newCategory.Color))
        {
            Snackbar.Add("Kolor musi być w formacie HEX, np. #4CAF50.", Severity.Warning);
            return;
        }

        if (!LocalizedDecimalParser.TryParseOptionalNonNegative(_newCategoryEnvelopeLimitInput, out var envelopeLimit))
        {
            Snackbar.Add("Niepoprawny limit. Użyj liczby, np. 12,50 lub 12.50.", Severity.Warning);
            return;
        }

        _newCategory.EnvelopeLimit = envelopeLimit;

        try
        {
            await CategoryService.CreateCategoryAsync(_newCategory, CancellationToken.None);
            _newCategory = new CreateCategoryRequest { Color = "#4CAF50" };
            _newCategoryEnvelopeLimitInput = string.Empty;
            await LoadAsync();
            Snackbar.Add("Dodano kategorię.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void BeginCategoryEdit(CategoryDto category)
    {
        if (!EnsureAdminCanManageCategories())
        {
            return;
        }

        _editCategory = new UpdateCategoryRequest
        {
            Id = category.Id,
            Name = category.Name,
            Color = category.Color,
            EnvelopeLimit = category.EnvelopeLimit,
            SupportsLineItems = category.SupportsLineItems
        };

        _editCategoryEnvelopeLimitInput = category.EnvelopeLimit.HasValue
            ? category.EnvelopeLimit.Value.ToString("0.##", Culture)
            : string.Empty;
        MarkDirtyStatePristine();
    }

    private async Task SaveCategoryEditAsync()
    {
        if (!EnsureAdminCanManageCategories())
        {
            return;
        }

        if (_editCategory is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editCategory.Name))
        {
            Snackbar.Add("Nazwa kategorii nie może być pusta.", Severity.Warning);
            return;
        }

        if (!IsValidHexColor(_editCategory.Color))
        {
            Snackbar.Add("Kolor musi być w formacie HEX, np. #4CAF50.", Severity.Warning);
            return;
        }

        if (!LocalizedDecimalParser.TryParseOptionalNonNegative(_editCategoryEnvelopeLimitInput, out var envelopeLimit))
        {
            Snackbar.Add("Niepoprawny limit. Użyj liczby, np. 12,50 lub 12.50.", Severity.Warning);
            return;
        }

        _editCategory.EnvelopeLimit = envelopeLimit;

        try
        {
            await CategoryService.UpdateCategoryAsync(_editCategory, CancellationToken.None);
            _editCategory = null;
            await LoadAsync();
            Snackbar.Add("Zapisano kategorię.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelCategoryEdit()
    {
        _editCategory = null;
        _editCategoryEnvelopeLimitInput = string.Empty;
        MarkDirtyStatePristine();
    }

    private async Task DeleteCategoryAsync(CategoryDto category)
    {
        if (!EnsureAdminCanManageCategories())
        {
            return;
        }

        try
        {
            var impact = await CategoryService.GetCategoryDeletionImpactAsync(category.Id, CancellationToken.None);
            var request = new DeleteCategoryRequest { Id = category.Id };

            if (impact.HasAssignments)
            {
                var reassignment = await OpenDeleteReassignDialogAsync(
                    "Usuń kategorię",
                    true,
                    category.Name,
                    category.Id,
                    null,
                    impact.ExpenseCount,
                    impact.ExpenseLineItemCount);
                if (reassignment is null)
                {
                    return;
                }

                request.ReplacementCategoryId = reassignment.ReplacementCategoryId;
                request.ReplacementTagId = reassignment.ReplacementTagId;
            }
            else if (!await ConfirmAsync("Usuń kategorię", $"Usunąć kategorię '{category.Name}'?"))
            {
                return;
            }

            await CategoryService.DeleteCategoryAsync(request, CancellationToken.None);
            _expandedCategoryIds.Remove(category.Id);
            _tagCreateModels.Remove(category.Id);
            await LoadAsync();
            Snackbar.Add("Usunięto kategorię.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
    private TagCreateRequest GetTagCreateModel(int categoryId)
    {
        if (_tagCreateModels.TryGetValue(categoryId, out var model))
        {
            return model;
        }

        model = new TagCreateRequest();
        _tagCreateModels[categoryId] = model;
        return model;
    }

    private async Task CreateTagAsync(int categoryId)
    {
        if (!EnsureAdminCanManageCategories())
        {
            return;
        }

        var model = GetTagCreateModel(categoryId);

        if (string.IsNullOrWhiteSpace(model.Name))
        {
            Snackbar.Add("Podaj nazwę tagu.", Severity.Warning);
            return;
        }

        try
        {
            await CategoryService.CreateTagAsync(new CreateTagRequest
            {
                CategoryId = categoryId,
                Name = model.Name,
                ParentTagId = model.ParentTagId,
                SupportsLineItemsOverride = model.SupportsLineItemsOverride
            }, CancellationToken.None);

            _tagCreateModels[categoryId] = new TagCreateRequest();
            await LoadAsync();
            Snackbar.Add("Dodano tag.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void BeginTagEdit(TagDto tag)
    {
        if (!EnsureAdminCanManageCategories())
        {
            return;
        }

        _editTag = new UpdateTagRequest
        {
            Id = tag.Id,
            CategoryId = tag.CategoryId,
            Name = tag.Name,
            ParentTagId = tag.ParentTagId,
            SupportsLineItemsOverride = tag.SupportsLineItemsOverride
        };
        MarkDirtyStatePristine();
    }

    private IReadOnlyList<TagDto> GetRootTagOptions(int categoryId, int? excludeTagId)
    {
        return _categories
            .FirstOrDefault(x => x.Id == categoryId)?
            .Tags
            .Where(x => !x.ParentTagId.HasValue)
            .Where(x => !excludeTagId.HasValue || x.Id != excludeTagId.Value)
            .OrderBy(x => x.Name)
            .ToList() ?? [];
    }

    private static IReadOnlyList<TagDto> GetRootTagsForDisplay(CategoryDto category)
    {
        return category.Tags
            .Where(x => !x.ParentTagId.HasValue)
            .OrderBy(x => x.Name)
            .ToList();
    }

    private static IReadOnlyList<TagDto> GetChildTagsForDisplay(CategoryDto category, int parentTagId)
    {
        return category.Tags
            .Where(x => x.ParentTagId == parentTagId)
            .OrderBy(x => x.Name)
            .ToList();
    }

    private string GetParentTagSelectText(int? tagId)
    {
        if (!tagId.HasValue)
        {
            return "Brak";
        }

        return _categories
            .SelectMany(x => x.Tags)
            .FirstOrDefault(x => x.Id == tagId.Value)
            ?.Name ?? string.Empty;
    }

    private static string GetTagLineItemsLabel(bool? overrideValue)
    {
        return overrideValue switch
        {
            true => "Pozycje: tak",
            false => "Pozycje: nie",
            _ => "Pozycje: dziedzicz"
        };
    }

    private async Task SaveTagEditAsync()
    {
        if (!EnsureAdminCanManageCategories())
        {
            return;
        }

        if (_editTag is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_editTag.Name))
        {
            Snackbar.Add("Nazwa tagu nie może być pusta.", Severity.Warning);
            return;
        }

        try
        {
            await CategoryService.UpdateTagAsync(_editTag, CancellationToken.None);
            _editTag = null;
            await LoadAsync();
            Snackbar.Add("Zapisano tag.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelTagEdit()
    {
        _editTag = null;
        MarkDirtyStatePristine();
    }

    private async Task DeleteTagAsync(int tagId)
    {
        if (!EnsureAdminCanManageCategories())
        {
            return;
        }

        var tag = _categories
            .SelectMany(x => x.Tags)
            .FirstOrDefault(x => x.Id == tagId);
        var tagName = tag?.Name;
        var message = string.IsNullOrWhiteSpace(tagName)
            ? "Czy na pewno chcesz usunąć tag?"
            : $"Czy na pewno chcesz usunąć tag '{tagName}'?";

        try
        {
            var impact = await CategoryService.GetTagDeletionImpactAsync(tagId, CancellationToken.None);
            var request = new DeleteTagRequest { Id = tagId };

            if (impact.HasAssignments)
            {
                var reassignment = await OpenDeleteReassignDialogAsync(
                    "Usuń tag",
                    false,
                    tagName ?? "tag",
                    tag?.CategoryId ?? impact.CategoryId,
                    tagId,
                    impact.ExpenseCount,
                    impact.ExpenseLineItemCount);
                if (reassignment is null)
                {
                    return;
                }

                request.ReplacementTagId = reassignment.ReplacementTagId;
                request.ClearAssignments = reassignment.ClearAssignments;
            }
            else if (!await ConfirmAsync("Usuń tag", message))
            {
                return;
            }

            await CategoryService.DeleteTagAsync(request, CancellationToken.None);
            await LoadAsync();
            Snackbar.Add("Usunięto tag.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
    private bool IsValidHexColor(string? color)
    {
        return !string.IsNullOrWhiteSpace(color) && HexColorRegex.IsMatch(color);
    }

    private void ToggleCategoryTags(int categoryId)
    {
        if (!_expandedCategoryIds.Add(categoryId))
        {
            _expandedCategoryIds.Remove(categoryId);
            _editTag = null;
            MarkDirtyStatePristine();
        }
    }

    private bool IsCategoryExpanded(int categoryId)
    {
        return _expandedCategoryIds.Contains(categoryId);
    }

    private async Task<bool> ConfirmAsync(string title, string message)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmDialog.Message)] = message
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(title, parameters);
        var result = await dialog.Result;
        return result is not null && !result.Canceled;
    }

    private async Task<DeleteReassignResult?> OpenDeleteReassignDialogAsync(
        string title,
        bool isCategoryDelete,
        string itemName,
        int deletedCategoryId,
        int? deletedTagId,
        int expenseCount,
        int expenseLineItemCount)
    {
        var parameters = new DialogParameters
        {
            [nameof(CategoryDeleteReassignDialog.IsCategoryDelete)] = isCategoryDelete,
            [nameof(CategoryDeleteReassignDialog.ItemName)] = itemName,
            [nameof(CategoryDeleteReassignDialog.DeletedCategoryId)] = deletedCategoryId,
            [nameof(CategoryDeleteReassignDialog.DeletedTagId)] = deletedTagId,
            [nameof(CategoryDeleteReassignDialog.ExpenseCount)] = expenseCount,
            [nameof(CategoryDeleteReassignDialog.ExpenseLineItemCount)] = expenseLineItemCount,
            [nameof(CategoryDeleteReassignDialog.Categories)] = _categories
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CategoryDeleteReassignDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: DeleteReassignResult reassignment }
            ? reassignment
            : null;
    }
    private static string FormatMoney(decimal amount)
    {
        return $"{amount.ToString("N2", Culture)} zł";
    }

    private void MarkDirtyStatePristine()
    {
        _dirtyResetVersion++;
        _dirtyStateMonitor?.Reset(GetDirtyState());
    }

    private object GetDirtyState() => new
    {
        NewCategory = new
        {
            _newCategory.Name,
            _newCategory.Color,
            Limit = _newCategoryEnvelopeLimitInput,
            _newCategory.SupportsLineItems
        },
        EditCategory = _editCategory is null
            ? null
            : new
            {
                _editCategory.Id,
                _editCategory.Name,
                _editCategory.Color,
                Limit = _editCategoryEnvelopeLimitInput,
                _editCategory.SupportsLineItems
            },
        EditTag = _editTag is null
            ? null
            : new
            {
                _editTag.Id,
                _editTag.Name,
                _editTag.ParentTagId,
                _editTag.SupportsLineItemsOverride
            },
        NewTags = _tagCreateModels
            .OrderBy(kvp => kvp.Key)
            .Select(kvp => new
            {
                CategoryId = kvp.Key,
                kvp.Value.Name,
                kvp.Value.ParentTagId,
                kvp.Value.SupportsLineItemsOverride
            })
            .ToList()
    };
}
