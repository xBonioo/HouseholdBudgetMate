<MudPaper Class="pa-4 mt-4 hb-panel">
    <MudText Typo="Typo.h6">Zaoszczędzone pieniądze w miesiącach (YTD)</MudText>

    @if (_dashboardSummary.SavingsTimeline.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="hb-muted mt-3">Brak danych do podsumowania rocznego.</MudText>
    }
    else
    {
        <MudTable Items="_dashboardSummary.SavingsTimeline" Dense="true" Hover="true" Class="mt-3">
            <HeaderContent>
                <MudTh>Miesiąc</MudTh>
                <MudTh>Planowane</MudTh>
                <MudTh>Wydane</MudTh>
                <MudTh>Zaoszczędzone</MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                <MudTd>@($"{item.Month:D2}/{item.Year}")</MudTd>
                <MudTd>@item.PlannedAmount.ToString("0.00", _culture) PLN</MudTd>
                <MudTd>@item.SpentAmount.ToString("0.00", _culture) PLN</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(item.SavedAmount >= 0 ? Color.Success : Color.Error)">
                        @item.SavedAmount.ToString("0.00", _culture) PLN
                    </MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<MudPaper Class="pa-4 mt-4 hb-panel">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">Ostatnie wydatki</MudText>
        <MudChip T="string" Color="Color.Primary">@_monthLabel</MudChip>
    </MudStack>

    @if (_recentExpenses.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="hb-muted mt-3">Brak wydatków. Dodaj pierwszy wpis, aby zobaczyć postęp
            miesiąca.
        </MudText>
    }
    else
    {
        <MudList T="ExpenseDto" Dense="true" Class="mt-2">
            @foreach (var expense in _recentExpenses)
            {
                <MudListItem T="ExpenseDto">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Style="width:100%;">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1">@expense.Name</MudText>
                            <MudText Typo="Typo.caption"
                                     Class="hb-muted">@expense.CategoryName @(string.IsNullOrWhiteSpace(expense.TagName) ? string.Empty : $"/ {expense.TagName}")</MudText>
                        </MudStack>
                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                            <MudText Typo="Typo.body1">@(expense.ActualAmount.ToString("0.00")) PLN</MudText>
                            <MudText Typo="Typo.caption" Class="hb-muted">
                                plan: @(expense.PlannedAmount.ToString("0.00")) PLN
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    private bool _isLoading;
    private readonly CultureInfo _culture = new("pl-PL");
    private MonthPlanDto? _monthPlan;
    private MonthPlanKpiDto _kpi = new();
    private string _monthLabel = string.Empty;
    private List<ExpenseDto> _recentExpenses = [];
    private LiveBalanceDto _liveBalance = new();
    private List<UpcomingInstallmentItem> _upcomingInstallments = [];
    private DashboardSummaryDto _dashboardSummary = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;

        try
        {
            var now = DateTimeProvider.GetLocalDateTime();
            _monthPlan = await ExpenseService.GetMonthAsync(now.Year, now.Month, CancellationToken.None);
            _dashboardSummary = await ExpenseService.GetDashboardSummaryAsync(now.Year, now.Month, CancellationToken.None);
            _liveBalance = await IncomeService.GetLiveBalanceAsync(now.Year, now.Month, CancellationToken.None);
            var loans = await LoanService.GetAllAsync(CancellationToken.None);
            _monthLabel = $"{now:MMMM yyyy}";

            var windowStart = new DateOnly(now.Year, now.Month, 1);
            var windowEnd = windowStart.AddMonths(3);
            _upcomingInstallments = loans
                .SelectMany(x => x.Installments.Select(i => new UpcomingInstallmentItem(x.Name, i.Year, i.Month, i.DueDate, i.Amount, i.IsPaid)))
                .Where(x => !x.IsPaid)
                .Where(x => x.DueDate >= windowStart && x.DueDate < windowEnd)
                .OrderBy(x => x.DueDate)
                .Take(6)
                .ToList();

            if (_monthPlan is null)
            {
                _kpi = new MonthPlanKpiDto();
                _recentExpenses = [];
                _dashboardSummary = new DashboardSummaryDto { Year = now.Year, Month = now.Month };
                return;
            }

            _kpi = _monthPlan.Kpi;
            _recentExpenses = _monthPlan.Expenses
                .OrderByDescending(x => x.UpdatedAtUtc)
                .ThenByDescending(x => x.Id)
                .Take(6)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoToCurrentMonth()
    {
        var now = DateTimeProvider.GetLocalDateTime();
        NavigationManager.NavigateTo($"/plan/{now.Year}/{now.Month}");
    }

    private sealed record UpcomingInstallmentItem(
        string LoanName,
        int Year,
        int Month,
        DateOnly DueDate,
        decimal Amount,
        bool IsPaid);
    
}