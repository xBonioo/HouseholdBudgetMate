@page "/"
@using System.Globalization
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Incomes.Dto
@using HouseholdBudgetMate.Abstractions.Interfaces
@using HouseholdBudgetMate.Application.Kernel.Timing
@using HouseholdBudgetMate.Web.Services
@using MudBlazor

@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IDateTimeProvider DateTimeProvider
@inject IExpenseService ExpenseService
@inject IIncomeService IncomeService
@inject ILoanService LoanService

<MudOverlay Visible="@_isLoading" Absolute="true" DarkBackground="true">
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
</MudOverlay>

<MudPaper Class="hb-page-header">
    <MudText Typo="Typo.h4">Dashboard budżetu</MudText>
    <MudText Typo="Typo.body2" Class="hb-muted">Szybki podgląd aktualnego miesiąca i najważniejszych akcji.</MudText>

    <MudStack Row="true" Spacing="1" Class="mt-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CalendarMonth"
                   OnClick="GoToCurrentMonth">
            Otwórz miesiąc
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.AccountBalanceWallet"
                   OnClick="@(() => NavigationManager.NavigateTo("/accounts"))">
            Zarządzaj kontami
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.CreditScore"
                   OnClick="@(() => NavigationManager.NavigateTo("/loans"))">
            Zarządzaj kredytami
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Repeat"
                   OnClick="@(() => NavigationManager.NavigateTo("/recurring"))">
            Zarządzaj cyklicznymi
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Category"
                   OnClick="@(() => NavigationManager.NavigateTo("/categories"))">
            Zarządzaj kategoriami
        </MudButton>
    </MudStack>
</MudPaper>

<MudGrid Class="mt-1">
    <MudItem xs="12" md="4">
        <MudPaper Class="hb-kpi-card">
            <MudText Typo="Typo.caption" Class="hb-muted">Suma planowana</MudText>
            <MudText Class="hb-kpi-value">@_kpi.PlannedTotal.ToString("0.00", _culture) PLN</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="hb-kpi-card">
            <MudText Typo="Typo.caption" Class="hb-muted">Suma wydana</MudText>
            <MudText Class="hb-kpi-value">@_kpi.SpentTotal.ToString("0.00", _culture) PLN</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="hb-kpi-card">
            <MudText Typo="Typo.caption" Class="hb-muted">Pozostało</MudText>
            <MudText Class="hb-kpi-value">@_kpi.RemainingTotal.ToString("0.00", _culture) PLN</MudText>
            <MudProgressLinear Class="mt-2" Rounded="true" Value="@_kpi.RemainingPercent"
                               Color="@RemainingBudgetColorResolver.Resolve(_kpi.RemainingTotal, _kpi.RemainingPercent)"/>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid Class="mt-1">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="hb-kpi-card">
            <MudText Typo="Typo.caption" Class="hb-muted">Liczba transakcji</MudText>
            <MudText Class="hb-kpi-value">@_dashboardSummary.TransactionCount</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="hb-kpi-card">
            <MudText Typo="Typo.caption" Class="hb-muted">Wydatki poza planem</MudText>
            <MudText Class="hb-kpi-value">@_dashboardSummary.UnplannedSpentTotal.ToString("0.00", _culture) PLN</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="hb-kpi-card">
            <MudText Typo="Typo.caption" Class="hb-muted">Zaoszczędzone w miesiącu</MudText>
            <MudText Class="hb-kpi-value">@_dashboardSummary.SavedAmountThisMonth.ToString("0.00", _culture) PLN</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="hb-kpi-card">
            <MudText Typo="Typo.caption" Class="hb-muted">Zaoszczędzone YTD</MudText>
            <MudText Class="hb-kpi-value">@_dashboardSummary.SavedAmountYearToDate.ToString("0.00", _culture) PLN</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mt-4 hb-panel">
    <MudText Typo="Typo.h6">Szybki podgląd wpływów i oszczędności</MudText>
    <MudGrid Class="mt-2">
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.caption" Class="hb-muted">Średnie wpływy miesięczne (YTD)</MudText>
            <MudText Typo="Typo.h6">@_dashboardSummary.AverageMonthlyIncome.ToString("0.00", _culture) PLN</MudText>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.caption" Class="hb-muted">Średnie wydatki miesięczne (YTD)</MudText>
            <MudText Typo="Typo.h6">@_dashboardSummary.AverageMonthlySpent.ToString("0.00", _culture) PLN</MudText>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudText Typo="Typo.caption" Class="hb-muted">Średnie oszczędności miesięczne (YTD)</MudText>
            <MudText Typo="Typo.h6">@_dashboardSummary.AverageMonthlySaved.ToString("0.00", _culture) PLN</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mt-4 hb-panel">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">Live balance</MudText>
        <MudChip T="string" Color="Color.Primary">@_liveBalance.CurrentBalance.ToString("0.00") PLN</MudChip>
    </MudStack>

    <MudGrid Class="mt-2">
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.caption" Class="hb-muted">Konta bez oszczędności</MudText>
            <MudText Typo="Typo.h6">@_liveBalance.AccountsBaseTotal.ToString("0.00") PLN</MudText>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.caption" Class="hb-muted">Wpływy miesiąca</MudText>
            <MudText Typo="Typo.h6">@_liveBalance.IncomesTotal.ToString("0.00") PLN</MudText>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.caption" Class="hb-muted">Wydatki miesiąca</MudText>
            <MudText Typo="Typo.h6">@_liveBalance.ExpensesTotal.ToString("0.00") PLN</MudText>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.caption" Class="hb-muted">Oszczędności miesiąca</MudText>
            <MudText Typo="Typo.h6">@_liveBalance.SavingsTransfersTotal.ToString("0.00") PLN</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mt-4 hb-panel">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">Nadchodzące raty kredytów</MudText>
        <MudChip T="int" Color="Color.Secondary">@_upcomingInstallments.Count</MudChip>
    </MudStack>

    @if (_upcomingInstallments.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="hb-muted mt-3">Brak nadchodzących rat w kolejnych 3 miesiącach.</MudText>
    }
    else
    {
        <MudList T="UpcomingInstallmentItem" Dense="true" Class="mt-2">
            @foreach (var item in _upcomingInstallments)
            {
                <MudListItem T="UpcomingInstallmentItem">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Style="width:100%;">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1">@item.LoanName</MudText>
                            <MudText Typo="Typo.caption" Class="hb-muted">@($"{item.Month:D2}/{item.Year}")</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body1">@item.Amount.ToString("0.00", _culture) PLN</MudText>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

