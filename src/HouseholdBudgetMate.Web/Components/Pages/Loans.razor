    private async Task PreviewLoanScheduleChangeAsync(
        LoanScheduleChangeOperation operation,
        Func<Task<LoanScheduleChangePreviewDto>> previewFactory)
    {
        if (_loanScheduleChangePreviewBusy)
        {
            return;
        }

        _loanScheduleChangePreviewBusy = true;
        _loanScheduleChangeOperation = operation;
        try
        {
            _loanScheduleChangePreview = await previewFactory();
            _loanScheduleChangePreviewOpen = true;

            if (operation == LoanScheduleChangeOperation.Prepayment)
            {
                _prepaymentDialogOpen = false;
            }
            else if (operation == LoanScheduleChangeOperation.InstallmentAmountChange)
            {
                _installmentAmountChangeDialogOpen = false;
            }
        }
        catch (Exception ex)
        {
            _loanScheduleChangePreview = null;
            _loanScheduleChangePreviewOpen = false;
            _loanScheduleChangeOperation = LoanScheduleChangeOperation.None;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loanScheduleChangePreviewBusy = false;
        }
    }

