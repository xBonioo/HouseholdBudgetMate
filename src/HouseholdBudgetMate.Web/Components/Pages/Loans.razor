    private async Task ApplyPrepaymentAsync()
    {
        if (!TryBuildPrepaymentRequest(out var request))
        {
            return;
        }

        try
        {
            await PreviewLoanScheduleChangeAsync(
                LoanScheduleChangeOperation.Prepayment,
                () => LoanService.PreviewApplyLoanPrepaymentAsync(request, CancellationToken.None));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmLoanScheduleChangeAsync()
    {
        if (_loanScheduleChangePreview is null || _loanScheduleChangeOperation == LoanScheduleChangeOperation.None)
        {
            return;
        }

        if (_loanScheduleChangePreviewBusy)
        {
            return;
        }

        _loanScheduleChangePreviewBusy = true;
        try
        {
            var confirmed = false;
            switch (_loanScheduleChangeOperation)
            {
                case LoanScheduleChangeOperation.Wibor:
                    confirmed = await ConfirmAddRateEntryAsync(_loanScheduleChangePreview.SourceVersion);
                    break;
                case LoanScheduleChangeOperation.Prepayment:
                    confirmed = await ConfirmPrepaymentAsync(_loanScheduleChangePreview.SourceVersion);
                    break;
                case LoanScheduleChangeOperation.InstallmentAmountChange:
                    confirmed = await ConfirmInstallmentAmountChangeAsync(_loanScheduleChangePreview.SourceVersion);
                    break;
            }

            if (confirmed)
            {
                await CloseLoanSchedulePreviewAsync();
            }
        }
        catch (ConflictException ex)
        {
            await HandleLoanSchedulePreviewConflictAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loanScheduleChangePreviewBusy = false;
        }
    }

    private async Task<bool> ConfirmAddRateEntryAsync(string sourceVersion)
    {
        if (!TryBuildAddRateEntryRequest(out var request))
        {
            return false;
        }

        request.ExpectedScheduleVersion = sourceVersion;
        await LoanService.AddLoanRateEntryAsync(request, CancellationToken.None);
        _newReferenceRateInput = string.Empty;
        await LoadAsync();
        Snackbar.Add("Zaktualizowano WIBOR i przeliczono przyszłe raty.", Severity.Success);
        return true;
    }

    private async Task<bool> ConfirmPrepaymentAsync(string sourceVersion)
    {
        if (!TryBuildPrepaymentRequest(out var request))
        {
            return false;
        }

        request.ExpectedScheduleVersion = sourceVersion;
        request.LoanId = _loanScheduleChangePreview?.LoanId;
        await LoanService.ApplyLoanPrepaymentAsync(request, CancellationToken.None);
        _prepaymentAmountInput = string.Empty;
        _prepaymentInstallment = null;
        await LoadAsync();
        Snackbar.Add("Nadpłata zapisana, harmonogram przeliczony.", Severity.Success);
        return true;
    }

    private async Task<bool> ConfirmInstallmentAmountChangeAsync(string sourceVersion)
    {
        if (!TryBuildInstallmentAmountChangeRequest(out var request))
        {
            return false;
        }

        request.ExpectedScheduleVersion = sourceVersion;
        request.LoanId = _loanScheduleChangePreview?.LoanId;
        await LoanService.ApplyLoanInstallmentAmountChangeAsync(request, CancellationToken.None);
        _bankInstallmentAmountInput = string.Empty;
        _bankLastInstallmentDate = null;
        _installmentAmountChangeInstallment = null;
        await LoadAsync();
        Snackbar.Add("Zastosowano ratę z banku i przeliczono harmonogram.", Severity.Success);
        return true;
    }

    private async Task BackToEditLoanScheduleChangeAsync()
    {
        _loanScheduleChangePreviewOpen = false;
        _loanScheduleChangePreview = null;

        switch (_loanScheduleChangeOperation)
        {
            case LoanScheduleChangeOperation.Prepayment:
                _prepaymentDialogOpen = true;
                break;
            case LoanScheduleChangeOperation.InstallmentAmountChange:
