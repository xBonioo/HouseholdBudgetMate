    private async Task HandleLoanSchedulePreviewConflictAsync(string message)
    {
        _loanScheduleChangePreviewOpen = false;
        _loanScheduleChangePreview = null;
        Snackbar.Add(message, Severity.Warning);

        switch (_loanScheduleChangeOperation)
        {
            case LoanScheduleChangeOperation.Prepayment:
                _prepaymentDialogOpen = true;
                break;
            case LoanScheduleChangeOperation.InstallmentAmountChange:
                _installmentAmountChangeDialogOpen = true;
                break;
        }

        await Task.CompletedTask;
    }

    private string GetInterestLabel(LoanDto loan)
    {
        if (loan.LoanType == LoanType.Cash)
        {
            return $"{loan.InterestRate.ToString("0.##", _culture)}% stale";
        }

        var total = (loan.MarginRate ?? 0) + (loan.CurrentReferenceRate ?? 0);
        return loan.InterestMode == LoanInterestMode.Fixed
            ? $"5 lat stale {loan.InterestRate.ToString("0.##", _culture)}%, potem {loan.WiborPeriodType} + marża ({total.ToString("0.##", _culture)}%)"
            : $"{loan.WiborPeriodType} + marża = {total.ToString("0.##", _culture)}%";
    }

    private int GetPaidInstallmentsCount(LoanDto loan) => loan.Installments.Count(x => x.IsPaid);

    private string GetNextInstallmentLabel(LoanDto loan)
    {
        var next = loan.Installments
            .Where(x => !x.IsPaid)
            .OrderBy(x => x.Year)
            .ThenBy(x => x.Month)
            .FirstOrDefault();

        if (next is null)
        {
            return "Brak";
        }

        return $"{next.Month:D2}/{next.Year} - {next.Amount.ToString("0.00", _culture)} PLN";
    }

