@using System.Globalization
@using HouseholdBudgetMate.Abstractions.Contracts.Loans.Dto
@using HouseholdBudgetMate.Abstractions.Extensions

<MudPaper Class="pa-4 hb-panel">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="loan-summary-header">
        <div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                <MudText Typo="Typo.h5">@Loan.Name</MudText>
                <MudChip T="string" Color="@(Loan.IsActive ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                    @(Loan.IsActive ? "Aktywny" : "Nieaktywny")
                </MudChip>
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">
                    @Loan.LoanType.GetDisplayName()
                </MudChip>
            </MudStack>
            <MudText Typo="Typo.body2" Class="hb-muted">
                @GetInterestLabel(Loan)
            </MudText>
        </div>
    </MudStack>

    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3 hb-kpi-card" Elevation="0">
                <MudText Typo="Typo.caption" Class="hb-muted">Pozostały kapitał</MudText>
                <MudText Typo="Typo.h6">@Loan.RemainingPrincipal.ToString("0.00", Culture) PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3 hb-kpi-card" Elevation="0">
                <MudText Typo="Typo.caption" Class="hb-muted">Następna rata</MudText>
                <MudText Typo="Typo.h6">@NextInstallmentLabel</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3 hb-kpi-card" Elevation="0">
                <MudText Typo="Typo.caption" Class="hb-muted">Raty</MudText>
                <MudText Typo="Typo.h6">@PaidInstallmentsCount / @Loan.Installments.Count</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">zapłacone / wszystkie</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3 hb-kpi-card" Elevation="0">
                <MudText Typo="Typo.caption" Class="hb-muted">Koniec kredytu</MudText>
                <MudText Typo="Typo.h6">@Loan.EndDate.ToString("yyyy-MM-dd")</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">spłata końcowa</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter, EditorRequired] public LoanDto Loan { get; set; } = default!;
    [Parameter, EditorRequired] public CultureInfo Culture { get; set; } = CultureInfo.InvariantCulture;
    [Parameter, EditorRequired] public Func<LoanDto, string> GetInterestLabel { get; set; } = default!;
    [Parameter, EditorRequired] public string NextInstallmentLabel { get; set; } = string.Empty;
    [Parameter] public int PaidInstallmentsCount { get; set; }
    [Parameter] public EventCallback OnShowSchedule { get; set; }
    [Parameter] public EventCallback OnEditLoan { get; set; }
}
