@page "/month/{Year:int}/{Month:int}"
@using System.Globalization
@using HouseholdBudgetMate.Abstractions.Contracts.Categories.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Requests
@using HouseholdBudgetMate.Abstractions.Interfaces
@using MudBlazor

@inject IExpenseService ExpenseService
@inject ICategoryService CategoryService
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<MudOverlay Visible="@_isLoading" Absolute="true" DarkBackground="true">
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
</MudOverlay>

<MudStack Spacing="3" Class="pa-4">
    <MudPaper Class="hb-page-header">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
            <MudText Typo="Typo.h4">
                Wydatki @(new DateTime(Year, Month, 1).ToString("MMMM", _culture) + " " + Year)
            </MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" OnClick="NavigateToPreviousMonth" aria-label="Poprzedni miesiąc" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="NavigateToCurrentMonth">Bieżący</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" OnClick="NavigateToNextMonth" aria-label="Następny miesiąc" />
            </MudStack>
        </MudStack>
        <MudText Typo="Typo.body2" Class="hb-muted">Dodawaj, edytuj i monitoruj status planu miesiecznego.</MudText>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Planowane</MudText>
                <MudText Class="hb-kpi-value">@_plannedTotal.ToString("0.00") PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Wydane</MudText>
                <MudText Class="hb-kpi-value">@_actualTotal.ToString("0.00") PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Pozostalo</MudText>
                <MudText Class="hb-kpi-value">@_remainingTotal.ToString("0.00") PLN</MudText>
                <MudProgressLinear Class="mt-2" Rounded="true" Value="@_usagePercent" Color="@(_usagePercent >= 100 ? Color.Error : Color.Primary)" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Nowy wydatek</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_newExpense.Name" Label="Nazwa" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="int" Value="_newExpense.CategoryId" ValueChanged="OnCreateCategoryChanged" Label="Kategoria" Variant="Variant.Outlined">
                    @foreach (var category in _categories)
                    {
                        <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="int?" @bind-Value="_newExpense.TagId" Label="Tag" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var tag in GetTagsForCategory(_newExpense.CategoryId))
                    {
                        <MudSelectItem Value="@((int?)tag.Id)">@tag.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="decimal" @bind-Value="_newExpense.PlannedAmount" Label="Planowana" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="decimal" @bind-Value="_newExpense.ActualAmount" Label="Realna" Variant="Variant.Outlined" Disabled="@IsCategorySupportsLineItems(_newExpense.CategoryId)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSwitch @bind-Value="_newExpense.ShowRemainingInUI" Color="Color.Primary" Label="Pokaż pozostało" />
            </MudItem>
            <MudItem xs="12" md="9" Class="d-flex justify-end align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateExpenseAsync">Dodaj wydatek</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Lista wydatków</MudText>

        @if (_monthPlan is null || _monthPlan.Expenses.Count == 0)
        {
            <MudText Typo="Typo.body2">Brak wydatków w tym miesiącu.</MudText>
        }
        else
        {
            <MudTable Items="_monthPlan.Expenses" Dense="true" Hover="true" RowClassFunc="GetRowClass">
                <HeaderContent>
                    <MudTh>Nazwa</MudTh>
                    <MudTh>Kategoria</MudTh>
                    <MudTh>Tag</MudTh>
                    <MudTh>Planowana</MudTh>
                    <MudTh>Realna</MudTh>
                    <MudTh>Pozostało</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Akcje</MudTh>
                </HeaderContent>
                <RowTemplate Context="expense">
                    @if (_editExpense?.Id == expense.Id)
                    {
                        <MudTd><MudTextField @bind-Value="_editExpense.Name" Variant="Variant.Outlined" /></MudTd>
                        <MudTd>
                            <MudSelect T="int" Value="_editExpense.CategoryId" ValueChanged="OnEditCategoryChanged" Variant="Variant.Outlined">
                                @foreach (var category in _categories)
                                {
                                    <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudSelect T="int?" @bind-Value="_editExpense.TagId" Variant="Variant.Outlined" Clearable="true">
                                @foreach (var tag in GetTagsForCategory(_editExpense.CategoryId))
                                {
                                    <MudSelectItem Value="@((int?)tag.Id)">@tag.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd><MudNumericField T="decimal" @bind-Value="_editExpense.PlannedAmount" Variant="Variant.Outlined" /></MudTd>
                        <MudTd><MudNumericField T="decimal" @bind-Value="_editExpense.ActualAmount" Variant="Variant.Outlined" Disabled="@HasLineItems(_editExpense.Id)" /></MudTd>
                        <MudTd>@FormatRemaining(_editExpense.ShowRemainingInUI, _editExpense.PlannedAmount - _editExpense.ActualAmount)</MudTd>
                        <MudTd>
                            <MudSwitch @bind-Value="_editExpense.ShowRemainingInUI" Color="Color.Primary" />
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveEditAsync">Zapisz</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelEdit">Anuluj</MudButton>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd>@expense.Name</MudTd>
                        <MudTd>@expense.CategoryName</MudTd>
                        <MudTd>@(expense.TagName ?? "-")</MudTd>
                        <MudTd>@FormatPlannedAmount(expense.PlannedAmount)</MudTd>
                        <MudTd>@(expense.ActualAmount ?? 0)</MudTd>
                        <MudTd>@FormatRemainingForExpense(expense)</MudTd>
                        <MudTd>
                            <MudChip T="string" Color="@(IsDerivedUnplanned(expense.PlannedAmount) ? Color.Warning : Color.Success)">
                                @(IsDerivedUnplanned(expense.PlannedAmount) ? "Nieplanowany" : "Planowany")
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => StartEdit(expense)">Edytuj</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteExpenseAsync(expense.Id)">Usuń</MudButton>
                            @if (expense.SupportsLineItems)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" OnClick="() => ToggleLineItems(expense.Id)">
                                    @(IsLineItemsExpanded(expense.Id) ? "▲" : "▼")
                                </MudButton>
                            }
                        </MudTd>
                    }
                </RowTemplate>
                <ChildRowContent Context="expense">
                    @if (expense.SupportsLineItems && IsLineItemsExpanded(expense.Id))
                    {
                        <MudTd colspan="8" Class="pa-3">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">Pozycje wydatku</MudText>

                                @if (expense.LineItems.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="hb-muted">Brak pozycji.</MudText>
                                }
                                else
                                {
                                    <MudTable Items="expense.LineItems" Dense="true" Hover="true">
                                        <HeaderContent>
                                            <MudTh>Opis</MudTh>
                                            <MudTh>Kwota</MudTh>
                                            <MudTh>Data</MudTh>
                                            <MudTh>Tag</MudTh>
                                            <MudTh>Akcje</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="lineItem">
                                            @if (_editLineItem is not null && _editLineItem.Id == lineItem.Id)
                                            {
                                                <MudTd><MudTextField @bind-Value="_editLineItem.Description" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                                                <MudTd><MudNumericField T="decimal" @bind-Value="_editLineItem.Amount" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                                                <MudTd><MudDatePicker Date="@ToDateTime(_editLineItemDate)" DateChanged="OnEditLineItemDateChanged" Margin="Margin.Dense" /></MudTd>
                                                <MudTd>
                                                    <MudSelect T="int?" @bind-Value="_editLineItem.TagId" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense">
                                                        @foreach (var tag in GetTagsForCategory(GetExpenseById(_editLineItemExpenseId ?? 0)?.CategoryId ?? 0))
                                                        {
                                                            <MudSelectItem Value="@((int?)tag.Id)">@tag.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudTd>
                                                <MudTd>
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveLineItemEditAsync">Zapisz</MudButton>
                                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelLineItemEdit">Anuluj</MudButton>
                                                </MudTd>
                                            }
                                            else
                                            {
                                                <MudTd>@lineItem.Description</MudTd>
                                                <MudTd>@lineItem.Amount.ToString("0.##")</MudTd>
                                                <MudTd>@lineItem.OccurredAt.ToString("yyyy-MM-dd")</MudTd>
                                                <MudTd>@(lineItem.TagName ?? "-")</MudTd>
                                                <MudTd>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => BeginLineItemEdit(lineItem, GetParentExpenseIdForLineItem(lineItem.Id))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteLineItemAsync(lineItem.Id)" />
                                                </MudTd>
                                            }
                                        </RowTemplate>
                                    </MudTable>
                                }

                                <MudDivider />

                                <MudGrid>
                                    <MudItem xs="12" md="4">
                                        <MudTextField @bind-Value="GetLineItemCreateModel(expense.Id).Description" Label="Opis pozycji" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudNumericField T="decimal" Value="GetLineItemCreateModel(expense.Id).Amount" ValueChanged="(v) => OnCreateLineItemAmountChanged(expense.Id, v)" Label="Kwota" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudDatePicker Date="@ToDateTime(GetLineItemCreateModel(expense.Id).OccurredAt)" DateChanged="(d) => OnCreateLineItemDateChanged(expense.Id, d)" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudSelect T="int?" Value="GetLineItemCreateModel(expense.Id).TagId" ValueChanged="(v) => OnCreateLineItemTagChanged(expense.Id, v)" Label="Tag" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense">
                                            @foreach (var tag in GetTagsForCategory(GetExpenseById(expense.Id)?.CategoryId ?? 0))
                                            {
                                                <MudSelectItem Value="@((int?)tag.Id)">@tag.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="2" Class="d-flex align-center">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => CreateLineItemAsync(expense.Id)">Dodaj pozycję</MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudStack>
                        </MudTd>
                    }
                </ChildRowContent>
            </MudTable>
        }
    </MudPaper>
</MudStack>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }

    private bool _isLoading;
    private MonthPlanDto? _monthPlan;
    private List<CategoryDto> _categories = [];
    private decimal _plannedTotal;
    private decimal _actualTotal;
    private decimal _remainingTotal;
    private double _usagePercent;
    
    private readonly CultureInfo _culture = new("pl-PL");

    private readonly CreateExpenseRequest _newExpense = new()
    {
        ShowRemainingInUI = true
    };

    private UpdateExpenseRequest? _editExpense;
    private readonly HashSet<int> _expandedExpenseIds = [];
    private readonly Dictionary<int, LineItemCreateModel> _lineItemCreateModels = new();
    private UpdateExpenseLineItemRequest? _editLineItem;
    private DateOnly _editLineItemDate = DateOnly.FromDateTime(DateTime.Today);
    private int? _editLineItemExpenseId;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _categories = (await CategoryService.GetAllAsync(CancellationToken.None)).ToList();
            _monthPlan = await ExpenseService.GetMonthAsync(Year, Month, CancellationToken.None);
            _expandedExpenseIds.RemoveWhere(id => _monthPlan.Expenses.All(x => x.Id != id));

            CalculateSummary();

            if (_newExpense.CategoryId == 0 && _categories.Count > 0)
            {
                _newExpense.CategoryId = _categories[0].Id;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IReadOnlyList<TagDto> GetTagsForCategory(int categoryId)
    {
        return _categories.FirstOrDefault(x => x.Id == categoryId)?.Tags ?? [];
    }

    private Task OnCreateCategoryChanged(int categoryId)
    {
        _newExpense.CategoryId = categoryId;
        _newExpense.TagId = null;
        if (IsCategorySupportsLineItems(categoryId))
        {
            _newExpense.ActualAmount = 0;
        }
        return Task.CompletedTask;
    }

    private Task OnEditCategoryChanged(int categoryId)
    {
        if (_editExpense is null)
        {
            return Task.CompletedTask;
        }

        _editExpense.CategoryId = categoryId;
        _editExpense.TagId = null;
        return Task.CompletedTask;
    }

    private void CalculateSummary()
    {
        if (_monthPlan is null)
        {
            _plannedTotal = 0;
            _actualTotal = 0;
            _remainingTotal = 0;
            _usagePercent = 0;
            return;
        }

        var plannedExpenses = _monthPlan.Expenses
            .Where(x => !IsDerivedUnplanned(x.PlannedAmount) && !x.IsUnplanned)
            .ToList();
        var visibleRemainingExpenses = plannedExpenses
            .Where(x => x.ShowRemainingInUI)
            .ToList();

        _plannedTotal = plannedExpenses.Sum(x => x.PlannedAmount ?? 0);
        _actualTotal = _monthPlan.Expenses.Sum(x => x.ActualAmount ?? 0);
        var actualForPlanned = plannedExpenses.Sum(x => x.ActualAmount ?? 0);
        _remainingTotal = visibleRemainingExpenses.Sum(x => Math.Max(0, (x.PlannedAmount ?? 0) - (x.ActualAmount ?? 0)));
        _usagePercent = _plannedTotal <= 0 ? 0 : Math.Min(150, (double)(actualForPlanned / _plannedTotal * 100));
    }

    private string GetRowClass(ExpenseDto expense, int _)
    {
        if (IsDerivedUnplanned(expense.PlannedAmount))
        {
            return "hb-warning-row";
        }

        if ((expense.ActualAmount ?? 0) > (expense.PlannedAmount ?? 0))
        {
            return "hb-danger-row";
        }

        return string.Empty;
    }

    private static string FormatRemaining(bool showRemaining, decimal remaining)
    {
        return showRemaining ? Math.Max(0, remaining).ToString("0.##") : "-";
    }

    private static string FormatPlannedAmount(decimal? plannedAmount)
    {
        return IsDerivedUnplanned(plannedAmount) ? "-" : (plannedAmount ?? 0).ToString("0.##");
    }

    private static string FormatRemainingForExpense(ExpenseDto expense)
    {
        if (expense.IsUnplanned || IsDerivedUnplanned(expense.PlannedAmount))
        {
            return "-";
        }

        return FormatRemaining(expense.ShowRemainingInUI, expense.RemainingAmount);
    }

    private static bool IsDerivedUnplanned(decimal? plannedAmount)
    {
        return !plannedAmount.HasValue || plannedAmount <= 0;
    }

    private async Task CreateExpenseAsync()
    {
        try
        {
            _newExpense.Year = Year;
            _newExpense.Month = Month;
            _newExpense.IsUnplanned = IsDerivedUnplanned(_newExpense.PlannedAmount);

            await ExpenseService.CreateExpenseAsync(_newExpense, CancellationToken.None);

            _newExpense.Name = string.Empty;
            _newExpense.TagId = null;
            _newExpense.PlannedAmount = 0;
            _newExpense.ActualAmount = 0;
            _newExpense.IsUnplanned = true;
            _newExpense.ShowRemainingInUI = true;

            await LoadAsync();
            Snackbar.Add("Dodano wydatek.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void StartEdit(ExpenseDto expense)
    {
        _editExpense = new UpdateExpenseRequest
        {
            Id = expense.Id,
            Name = expense.Name,
            CategoryId = expense.CategoryId,
            TagId = expense.TagId,
            PlannedAmount = expense.PlannedAmount ?? 0,
            ActualAmount = expense.ActualAmount ?? 0,
            ShowRemainingInUI = expense.ShowRemainingInUI,
            IsUnplanned = expense.IsUnplanned
        };

        if (expense.HasLineItems)
        {
            _editExpense.ActualAmount = expense.LineItems.Sum(x => x.Amount);
        }
    }

    private void CancelEdit()
    {
        _editExpense = null;
    }

    private async Task SaveEditAsync()
    {
        if (_editExpense is null)
        {
            return;
        }

        try
        {
            _editExpense.IsUnplanned = IsDerivedUnplanned(_editExpense.PlannedAmount);
            await ExpenseService.UpdateExpenseAsync(_editExpense, CancellationToken.None);
            _editExpense = null;
            await LoadAsync();
            Snackbar.Add("Zapisano wydatek.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteExpenseAsync(int expenseId)
    {
        var confirmation = await JsRuntime.InvokeAsync<bool>("confirm", "Usunac wydatek? (soft delete)");
        if (!confirmation)
        {
            return;
        }

        try
        {
            await ExpenseService.DeleteExpenseAsync(new DeleteExpenseRequest { Id = expenseId }, CancellationToken.None);
            await LoadAsync();
            Snackbar.Add("Usunięto wydatek.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void NavigateToPreviousMonth()
    {
        var targetMonth = new DateTime(Year, Month, 1).AddMonths(-1);
        _editExpense = null;
        NavigationManager.NavigateTo($"/month/{targetMonth.Year}/{targetMonth.Month}");
    }

    private void NavigateToCurrentMonth()
    {
        var currentMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        _editExpense = null;
        NavigationManager.NavigateTo($"/month/{currentMonth.Year}/{currentMonth.Month}");
    }

    private void NavigateToNextMonth()
    {
        var targetMonth = new DateTime(Year, Month, 1).AddMonths(1);
        _editExpense = null;
        NavigationManager.NavigateTo($"/month/{targetMonth.Year}/{targetMonth.Month}");
    }

    private bool IsCategorySupportsLineItems(int categoryId)
    {
        return _categories.FirstOrDefault(x => x.Id == categoryId)?.SupportsLineItems == true;
    }

    private bool HasLineItems(int expenseId)
    {
        return GetExpenseById(expenseId)?.HasLineItems == true;
    }

    private ExpenseDto? GetExpenseById(int expenseId)
    {
        return _monthPlan?.Expenses.FirstOrDefault(x => x.Id == expenseId);
    }

    private int GetParentExpenseIdForLineItem(int lineItemId)
    {
        return _monthPlan?.Expenses.FirstOrDefault(x => x.LineItems.Any(li => li.Id == lineItemId))?.Id ?? 0;
    }

    private void ToggleLineItems(int expenseId)
    {
        if (!_expandedExpenseIds.Add(expenseId))
        {
            _expandedExpenseIds.Remove(expenseId);
            if (_editLineItemExpenseId == expenseId)
            {
                CancelLineItemEdit();
            }
        }
    }

    private bool IsLineItemsExpanded(int expenseId)
    {
        return _expandedExpenseIds.Contains(expenseId);
    }

    private LineItemCreateModel GetLineItemCreateModel(int expenseId)
    {
        if (_lineItemCreateModels.TryGetValue(expenseId, out var model))
        {
            return model;
        }

        model = new LineItemCreateModel();
        _lineItemCreateModels[expenseId] = model;
        return model;
    }

    private void OnCreateLineItemAmountChanged(int expenseId, decimal value)
    {
        GetLineItemCreateModel(expenseId).Amount = value;
    }

    private void OnCreateLineItemDateChanged(int expenseId, DateTime? date)
    {
        if (date.HasValue)
        {
            GetLineItemCreateModel(expenseId).OccurredAt = DateOnly.FromDateTime(date.Value);
        }
    }

    private void OnCreateLineItemTagChanged(int expenseId, int? tagId)
    {
        GetLineItemCreateModel(expenseId).TagId = tagId;
    }

    private async Task CreateLineItemAsync(int expenseId)
    {
        var model = GetLineItemCreateModel(expenseId);
        if (string.IsNullOrWhiteSpace(model.Description))
        {
            Snackbar.Add("Podaj opis pozycji.", Severity.Warning);
            return;
        }

        try
        {
            await ExpenseService.CreateExpenseLineItemAsync(new CreateExpenseLineItemRequest
            {
                ExpenseId = expenseId,
                Description = model.Description,
                Amount = model.Amount,
                OccurredAt = model.OccurredAt,
                TagId = model.TagId
            }, CancellationToken.None);

            _lineItemCreateModels[expenseId] = new LineItemCreateModel();
            await LoadAsync();
            _expandedExpenseIds.Add(expenseId);
            Snackbar.Add("Dodano pozycję.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void BeginLineItemEdit(ExpenseLineItemDto lineItem, int expenseId)
    {
        _editLineItem = new UpdateExpenseLineItemRequest
        {
            Id = lineItem.Id,
            Description = lineItem.Description,
            Amount = lineItem.Amount,
            OccurredAt = lineItem.OccurredAt,
            TagId = lineItem.TagId
        };
        _editLineItemDate = lineItem.OccurredAt;
        _editLineItemExpenseId = expenseId;
    }

    private Task OnEditLineItemDateChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            _editLineItemDate = DateOnly.FromDateTime(date.Value);
        }
        return Task.CompletedTask;
    }

    private async Task SaveLineItemEditAsync()
    {
        if (_editLineItem is null)
        {
            return;
        }

        try
        {
            _editLineItem.OccurredAt = _editLineItemDate;
            await ExpenseService.UpdateExpenseLineItemAsync(_editLineItem, CancellationToken.None);

            var expandedExpenseId = _editLineItemExpenseId;
            CancelLineItemEdit();
            await LoadAsync();
            if (expandedExpenseId.HasValue)
            {
                _expandedExpenseIds.Add(expandedExpenseId.Value);
            }

            Snackbar.Add("Zapisano pozycję.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelLineItemEdit()
    {
        _editLineItem = null;
        _editLineItemDate = DateOnly.FromDateTime(DateTime.Today);
        _editLineItemExpenseId = null;
    }

    private async Task DeleteLineItemAsync(int lineItemId)
    {
        var expenseId = GetParentExpenseIdForLineItem(lineItemId);
        try
        {
            await ExpenseService.DeleteExpenseLineItemAsync(new DeleteExpenseLineItemRequest { Id = lineItemId }, CancellationToken.None);
            await LoadAsync();
            if (expenseId > 0)
            {
                _expandedExpenseIds.Add(expenseId);
            }
            Snackbar.Add("Usunięto pozycję.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private sealed class LineItemCreateModel
    {
        public string Description { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public DateOnly OccurredAt { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public int? TagId { get; set; }
    }

    private static DateTime ToDateTime(DateOnly value)
    {
        return value.ToDateTime(TimeOnly.MinValue);
    }
}
