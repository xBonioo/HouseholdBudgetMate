    private bool IsCategorySupportsLineItems(int categoryId)
    {
        return _categories.FirstOrDefault(x => x.Id == categoryId)?.SupportsLineItems == true;
    }

    private bool HasLineItems(int expenseId)
    {
        return GetExpenseById(expenseId)?.HasLineItems == true;
    }

    private ExpenseDto? GetExpenseById(int expenseId)
    {
        return _monthPlan?.Expenses.FirstOrDefault(x => x.Id == expenseId);
    }

    private int GetParentExpenseIdForLineItem(int lineItemId)
    {
        return _monthPlan?.Expenses.FirstOrDefault(x => x.LineItems.Any(li => li.Id == lineItemId))?.Id ?? 0;
    }

    private void ToggleLineItems(int expenseId)
    {
        if (!_expandedExpenseIds.Add(expenseId))
        {
            _expandedExpenseIds.Remove(expenseId);
            if (_editLineItemExpenseId == expenseId)
            {
                CancelLineItemEdit();
            }
        }
    }

    private bool IsLineItemsExpanded(int expenseId)
    {
        return _expandedExpenseIds.Contains(expenseId);
    }

    private LineItemCreateModel GetLineItemCreateModel(int expenseId)
    {
        if (_lineItemCreateModels.TryGetValue(expenseId, out var model))
        {
            return model;
        }

        model = new LineItemCreateModel();
        _lineItemCreateModels[expenseId] = model;
        return model;
    }

    private void OnCreateLineItemAmountChanged(int expenseId, decimal value)
    {
        GetLineItemCreateModel(expenseId).Amount = value;
    }

    private void OnCreateLineItemDateChanged(int expenseId, DateTime? date)
    {
        if (date.HasValue)
        {
            GetLineItemCreateModel(expenseId).OccurredAt = DateOnly.FromDateTime(date.Value);
        }
    }

    private void OnCreateLineItemTagChanged(int expenseId, int? tagId)
    {
        GetLineItemCreateModel(expenseId).TagId = tagId;
    }

    private async Task CreateLineItemAsync(int expenseId)
    {
        var model = GetLineItemCreateModel(expenseId);
        if (string.IsNullOrWhiteSpace(model.Description))
        {
            Snackbar.Add("Podaj opis pozycji.", Severity.Warning);
            return;
        }

        try
        {
            await ExpenseService.CreateExpenseLineItemAsync(new CreateExpenseLineItemRequest
            {
                ExpenseId = expenseId,
                Description = model.Description,
                Amount = model.Amount,
                OccurredAt = model.OccurredAt,
                TagId = model.TagId
            }, CancellationToken.None);

            _lineItemCreateModels[expenseId] = new LineItemCreateModel();
            await LoadAsync();
            _expandedExpenseIds.Add(expenseId);
            Snackbar.Add("Dodano pozycję.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void BeginLineItemEdit(ExpenseLineItemDto lineItem, int expenseId)
    {
        _editLineItem = new UpdateExpenseLineItemRequest
        {
            Id = lineItem.Id,
            Description = lineItem.Description,
            Amount = lineItem.Amount,
            OccurredAt = lineItem.OccurredAt,
            TagId = lineItem.TagId
        };
        _editLineItemDate = lineItem.OccurredAt;
        _editLineItemExpenseId = expenseId;
    }

    private Task OnEditLineItemDateChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            _editLineItemDate = DateOnly.FromDateTime(date.Value);
        }
        return Task.CompletedTask;
    }

    private async Task SaveLineItemEditAsync()
    {
        if (_editLineItem is null)
        {
            return;
        }

        try
        {
            _editLineItem.OccurredAt = _editLineItemDate;
            await ExpenseService.UpdateExpenseLineItemAsync(_editLineItem, CancellationToken.None);

            var expandedExpenseId = _editLineItemExpenseId;
            CancelLineItemEdit();
            await LoadAsync();
            if (expandedExpenseId.HasValue)
            {
                _expandedExpenseIds.Add(expandedExpenseId.Value);
            }

            Snackbar.Add("Zapisano pozycję.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelLineItemEdit()
    {
        _editLineItem = null;
        _editLineItemDate = DateOnly.FromDateTime(DateTime.Today);
        _editLineItemExpenseId = null;
    }

    private async Task DeleteLineItemAsync(int lineItemId)
    {
        var expenseId = GetParentExpenseIdForLineItem(lineItemId);
        try
        {
            await ExpenseService.DeleteExpenseLineItemAsync(new DeleteExpenseLineItemRequest { Id = lineItemId }, CancellationToken.None);
            await LoadAsync();
            if (expenseId > 0)
            {
                _expandedExpenseIds.Add(expenseId);
            }
            Snackbar.Add("Usunięto pozycję.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private sealed class LineItemCreateModel
    {
        public string Description { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public DateOnly OccurredAt { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public int? TagId { get; set; }
    }

    private static DateTime ToDateTime(DateOnly value)
    {
        return value.ToDateTime(TimeOnly.MinValue);
    }


    private DateOnly EnsureDateInCurrentMonth(DateOnly value)
    {
        var day = Math.Min(value.Day, DateTime.DaysInMonth(Year, Month));
        return new DateOnly(Year, Month, day);
    }
}
