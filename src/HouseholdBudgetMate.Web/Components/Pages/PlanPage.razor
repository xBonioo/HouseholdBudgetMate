@page "/plan/{Year:int}/{Month:int}"
@using System.Globalization
@using HouseholdBudgetMate.Abstractions.Contracts.Categories.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Accounts.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Requests
@using HouseholdBudgetMate.Abstractions.Contracts.Incomes.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Incomes.Requests
@using HouseholdBudgetMate.Abstractions.Interfaces
@using MudBlazor

@inject IExpenseService ExpenseService
@inject ICategoryService CategoryService
@inject IIncomeService IncomeService
@inject IAccountService AccountService
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<MudOverlay Visible="@_isLoading" Absolute="true" DarkBackground="true">
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
</MudOverlay>

<MudStack Spacing="3" Class="pa-4">
    <MudPaper Class="hb-page-header">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
            <MudText Typo="Typo.h4">
                Wydatki @(new DateTime(Year, Month, 1).ToString("MMMM", _culture) + " " + Year)
            </MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" OnClick="NavigateToPreviousMonth" aria-label="Poprzedni miesiąc" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="NavigateToCurrentMonth">Bieżący</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" OnClick="NavigateToNextMonth" aria-label="Następny miesiąc" />
            </MudStack>
        </MudStack>
        <MudText Typo="Typo.body2" Class="hb-muted">Dodawaj, edytuj i monitoruj status planu miesiecznego.</MudText>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Planowane</MudText>
                <MudText Class="hb-kpi-value">@_plannedTotal.ToString("0.00") PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Wydane</MudText>
                <MudText Class="hb-kpi-value">@_actualTotal.ToString("0.00") PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Pozostalo</MudText>
                <MudText Class="hb-kpi-value">@_remainingTotal.ToString("0.00") PLN</MudText>
                <MudProgressLinear Class="mt-2" Rounded="true" Value="@_remainingPercent" Color="@GetRemainingBarColor()" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Live balance</MudText>
                <MudText Class="hb-kpi-value">@_liveBalance.CurrentBalance.ToString("0.00", _culture) PLN</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">Konta + wpływy - wydatki - oszczednosci</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Konta (bez oszczędności)</MudText>
                <MudText Class="hb-kpi-value">@_liveBalance.AccountsBaseTotal.ToString("0.00", _culture) PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Wpływy miesiąca</MudText>
                <MudText Class="hb-kpi-value">@_liveBalance.IncomesTotal.ToString("0.00", _culture) PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Realne wydatki miesiąca</MudText>
                <MudText Class="hb-kpi-value">@_liveBalance.ExpensesTotal.ToString("0.00", _culture) PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Przelew na oszczednosci</MudText>
                <MudText Class="hb-kpi-value">@_liveBalance.SavingsTransfersTotal.ToString("0.00", _culture) PLN</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Oszczędności w tym miesiącu</MudText>
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudNumericField T="decimal" @bind-Value="_newSavingsTransfer.Amount" Label="Kwota do odlozenia" Variant="Variant.Outlined" Culture="_culture" Format="0.00" Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudDatePicker Date="@ToDateTime(_newSavingsTransfer.TransferDate)" DateChanged="OnCreateSavingsTransferDateChanged" Label="Data przelewu" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSavingsTransferAsync">Dodaj</MudButton>
            </MudItem>
        </MudGrid>

        @if (_monthPlan?.SavingsTransfers.Count > 0)
        {
            <MudTable Items="_monthPlan.SavingsTransfers" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>Kwota</MudTh>
                    <MudTh>Data przelewu</MudTh>
                    <MudTh>Akcje</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @if (_editSavingsTransfer?.Id == item.Id)
                    {
                        <MudTd>
                            <MudNumericField T="decimal" @bind-Value="_editSavingsTransfer.Amount" Variant="Variant.Outlined" Culture="_culture" Format="0.00" Immediate="true" />
                        </MudTd>
                        <MudTd>
                            <MudDatePicker Date="@ToDateTime(_editSavingsTransferDate)" DateChanged="OnEditSavingsTransferDateChanged" Variant="Variant.Outlined" />
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveSavingsTransferEditAsync">Zapisz</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelSavingsTransferEdit">Anuluj</MudButton>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd>@item.Amount.ToString("0.00", _culture) PLN</MudTd>
                        <MudTd>@item.TransferDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => StartSavingsTransferEdit(item)">Edytuj</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteSavingsTransferAsync(item.Id)">Usun</MudButton>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudPaper Class="pa-4 hb-panel">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">Wpływy miesiąca</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Repeat" OnClick="NavigateToRegularIncomes">
                Zarzadzaj regularnymi
            </MudButton>
        </MudStack>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_newIncome.Name" Label="Nazwa wpływu" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="int" @bind-Value="_newIncome.AccountId" Label="Konto" Variant="Variant.Outlined">
                    @foreach (var account in GetIncomeAccounts())
                    {
                        <MudSelectItem Value="@account.Id">@account.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="decimal" @bind-Value="_newIncome.Amount"
                                 Label="Kwota"
                                 Variant="Variant.Outlined"
                                 Culture="_culture"
                                 Format="0.00"
                                 Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudDatePicker Date="@ToDateTime(_newIncome.ExpectedDayOfMonth)"
                               DateChanged="OnCreateIncomeDateChanged"
                               Label="Oczekiwany dzień"
                               Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="1" Class="d-flex align-center justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateIncomeAsync">Dodaj</MudButton>
            </MudItem>
        </MudGrid>

        @if (_incomes.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mt-3 hb-muted">Brak wpływów w tym miesiącu.</MudText>
        }
        else
        {
            <MudTable Items="_incomes" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>Nazwa</MudTh>
                    <MudTh>Konto</MudTh>
                    <MudTh>Typ</MudTh>
                    <MudTh>Kwota</MudTh>
                    <MudTh>Planowana data</MudTh>
                    <MudTh>Akcje</MudTh>
                </HeaderContent>
                <RowTemplate Context="income">
                    @if (!income.IsRegular && _editIncome?.Id == income.Id)
                    {
                        <MudTd><MudTextField @bind-Value="_editIncome.Name" Variant="Variant.Outlined" /></MudTd>
                        <MudTd>
                            <MudSelect T="int" @bind-Value="_editIncome.AccountId" Variant="Variant.Outlined">
                                @foreach (var account in GetIncomeAccounts())
                                {
                                    <MudSelectItem Value="@account.Id">@account.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd><MudChip T="string" Color="Color.Info">Nieregularny</MudChip></MudTd>
                        <MudTd>
                            <MudNumericField T="decimal" @bind-Value="_editIncome.Amount"
                                             Variant="Variant.Outlined"
                                             Culture="_culture"
                                             Format="0.00"
                                             Immediate="true" />
                        </MudTd>
                        <MudTd>
                            <MudDatePicker Date="@ToDateTime(_editIncomeDate)" DateChanged="OnEditIncomeDateChanged" Variant="Variant.Outlined" />
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveIncomeEditAsync">Zapisz</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelIncomeEdit">Anuluj</MudButton>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd>@income.Name</MudTd>
                        <MudTd>@income.AccountName</MudTd>
                        <MudTd>
                            <MudChip T="string" Color="@(income.IsRegular ? Color.Primary : Color.Info)">@(income.IsRegular ? "Regularny" : "Nieregularny")</MudChip>
                        </MudTd>
                        <MudTd>@income.Amount.ToString("0.00", _culture) PLN</MudTd>
                        <MudTd>@income.ExpectedDayOfMonth.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>
                            @if (income.IsRegular)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="() => PrepareBonusFromIncome(income)">Dodaj bonus</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => StartIncomeEdit(income)">Edytuj</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteIncomeAsync(income.Id)">Usuń</MudButton>
                            }
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudPaper Class="pa-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Nowy wydatek</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_newExpense.Name" Label="Nazwa" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="int" Value="_newExpense.CategoryId" ValueChanged="OnCreateCategoryChanged" Label="Kategoria" Variant="Variant.Outlined">
                    @foreach (var category in _categories)
                    {
                        <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="int?" @bind-Value="_newExpense.TagId" Label="Tag" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var tag in GetTagsForCategory(_newExpense.CategoryId))
                    {
                        <MudSelectItem Value="@((int?)tag.Id)">@tag.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="decimal" @bind-Value="_newExpense.PlannedAmount" Label="Planowana" Variant="Variant.Outlined"
                                 Culture="_culture"
                                 Format="0.00"
                                 Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="decimal" @bind-Value="_newExpense.ActualAmount" Label="Realna" Variant="Variant.Outlined" Disabled="@IsCategorySupportsLineItems(_newExpense.CategoryId)"
                                 Culture="_culture"
                                 Format="0.00"
                                 Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSwitch @bind-Value="_newExpense.ShowRemainingInUI" Color="Color.Primary" Label="Pokaż pozostało" />
            </MudItem>
            <MudItem xs="12" md="9" Class="d-flex justify-end align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateExpenseAsync">Dodaj wydatek</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Lista wydatków</MudText>

        @if (_monthPlan is null || _monthPlan.Expenses.Count == 0)
        {
            <MudText Typo="Typo.body2">Brak wydatków w tym miesiącu.</MudText>
        }
        else
        {
            <MudTable Items="_monthPlan.Expenses" Dense="true" Hover="true" RowClassFunc="GetRowClass">
                <HeaderContent>
                    <MudTh>Nazwa</MudTh>
                    <MudTh>Kategoria</MudTh>
                    <MudTh>Tag</MudTh>
                    <MudTh>Planowana</MudTh>
                    <MudTh>Realna</MudTh>
                    <MudTh>Pozostało</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Akcje</MudTh>
                </HeaderContent>
                <RowTemplate Context="expense">
                    @if (_editExpense?.Id == expense.Id)
                    {
                        <MudTd><MudTextField @bind-Value="_editExpense.Name" Variant="Variant.Outlined" /></MudTd>
                        <MudTd>
                            <MudSelect T="int" Value="_editExpense.CategoryId" ValueChanged="OnEditCategoryChanged" Variant="Variant.Outlined">
                                @foreach (var category in _categories)
                                {
                                    <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudSelect T="int?" @bind-Value="_editExpense.TagId" Variant="Variant.Outlined" Clearable="true">
                                @foreach (var tag in GetTagsForCategory(_editExpense.CategoryId))
                                {
                                    <MudSelectItem Value="@((int?)tag.Id)">@tag.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd><MudNumericField T="decimal" @bind-Value="_editExpense.PlannedAmount" Variant="Variant.Outlined" /></MudTd>
                        <MudTd><MudNumericField T="decimal" @bind-Value="_editExpense.ActualAmount" Variant="Variant.Outlined" Disabled="@HasLineItems(_editExpense.Id)" /></MudTd>
                        <MudTd>@FormatRemaining(_editExpense.ShowRemainingInUI, _editExpense.PlannedAmount - _editExpense.ActualAmount)</MudTd>
                        <MudTd>
                            <MudSwitch @bind-Value="_editExpense.ShowRemainingInUI" Color="Color.Primary" />
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveEditAsync">Zapisz</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelEdit">Anuluj</MudButton>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd>@expense.Name</MudTd>
                        <MudTd>@expense.CategoryName</MudTd>
                        <MudTd>@(expense.TagName ?? "-")</MudTd>
                        <MudTd>@FormatPlannedAmount(expense.PlannedAmount)</MudTd>
                        <MudTd>@(expense.ActualAmount ?? 0)</MudTd>
                        <MudTd>@FormatRemainingForExpense(expense)</MudTd>
                        <MudTd>
                            <MudChip T="string" Color="@(IsDerivedUnplanned(expense.PlannedAmount) ? Color.Warning : Color.Success)">
                                @(IsDerivedUnplanned(expense.PlannedAmount) ? "Nieplanowany" : "Planowany")
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => StartEdit(expense)">Edytuj</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteExpenseAsync(expense.Id)">Usuń</MudButton>
                            @if (expense.SupportsLineItems)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" OnClick="() => ToggleLineItems(expense.Id)">
                                    @(IsLineItemsExpanded(expense.Id) ? "▲" : "▼")
                                </MudButton>
                            }
                        </MudTd>
                    }
                </RowTemplate>
                <ChildRowContent Context="expense">
                    @if (expense.SupportsLineItems && IsLineItemsExpanded(expense.Id))
                    {
                        <MudTd colspan="8" Class="pa-3">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">Podpozycje wydatku</MudText>

                                @if (expense.LineItems.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="hb-muted">Brak pozycji.</MudText>
                                }
                                else
                                {
                                    <MudTable Items="expense.LineItems" Dense="true" Hover="true">
                                        <HeaderContent>
                                            <MudTh>Opis</MudTh>
                                            <MudTh>Kwota</MudTh>
                                            <MudTh>Data</MudTh>
                                            <MudTh>Tag</MudTh>
                                            <MudTh>Akcje</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="lineItem">
                                            @if (_editLineItem is not null && _editLineItem.Id == lineItem.Id)
                                            {
                                                <MudTd><MudTextField @bind-Value="_editLineItem.Description" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                                                <MudTd><MudNumericField T="decimal" @bind-Value="_editLineItem.Amount" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                                                <MudTd><MudDatePicker Date="@ToDateTime(_editLineItemDate)" DateChanged="OnEditLineItemDateChanged" Margin="Margin.Dense" /></MudTd>
                                                <MudTd>
                                                    <MudSelect T="int?" @bind-Value="_editLineItem.TagId" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense">
                                                        @foreach (var tag in GetTagsForCategory(GetExpenseById(_editLineItemExpenseId ?? 0)?.CategoryId ?? 0))
                                                        {
                                                            <MudSelectItem Value="@((int?)tag.Id)">@tag.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudTd>
                                                <MudTd>
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveLineItemEditAsync">Zapisz</MudButton>
                                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelLineItemEdit">Anuluj</MudButton>
                                                </MudTd>
                                            }
                                            else
                                            {
                                                <MudTd>@lineItem.Description</MudTd>
                                                <MudTd>@lineItem.Amount.ToString("0.##")</MudTd>
                                                <MudTd>@lineItem.OccurredAt.ToString("yyyy-MM-dd")</MudTd>
                                                <MudTd>@(lineItem.TagName ?? "-")</MudTd>
                                                <MudTd>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="() => BeginLineItemEdit(lineItem, GetParentExpenseIdForLineItem(lineItem.Id))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteLineItemAsync(lineItem.Id)" />
                                                </MudTd>
                                            }
                                        </RowTemplate>
                                    </MudTable>
                                }

                                <MudDivider />

                                <MudGrid>
                                    <MudItem xs="12" md="4">
                                        <MudTextField @bind-Value="GetLineItemCreateModel(expense.Id).Description" Label="Opis pozycji" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudNumericField T="decimal" Value="GetLineItemCreateModel(expense.Id).Amount" ValueChanged="(v) => OnCreateLineItemAmountChanged(expense.Id, v)" Label="Kwota" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudDatePicker Date="@ToDateTime(GetLineItemCreateModel(expense.Id).OccurredAt)" DateChanged="(d) => OnCreateLineItemDateChanged(expense.Id, d)" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudSelect T="int?" Value="GetLineItemCreateModel(expense.Id).TagId" ValueChanged="(v) => OnCreateLineItemTagChanged(expense.Id, v)" Label="Tag" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense">
                                            @foreach (var tag in GetTagsForCategory(GetExpenseById(expense.Id)?.CategoryId ?? 0))
                                            {
                                                <MudSelectItem Value="@((int?)tag.Id)">@tag.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="2" Class="d-flex align-center">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => CreateLineItemAsync(expense.Id)">Dodaj pozycję</MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudStack>
                        </MudTd>
                    }
                </ChildRowContent>
            </MudTable>
        }
    </MudPaper>
</MudStack>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }

    private bool _isLoading;
    private MonthPlanDto? _monthPlan;
    private List<CategoryDto> _categories = [];
    private List<AccountDto> _accounts = [];
    private List<IncomeDto> _incomes = [];
