@page "/plan/{Year:int}/{Month:int}"
@using System.Globalization
@using HouseholdBudgetMate.Abstractions.Contracts.Categories.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Accounts.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Expenses.Requests
@using HouseholdBudgetMate.Abstractions.Contracts.Incomes.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Incomes.Requests
@using HouseholdBudgetMate.Abstractions.Interfaces
@using MudBlazor

@inject IExpenseService ExpenseService
@inject ICategoryService CategoryService
@inject IIncomeService IncomeService
@inject IAccountService AccountService
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<MudOverlay Visible="@_isLoading" Absolute="true" DarkBackground="true">
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
</MudOverlay>

<MudStack Spacing="3" Class="pa-4">
    <MudPaper Class="hb-page-header">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
            <MudText Typo="Typo.h4">
                Wydatki @(new DateTime(Year, Month, 1).ToString("MMMM", Culture) + " " + Year)
            </MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary"
                               OnClick="() => NavigateToMonth(-1)"
                               aria-label="Poprzedni miesiąc"/>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="() => NavigateToMonth(0, true)">Bieżący
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary"
                               OnClick="() => NavigateToMonth(1)"
                               aria-label="Następny miesiąc"/>
            </MudStack>
        </MudStack>
        <MudText Typo="Typo.body2" Class="hb-muted">Dodawaj, edytuj i monitoruj status planu miesięcznego.</MudText>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Planowane</MudText>
                <MudText Class="hb-kpi-value">@_kpi.PlannedTotal.ToString("0.00") PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Wydane</MudText>
                <MudText Class="hb-kpi-value">@_kpi.SpentTotal.ToString("0.00") PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Pozostało</MudText>
                <MudText Class="hb-kpi-value">@_kpi.RemainingTotal.ToString("0.00") PLN</MudText>
                <MudProgressLinear Class="mt-2" Rounded="true" Value="@_kpi.RemainingPercent"
                                   Color="@GetRemainingBarColor()"/>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Live balance</MudText>
                <MudText Class="hb-kpi-value">@_liveBalance.CurrentBalance.ToString("0.00", Culture) PLN</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">Konta + wpływy - wydatki</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Konta (bez oszczędności)</MudText>
                <MudText Class="hb-kpi-value">@_liveBalance.AccountsBaseTotal.ToString("0.00", Culture) PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Wpływy miesiąca</MudText>
                <MudText Class="hb-kpi-value">@_liveBalance.IncomesTotal.ToString("0.00", Culture) PLN</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="hb-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Przelew na oszczędności</MudText>
                <MudText Class="hb-kpi-value">@_liveBalance.SavingsTransfersTotal.ToString("0.00", Culture) PLN
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Oszczędności w tym miesiącu</MudText>
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudNumericField T="decimal"
                                 @bind-Value="_newSavingsTransfer.Amount"
                                 Label="Kwota do odlodzenia"
                                 Variant="Variant.Outlined"
                                 Culture="Culture"
                                 Immediate="true"/>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudDatePicker
                    Date="@_newSavingsTransfer.TransferDate.ToDateTime(TimeOnly.MinValue)"
                    DateChanged="(date) => UpdateDateIfProvided(date, value => _newSavingsTransfer.TransferDate = value)"
                    Label="Data przelewu"
                    Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSavingsTransferAsync">Dodaj
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_monthPlan?.SavingsTransfers.Count > 0)
        {
            <MudTable Items="_monthPlan.SavingsTransfers" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>Kwota</MudTh>
                    <MudTh>Data przelewu</MudTh>
                    <MudTh>Akcje</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @if (_editSavingsTransfer?.Id == item.Id)
                    {
                        <MudTd>
                            <MudNumericField T="decimal"
                                             @bind-Value="_editSavingsTransfer.Amount"
                                             Variant="Variant.Outlined"
                                             Culture="Culture"
                                             Immediate="true"/>
                        </MudTd>
                        <MudTd>
                            <MudDatePicker
                                Date="@_editSavingsTransferDate.ToDateTime(TimeOnly.MinValue)"
                                DateChanged="(date) => UpdateDateIfProvided(date, value => _editSavingsTransferDate = value)"
                                Variant="Variant.Outlined"/>
                        </MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="SaveSavingsTransferEditAsync">Zapisz
                            </MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelSavingsTransferEdit">
                                Anuluj
                            </MudButton>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd>@item.Amount.ToString("0.00", Culture) PLN</MudTd>
                        <MudTd>@item.TransferDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       OnClick="() => StartSavingsTransferEdit(item)">Edytuj
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       OnClick="() => DeleteSavingsTransferAsync(item.Id)">Usun
                            </MudButton>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudPaper Class="pa-4 hb-panel">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">Wpływy miesiąca</MudText>
            <MudButton
                Variant="Variant.Outlined"
                Color="Color.Secondary"
                StartIcon="@Icons.Material.Filled.Repeat"
                OnClick="NavigateToRegularIncomes">
                Zarządzaj regularnymi
            </MudButton>
        </MudStack>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField
                    @bind-Value="_newIncome.Name"
                    Label="Nazwa wpływu"
                    Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="int"
                           @bind-Value="_newIncome.AccountId"
                           Label="Konto"
                           Variant="Variant.Outlined">
                    @foreach (var account in _accounts)
                    {
                        <MudSelectItem Value="@account.Id">@account.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="decimal" @bind-Value="_newIncome.Amount"
                                 Label="Kwota"
                                 Variant="Variant.Outlined"
                                 Culture="Culture"
                                 Immediate="true"/>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudDatePicker Date="_newIncome.ExpectedDayOfMonth.ToDateTime(TimeOnly.MinValue)"
                               DateChanged="(date) => UpdateDateIfProvided(date, value => _newIncome.ExpectedDayOfMonth = value)"
                               Label="Oczekiwany dzień"
                               Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" md="1" Class="d-flex align-center justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateIncomeAsync">Dodaj</MudButton>
            </MudItem>
        </MudGrid>

        @if (_incomes.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mt-3 hb-muted">Brak wpływów w tym miesiącu.</MudText>
        }
        else
        {
            <MudTable Items="_incomes" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>Nazwa</MudTh>
                    <MudTh>Konto</MudTh>
                    <MudTh>Typ</MudTh>
                    <MudTh>Kwota</MudTh>
                    <MudTh>Planowana data</MudTh>
                    <MudTh>Akcje</MudTh>
                </HeaderContent>
                <RowTemplate Context="income">
                    @if (!income.IsRegular && _editIncome?.Id == income.Id)
                    {
                        <MudTd>
                            <MudTextField @bind-Value="_editIncome.Name" Variant="Variant.Outlined"/>
                        </MudTd>
                        <MudTd>
                            <MudSelect T="int" @bind-Value="_editIncome.AccountId" Variant="Variant.Outlined">
                                @foreach (var account in _accounts)
                                {
                                    <MudSelectItem Value="@account.Id">@account.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Color="Color.Info">Nieregularny</MudChip>
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="decimal" @bind-Value="_editIncome.Amount"
                                             Variant="Variant.Outlined"
                                             Culture="Culture"
                                             Immediate="true"/>
                        </MudTd>
                        <MudTd>
                            <MudDatePicker
                                Date="@_editIncomeDate.ToDateTime(TimeOnly.MinValue)"
                                DateChanged="(date) => UpdateDateIfProvided(date, value => _editIncomeDate = value)"
                                Variant="Variant.Outlined"/>
                        </MudTd>
                        <MudTd>
                            <MudButton
                                Variant="Variant.Filled"
                                Color="Color.Primary"
                                Size="Size.Small"
                                OnClick="SaveIncomeEditAsync">
                                Zapisz
                            </MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelIncomeEdit">Anuluj
                            </MudButton>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd>@income.Name</MudTd>
                        <MudTd>@income.AccountName</MudTd>
                        <MudTd>
                            <MudChip T="string"
                                     Color="@(income.IsRegular ? Color.Primary : Color.Info)">@(income.IsRegular ? "Regularny" : "Nieregularny")</MudChip>
                        </MudTd>
                        <MudTd>@income.Amount.ToString("0.00", Culture) zł</MudTd>
                        <MudTd>@income.ExpectedDayOfMonth.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>
                            @if (income.IsRegular)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                           OnClick="() => PrepareBonusFromIncome(income)">Dodaj bonus
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => StartIncomeEdit(income)">Edytuj
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           OnClick="() => DeleteIncomeAsync(income.Id)">Usuń
                                </MudButton>
                            }
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudPaper Class="pa-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Lista wydatków</MudText>

        @if (_monthPlan is null || _monthPlan.Expenses.Count == 0)
        {
            <MudText Typo="Typo.body2">Brak wydatków w tym miesiącu.</MudText>
        }
        else
        {
            <MudTable Items="OrderedExpenses" Dense="true" Hover="true" RowClassFunc="GetRowClass">
                <HeaderContent>
                    <MudTh>Kolejność</MudTh>
                    <MudTh>Nazwa</MudTh>
                    <MudTh>Kategoria</MudTh>
                    <MudTh>Tag</MudTh>
                    <MudTh>Planowana</MudTh>
                    <MudTh>Realna</MudTh>
                    <MudTh>Pozostało</MudTh>
                    <MudTh>Akcje</MudTh>
                </HeaderContent>
                <RowTemplate Context="expense">
                    @if (_editExpense?.Id == expense.Id)
                    {
                        <MudTd>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.caption">@expense.Order</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                               Size="Size.Small"
                                               Disabled="@IsFirstExpense(expense.Id)"
                                               OnClick="() => MoveExpenseAsync(expense.Id, -1)"/>
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                               Size="Size.Small"
                                               Disabled="@IsLastExpense(expense.Id)"
                                               OnClick="() => MoveExpenseAsync(expense.Id, 1)"/>
                            </MudStack>
                        </MudTd>
                        <MudTd>
                            <MudTextField @bind-Value="_editExpense.Name" Variant="Variant.Outlined"/>
                        </MudTd>
                        <MudTd>
                            <MudSelect T="int" Value="_editExpense.CategoryId" ValueChanged="OnEditCategoryChanged"
                                       Variant="Variant.Outlined">
                                @foreach (var category in _categories)
                                {
                                    <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudSelect T="int?"
                                       @bind-Value="_editExpense.TagId"
                                       Variant="Variant.Outlined"
                                       Clearable="true">
                                @foreach (var tag in GetSelectableTags(_editExpense.CategoryId, _editExpense.TagId))
                                {
                                    <MudSelectItem T="int?" Value="@tag.Id">@tag.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="decimal"
                                             @bind-Value="_editExpense.PlannedAmount"
                                             Variant="Variant.Outlined"
                                             Min="0"
                                             Culture="Culture"/>
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="decimal"
                                             @bind-Value="_editExpense.ActualAmount"
                                             Variant="Variant.Outlined"
                                             Min="0"
                                             Culture="Culture"
                                             Disabled="@(_monthPlan?.Expenses.FirstOrDefault(x => x.Id == _editExpense.Id)?.HasLineItems == true)"/>
                        </MudTd>
                        <MudTd>@FormatRemaining(_editExpense.ShowRemainingInUI, _editExpense.PlannedAmount - _editExpense.ActualAmount)</MudTd>
                        <MudTd>
                            <MudSwitch @bind-Value="_editExpense.ShowRemainingInUI" Color="Color.Primary"/>
                            <MudButton
                                Variant="Variant.Filled"
                                Color="Color.Primary"
                                Size="Size.Small"
                                OnClick="SaveEditAsync">Zapisz
                            </MudButton>
                            <MudButton
                                Variant="Variant.Text"
                                Size="Size.Small"
                                OnClick="CancelEdit">Anuluj
                            </MudButton>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.caption">@expense.Order</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                               Size="Size.Small"
                                               Disabled="@IsFirstExpense(expense.Id)"
                                               OnClick="() => MoveExpenseAsync(expense.Id, -1)"/>
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                               Size="Size.Small"
                                               Disabled="@IsLastExpense(expense.Id)"
                                               OnClick="() => MoveExpenseAsync(expense.Id, 1)"/>
                            </MudStack>
                        </MudTd>
                        <MudTd>@expense.Name</MudTd>
                        <MudTd>@expense.CategoryName</MudTd>
                        <MudTd>@(expense.TagName ?? "-")</MudTd>
                        <MudTd>@FormatPlannedAmount(expense.PlannedAmount)</MudTd>
                        <MudTd>@(expense.ActualAmount.ToString("0.00", Culture)) zł</MudTd>
                        <MudTd>@FormatRemainingForExpense(expense)</MudTd>
                        <MudTd>
                            <MudButton
                                Variant="Variant.Outlined"
                                Color="Color.Primary"
                                Size="Size.Small"
                                OnClick="() => StartEdit(expense)">Edytuj
                            </MudButton>
                            <MudButton
                                Variant="Variant.Outlined"
                                Color="Color.Error"
                                Size="Size.Small"
                                OnClick="() => DeleteExpenseAsync(expense.Id)">Usuń
                            </MudButton>
                            @if (expense.SupportsLineItems)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                                           OnClick="() => ToggleLineItems(expense.Id)">
                                    @(_expandedExpenseIds.Contains(expense.Id) ? "▲" : "▼")
                                </MudButton>
                            }
                        </MudTd>
                    }
                </RowTemplate>
                <ChildRowContent Context="expense">
                    @if (expense.SupportsLineItems && _expandedExpenseIds.Contains(expense.Id))
                    {
                        <MudTd colspan="8" Class="pa-3">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2">Pozycje wydatku</MudText>

                                @if (expense.LineItems.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="hb-muted">Brak pozycji.</MudText>
                                }
                                else
                                {
                                    <MudTable Items="expense.LineItems" Dense="true" Hover="true">
                                        <HeaderContent>
                                            <MudTh>Opis</MudTh>
                                            <MudTh>Kwota</MudTh>
                                            <MudTh>Data</MudTh>
                                            <MudTh>Tag</MudTh>
                                            <MudTh>Akcje</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="lineItem">
                                            @if (_editLineItem is not null && _editLineItem.Id == lineItem.Id)
                                            {
                                                <MudTd>
                                                    <MudTextField
                                                        @bind-Value="_editLineItem.Description"
                                                        Variant="Variant.Outlined"
                                                        Margin="Margin.Dense"/>
                                                </MudTd>
                                                <MudTd>
                                                    <MudNumericField T="decimal"
                                                                     @bind-Value="_editLineItem.Amount"
                                                                     Variant="Variant.Outlined"
                                                                     Margin="Margin.Dense"
                                                                     Min="0"
                                                                     Culture="Culture"/>
                                                </MudTd>
                                                <MudTd>
                                                    <MudDatePicker
                                                        Date="@_editLineItemDate.ToDateTime(TimeOnly.MinValue)"
                                                        DateChanged="(date) => UpdateDateIfProvided(date, value => _editLineItemDate = value, false)"
                                                        Margin="Margin.Dense"/>
                                                </MudTd>
                                                <MudTd>
                                                    <MudSelect T="int?"
                                                               @bind-Value="_editLineItem.TagId"
                                                               Variant="Variant.Outlined"
                                                               Clearable="true" Margin="Margin.Dense">
                                                        @foreach (var tag in GetSelectableTags(_editLineItemExpenseId == expense.Id ? expense.CategoryId : 0, _editLineItem.TagId))
                                                        {
                                                            <MudSelectItem T="int?"
                                                                           Value="@tag.Id">@tag.Name</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudTd>
                                                <MudTd>
                                                    <MudButton
                                                        Variant="Variant.Filled"
                                                        Color="Color.Primary"
                                                        Size="Size.Small"
                                                        OnClick="SaveLineItemEditAsync">
                                                        Zapisz
                                                    </MudButton>
                                                    <MudButton
                                                        Variant="Variant.Text"
                                                        Size="Size.Small"
                                                        OnClick="CancelLineItemEdit">
                                                        Anuluj
                                                    </MudButton>
                                                </MudTd>
                                            }
                                            else
                                            {
                                                <MudTd>@lineItem.Description</MudTd>
                                                <MudTd>@lineItem.Amount.ToString("0.00", Culture)</MudTd>
                                                <MudTd>@lineItem.OccurredAt.ToString("yyyy-MM-dd")</MudTd>
                                                <MudTd>@(lineItem.TagName ?? "-")</MudTd>
                                                <MudTd>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                   Color="Color.Primary"
                                                                   OnClick="() => BeginLineItemEdit(lineItem, expense.Id)"/>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Color="Color.Error"
                                                                   OnClick="() => DeleteLineItemAsync(lineItem.Id, expense.Id)"/>
                                                </MudTd>
                                            }
                                        </RowTemplate>
                                    </MudTable>
                                }

                                <MudDivider/>

                                @{ var createModel = GetLineItemCreateModel(expense.Id); }

                                <MudGrid>
                                    <MudItem xs="12" md="4">
                                        <MudTextField @bind-Value="createModel.Description"
                                                      Label="Opis pozycji" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"/>
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudNumericField T="decimal"
                                                         @bind-Value="createModel.Amount"
                                                         Label="Kwota"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Min="0"
                                                         Culture="Culture"/>
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudDatePicker
                                            Date="@createModel.OccurredAt.ToDateTime(TimeOnly.MinValue)"
                                            DateChanged="(d) => createModel.OccurredAt = d.HasValue ? DateOnly.FromDateTime(d.Value) : createModel.OccurredAt"
                                            Margin="Margin.Dense"/>
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudSelect T="int?"
                                                   @bind-Value="createModel.TagId"
                                                   Label="Tag"
                                                   Variant="Variant.Outlined"
                                                   Clearable="true"
                                                   Margin="Margin.Dense">
                                            @foreach (var tag in GetSelectableTags(expense.CategoryId, createModel.TagId))
                                            {
                                                <MudSelectItem T="int?" Value="@tag.Id">@tag.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="2" Class="d-flex align-center">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                   OnClick="() => CreateLineItemAsync(expense.Id)">Dodaj pozycję
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudStack>
                        </MudTd>
                    }
                </ChildRowContent>
            </MudTable>
        }

        <MudDivider Class="my-4"/>
        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@(_isCreateExpenseFormVisible ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)"
                       OnClick="ToggleCreateExpenseForm">
                @(_isCreateExpenseFormVisible ? "Anuluj dodawanie" : "Dodaj wydatek")
            </MudButton>
        </MudStack>

        @if (_isCreateExpenseFormVisible)
        {
            <MudGrid Class="mt-4">
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_newExpense.Name" Label="Nazwa" Variant="Variant.Outlined"
                                  Required="true"/>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="int" Value="_newExpense.CategoryId" ValueChanged="OnCreateCategoryChanged"
                               Label="Kategoria" Variant="Variant.Outlined">
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="int?"
                               @bind-Value="_newExpense.TagId"
                               Label="Tag"
                               Variant="Variant.Outlined"
                               Clearable="true">
                        @foreach (var tag in GetSelectableTags(_newExpense.CategoryId, _newExpense.TagId))
                        {
                            <MudSelectItem T="int?" Value="@tag.Id">@tag.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField T="decimal"
                                     @bind-Value="_newExpense.PlannedAmount"
                                     Label="Planowana"
                                     Variant="Variant.Outlined"
                                     Min="0"
                                     Culture="Culture"
                                     Immediate="true"/>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField T="decimal"
                                     @bind-Value="_newExpense.ActualAmount"
                                     Label="Realna"
                                     Variant="Variant.Outlined"
                                     Disabled="@IsCategorySupportsLineItems(_newExpense.CategoryId)"
                                     Min="0"
                                     Culture="Culture"
                                     Immediate="true"/>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSwitch
                        @bind-Value="_newExpense.ShowRemainingInUI"
                        Color="Color.Primary"
                        Label="Pokaż pozostało"/>
                </MudItem>
                <MudItem xs="12" md="9" Class="d-flex justify-end align-center">
                    <MudButton
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Add"
                        OnClick="CreateExpenseAsync">Dodaj wydatek
                    </MudButton>
                </MudItem>
            </MudGrid>
        }
    </MudPaper>
</MudStack>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }

    private bool _isLoading;
    private MonthPlanDto? _monthPlan;
    private List<CategoryDto> _categories = [];
    private List<AccountDto> _accounts = [];
    private List<IncomeDto> _incomes = [];
    private LiveBalanceDto _liveBalance = new();
    private MonthPlanKpiDto _kpi = new();

    private readonly CreateMonthSavingsTransferItemRequest _newSavingsTransfer = new()
    {
        TransferDate = DateOnly.FromDateTime(DateTime.Today)
    };

    private UpdateMonthSavingsTransferItemRequest? _editSavingsTransfer;
    private DateOnly _editSavingsTransferDate = DateOnly.FromDateTime(DateTime.Today);

    private static readonly CultureInfo Culture = new("pl-PL");

    private readonly CreateExpenseRequest _newExpense = new()
    {
        ShowRemainingInUI = true
    };

    private readonly CreateIncomeRequest _newIncome = new()
    {
        Name = string.Empty,
        ExpectedDayOfMonth = DateOnly.FromDateTime(DateTime.Today)
    };

    private UpdateExpenseRequest? _editExpense;
    private UpdateIncomeRequest? _editIncome;
    private DateOnly _editIncomeDate = DateOnly.FromDateTime(DateTime.Today);
    private readonly HashSet<int> _expandedExpenseIds = [];
    private readonly Dictionary<int, LineItemCreateDto> _lineItemCreateModels = new();
    private UpdateExpenseLineItemRequest? _editLineItem;
    private DateOnly _editLineItemDate = DateOnly.FromDateTime(DateTime.Today);
    private int? _editLineItemExpenseId;
    private bool _isCreateExpenseFormVisible;

    protected override async Task OnParametersSetAsync()
    {
        if (Year < 2000)
        {
            Year = DateTime.Today.Year;
        }

        if (Month is < 1 or > 12)
        {
            Month = DateTime.Today.Month;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            _categories = (await CategoryService.GetAllAsync(CancellationToken.None)).ToList();
            _accounts = (await AccountService.GetAllAsync(CancellationToken.None)).Where(x => !x.IsArchived).ToList();
            _monthPlan = await ExpenseService.GetMonthAsync(Year, Month, CancellationToken.None);

            await IncomeService.SyncRegularIncomesForMonthAsync(Year, Month, CancellationToken.None);

            _incomes = (await IncomeService.GetMonthIncomesAsync(Year, Month, CancellationToken.None)).ToList();
            _liveBalance = await IncomeService.GetLiveBalanceAsync(Year, Month, CancellationToken.None);
            
            _expandedExpenseIds.RemoveWhere(id => _monthPlan.Expenses.All(x => x.Id != id));

            ApplyKpiFromMonthPlan();

            if (_newExpense.CategoryId == 0 && _categories.Count > 0)
            {
                _newExpense.CategoryId = _categories[0].Id;
            }

            if (_newIncome.AccountId == 0 && _accounts.Count > 0)
            {
                _newIncome.AccountId = _accounts[0].Id;
            }

            _newIncome.ExpectedDayOfMonth = _newIncome.ExpectedDayOfMonth;
            _newSavingsTransfer.Year = Year;
            _newSavingsTransfer.Month = Month;
            _newSavingsTransfer.TransferDate = _newSavingsTransfer.TransferDate == default
                ? new DateOnly(Year, Month, 1)
                : _newSavingsTransfer.TransferDate;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IReadOnlyList<TagDto> GetSelectableTags(int categoryId, int? selectedTagId)
    {
        var tags = _categories.FirstOrDefault(x => x.Id == categoryId)?.Tags
            .OrderBy(x => x.Name)
            .ToList();

        if (tags == null)
            return [];

        if ((!selectedTagId.HasValue || tags.Any(x => x.Id == selectedTagId.Value)))
        {
            return tags;
        }

        var selectedTag = _categories
            .SelectMany(x => x.Tags)
            .FirstOrDefault(x => x.Id == selectedTagId.Value);

        if (selectedTag is not null)
        {
            tags.Insert(0, selectedTag);
        }

        return tags;
    }

    private Task OnCreateCategoryChanged(int categoryId)
    {
        _newExpense.CategoryId = categoryId;
        _newExpense.TagId = null;
        if (IsCategorySupportsLineItems(categoryId))
        {
            _newExpense.ActualAmount = 0;
        }

        return Task.CompletedTask;
    }

    private Task OnEditCategoryChanged(int categoryId)
    {
        if (_editExpense is null)
        {
            return Task.CompletedTask;
        }

        _editExpense.CategoryId = categoryId;
        _editExpense.TagId = null;
        return Task.CompletedTask;
    }

    private void ApplyKpiFromMonthPlan()
    {
        _kpi = _monthPlan?.Kpi ?? new MonthPlanKpiDto();
    }

    private Color GetRemainingBarColor()
    {
        if (_kpi.RemainingTotal <= 0)
        {
            return Color.Error;
        }

        if (_kpi.RemainingPercent <= 20)
        {
            return Color.Warning;
        }

        return Color.Success;
    }

    private string GetRowClass(ExpenseDto expense, int _)
    {
        if (expense.PlannedAmount <= 0)
        {
            return "hb-warning-row";
        }

        if (expense.ActualAmount > expense.PlannedAmount)
        {
            return "hb-danger-row";
        }

        return string.Empty;
    }

    private static string FormatRemaining(bool showRemaining, decimal remaining)
    {
        return showRemaining ? $"{Math.Max(0, remaining).ToString("0.00", Culture)} zł" : "-";
    }

    private static string FormatPlannedAmount(decimal? plannedAmount)
    {
        return plannedAmount <= 0
            ? "-"
            : $"{plannedAmount!.Value.ToString("0.00", Culture)} zł";
    }

    private static string FormatRemainingForExpense(ExpenseDto expense)
    {
        if (expense.IsUnplanned || expense.PlannedAmount <= 0)
        {
            return "-";
        }

        return FormatRemaining(expense.ShowRemainingInUI, expense.RemainingAmount);
    }

    private async Task CreateExpenseAsync()
    {
        try
        {
            _newExpense.Year = Year;
            _newExpense.Month = Month;

            await ExpenseService.CreateExpenseAsync(_newExpense, CancellationToken.None);

            _newExpense.Name = string.Empty;
            _newExpense.TagId = null;
            _newExpense.PlannedAmount = 0;
            _newExpense.ActualAmount = 0;
            _newExpense.ShowRemainingInUI = true;
            _isCreateExpenseFormVisible = false;

            await LoadAsync();
            Snackbar.Add("Dodano wydatek.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ToggleCreateExpenseForm()
    {
        _isCreateExpenseFormVisible = !_isCreateExpenseFormVisible;
    }

    private void StartEdit(ExpenseDto expense)
    {
        _editExpense = new UpdateExpenseRequest
        {
            Id = expense.Id,
            Name = expense.Name,
            CategoryId = expense.CategoryId,
            TagId = expense.TagId,
            PlannedAmount = expense.PlannedAmount,
            ActualAmount = expense.ActualAmount,
            ShowRemainingInUI = expense.ShowRemainingInUI,
        };

        if (expense.HasLineItems)
        {
            _editExpense.ActualAmount = expense.LineItems.Sum(x => x.Amount);
        }
    }

    private void CancelEdit()
    {
        _editExpense = null;
    }

    private async Task SaveEditAsync()
    {
        if (_editExpense is null)
        {
            return;
        }

        try
        {
            await ExpenseService.UpdateExpenseAsync(_editExpense, CancellationToken.None);
            _editExpense = null;
            await LoadAsync();
            Snackbar.Add("Zapisano wydatek.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CreateIncomeAsync()
    {
        try
        {
            _newIncome.Year = Year;
            _newIncome.Month = Month;
            _newIncome.ExpectedDayOfMonth = _newIncome.ExpectedDayOfMonth;
            _newIncome.IsRegular = false;

            await IncomeService.CreateIncomeAsync(_newIncome, CancellationToken.None);

            _newIncome.Name = string.Empty;
            _newIncome.Amount = 0;
            _newIncome.ExpectedDayOfMonth = new DateOnly(Year, Month, 1);

            await LoadAsync();
            Snackbar.Add("Dodano wpływ.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void StartIncomeEdit(IncomeDto income)
    {
        _editIncome = new UpdateIncomeRequest
        {
            Id = income.Id,
            Name = income.Name,
            Amount = income.Amount,
            AccountId = income.AccountId,
            ExpectedDayOfMonth = income.ExpectedDayOfMonth,
            IsRegular = false
        };

        _editIncomeDate = income.ExpectedDayOfMonth;
    }

    private void CancelIncomeEdit()
    {
        _editIncome = null;
        _editIncomeDate = new DateOnly(Year, Month, 1);
    }

    private async Task SaveIncomeEditAsync()
    {
        if (_editIncome is null)
        {
            return;
        }

        try
        {
            _editIncome.ExpectedDayOfMonth = _editIncomeDate;
            await IncomeService.UpdateIncomeAsync(_editIncome, CancellationToken.None);
            _editIncome = null;
            await LoadAsync();
            Snackbar.Add("Zapisano wpływ.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteIncomeAsync(int incomeId)
    {
        var confirmation = await ConfirmAsync("Usunąć wpływ?");
        if (!confirmation)
        {
            return;
        }

        try
        {
            await IncomeService.DeleteIncomeAsync(new DeleteIncomeRequest { Id = incomeId }, CancellationToken.None);
            await LoadAsync();
            Snackbar.Add("Usunięto wpływ.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteExpenseAsync(int expenseId)
    {
        var confirmation = await ConfirmAsync("Usunąć wydatek?");
        if (!confirmation)
        {
            return;
        }

        try
        {
            await ExpenseService.DeleteExpenseAsync(new DeleteExpenseRequest { Id = expenseId }, CancellationToken.None);
            await LoadAsync();
            Snackbar.Add("Usunięto wydatek.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void NavigateToMonth(int monthOffset, bool useCurrent = false)
    {
        var targetMonth = useCurrent
            ? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)
            : new DateTime(Year, Month, 1).AddMonths(monthOffset);

        _editExpense = null;
        NavigationManager.NavigateTo($"/plan/{targetMonth.Year}/{targetMonth.Month}");
    }

    private void NavigateToRegularIncomes()
    {
        NavigationManager.NavigateTo("/regular-incomes");
    }

    private IReadOnlyList<ExpenseDto> OrderedExpenses => _monthPlan?.Expenses
        .OrderBy(x => x.Order)
        .ThenBy(x => x.Id)
        .ToList() ?? [];

    private async Task MoveExpenseAsync(int expenseId, int direction)
    {
        var ordered = OrderedExpenses.ToList();
        var index = ordered.FindIndex(x => x.Id == expenseId);

        if (index == -1)
        {
            return;
        }

        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= ordered.Count)
        {
            return;
        }

        (ordered[index], ordered[newIndex]) = (ordered[newIndex], ordered[index]);

        try
        {
            await ExpenseService.ReorderExpensesAsync(new ReorderExpensesRequest
            {
                ExpenseIds = ordered.Select(x => x.Id).ToList()
            }, CancellationToken.None);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private bool IsFirstExpense(int expenseId)
    {
        return OrderedExpenses.Count == 0 || OrderedExpenses[0].Id == expenseId;
    }

    private bool IsLastExpense(int expenseId)
    {
        return OrderedExpenses.Count == 0 || OrderedExpenses[^1].Id == expenseId;
    }

    private void PrepareBonusFromIncome(IncomeDto income)
    {
        _newIncome.Name = $"{income.Name} - bonus";
        _newIncome.AccountId = income.AccountId;
        _newIncome.Amount = 0;
        _newIncome.ExpectedDayOfMonth = DateOnly.FromDateTime(DateTime.Today);
    }

    private async Task CreateSavingsTransferAsync()
    {
        try
        {
            _newSavingsTransfer.Year = Year;
            _newSavingsTransfer.Month = Month;
            _newSavingsTransfer.TransferDate = _newSavingsTransfer.TransferDate;

            await ExpenseService.CreateMonthSavingsTransferItemAsync(_newSavingsTransfer, CancellationToken.None);

            _newSavingsTransfer.Amount = 0;
            _newSavingsTransfer.TransferDate = new DateOnly(Year, Month, 1);

            await LoadAsync();
            Snackbar.Add("Dodano pozycje oszczednosci.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void StartSavingsTransferEdit(MonthSavingsTransferItemDto item)
    {
        _editSavingsTransfer = new UpdateMonthSavingsTransferItemRequest
        {
            Id = item.Id,
            Amount = item.Amount,
            TransferDate = item.TransferDate
        };
        _editSavingsTransferDate = item.TransferDate;
    }

    private void CancelSavingsTransferEdit()
    {
        _editSavingsTransfer = null;
        _editSavingsTransferDate = new DateOnly(Year, Month, 1);
    }

    private async Task SaveSavingsTransferEditAsync()
    {
        if (_editSavingsTransfer is null)
        {
            return;
        }

        try
        {
            _editSavingsTransfer.TransferDate = _editSavingsTransferDate;
            await ExpenseService.UpdateMonthSavingsTransferItemAsync(_editSavingsTransfer, CancellationToken.None);
            _editSavingsTransfer = null;
            await LoadAsync();
            Snackbar.Add("Zapisano pozycje oszczednosci.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteSavingsTransferAsync(int id)
    {
        try
        {
            await ExpenseService.DeleteMonthSavingsTransferItemAsync(new DeleteMonthSavingsTransferItemRequest { Id = id }, CancellationToken.None);
            await LoadAsync();
            Snackbar.Add("Usunieto pozycje oszczednosci.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private bool IsCategorySupportsLineItems(int categoryId)
    {
        return _categories.FirstOrDefault(x => x.Id == categoryId)?.SupportsLineItems == true;
    }

    private void ToggleLineItems(int expenseId)
    {
        if (!_expandedExpenseIds.Add(expenseId))
        {
            _expandedExpenseIds.Remove(expenseId);
            if (_editLineItemExpenseId == expenseId)
            {
                CancelLineItemEdit();
            }
        }
    }

    private LineItemCreateDto GetLineItemCreateModel(int expenseId)
    {
        if (_lineItemCreateModels.TryGetValue(expenseId, out var model))
        {
            return model;
        }

        model = new LineItemCreateDto();
        _lineItemCreateModels[expenseId] = model;
        return model;
    }

    private async Task CreateLineItemAsync(int expenseId)
    {
        var model = GetLineItemCreateModel(expenseId);
        if (string.IsNullOrWhiteSpace(model.Description))
        {
            Snackbar.Add("Podaj opis pozycji.", Severity.Warning);
            return;
        }

        try
        {
            await ExpenseService.CreateExpenseLineItemAsync(new CreateExpenseLineItemRequest
            {
                ExpenseId = expenseId,
                Description = model.Description,
                Amount = model.Amount,
                OccurredAt = model.OccurredAt,
                TagId = model.TagId
            }, CancellationToken.None);

            _lineItemCreateModels[expenseId] = new LineItemCreateDto();
            await LoadAsync();
            _expandedExpenseIds.Add(expenseId);
            Snackbar.Add("Dodano pozycję.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void BeginLineItemEdit(ExpenseLineItemDto lineItem, int expenseId)
    {
        _editLineItem = new UpdateExpenseLineItemRequest
        {
            Id = lineItem.Id,
            Description = lineItem.Description,
            Amount = lineItem.Amount,
            OccurredAt = lineItem.OccurredAt,
            TagId = lineItem.TagId
        };
        _editLineItemDate = lineItem.OccurredAt;
        _editLineItemExpenseId = expenseId;
    }

    private async Task SaveLineItemEditAsync()
    {
        if (_editLineItem is null)
        {
            return;
        }

        try
        {
            _editLineItem.OccurredAt = _editLineItemDate;
            await ExpenseService.UpdateExpenseLineItemAsync(_editLineItem, CancellationToken.None);

            var expandedExpenseId = _editLineItemExpenseId;
            CancelLineItemEdit();
            await LoadAsync();
            if (expandedExpenseId.HasValue)
            {
                _expandedExpenseIds.Add(expandedExpenseId.Value);
            }

            Snackbar.Add("Zapisano pozycję.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelLineItemEdit()
    {
        _editLineItem = null;
        _editLineItemDate = DateOnly.FromDateTime(DateTime.Today);
        _editLineItemExpenseId = null;
    }

    private async Task DeleteLineItemAsync(int lineItemId, int expenseId)
    {
        try
        {
            await ExpenseService.DeleteExpenseLineItemAsync(new DeleteExpenseLineItemRequest { Id = lineItemId }, CancellationToken.None);
            await LoadAsync();
            if (expenseId > 0)
            {
                _expandedExpenseIds.Add(expenseId);
            }

            Snackbar.Add("Usunięto pozycję.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        return await JsRuntime.InvokeAsync<bool>("confirm", message);
    }

    private void UpdateDateIfProvided(DateTime? date, Action<DateOnly> apply, bool ensureCurrentMonth = true)
    {
        if (!date.HasValue)
        {
            return;
        }

        var dateOnly = DateOnly.FromDateTime(date.Value);
        apply(dateOnly);
    }

}
