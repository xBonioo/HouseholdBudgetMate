@page "/recurring"
@using HouseholdBudgetMate.Abstractions.Contracts.Categories
@using MudBlazor

<div class="recurring-dashboard">
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="recurring-alert">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <MudText>Nie udało się załadować cyklicznych operacji: @_loadError</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" OnClick="LoadAsync">
                    Spróbuj ponownie
                </MudButton>
            </MudStack>
        </MudAlert>
    }

    <MudPaper Class="recurring-hero hb-page-header">
        <div class="recurring-hero-main">
            <div>
                <MudText Typo="Typo.h4" Class="recurring-title">Cykliczne operacje</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">
                    Zarządzaj stałymi wpływami, rachunkami i ratami, zanim trafią do planu miesiąca.
                </MudText>
            </div>

            <div class="recurring-hero-actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CalendarMonth"
                           Href="@CurrentMonthPlanHref">
                    Otwórz bieżący plan
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CreditScore"
                           Href="/loans">
                    Kredyty
                </MudButton>
            </div>
        </div>
    </MudPaper>

    @if (_isInitialLoading)
    {
        <div class="recurring-kpi-grid">
            @for (var i = 0; i < 3; i++)
            {
                <MudPaper Class="hb-kpi-card recurring-kpi-card">
                    <MudSkeleton Width="50%" Height="16px"/>
                    <MudSkeleton Width="72%" Height="32px" Class="mt-2"/>
                    <MudSkeleton Width="58%" Height="14px" Class="mt-2"/>
                </MudPaper>
            }
        </div>
    }
    else
    {
        <div class="recurring-kpi-grid">
            <MudPaper Class="@NetKpiClass">
                <MudText Typo="Typo.caption" Class="hb-muted">Bilans stałych operacji</MudText>
                <MudText Class="hb-kpi-value">@FormatMoney(_overview.NetRecurringAmount)</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">Aktywne wpływy minus aktywne wydatki</MudText>
            </MudPaper>
            <MudPaper Class="hb-kpi-card recurring-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Aktywne wpływy</MudText>
                <MudText Class="hb-kpi-value recurring-positive">@FormatMoney(_overview.ActiveIncomeAmount)</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">@_overview.ActiveIncomeCount pozycji</MudText>
            </MudPaper>
            <MudPaper Class="hb-kpi-card recurring-kpi-card">
                <MudText Typo="Typo.caption" Class="hb-muted">Aktywne wydatki</MudText>
                <MudText Class="hb-kpi-value recurring-negative">@FormatMoney(_overview.ActiveExpenseAmount)</MudText>
                <MudText Typo="Typo.caption" Class="hb-muted">@_overview.ActiveExpenseCount pozycji</MudText>
            </MudPaper>
        </div>
    }

    <MudPaper Class="hb-panel recurring-panel recurring-create-panel" id="recurring-create">
        <MudText Typo="Typo.h6">Dodaj cykliczny wpływ/wydatek</MudText>
        <MudText Typo="Typo.body2" Class="hb-muted">Dodaj stały wpływ lub rachunek bez opuszczania widoku.</MudText>

        <div class="recurring-create-grid">
            <section class="recurring-create-box" aria-labelledby="recurring-income-form-title">
                <div class="recurring-form-heading">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success"/>
                    <div>
                        <MudText Typo="Typo.subtitle2" id="recurring-income-form-title">Nowy wpływ</MudText>
                        <MudText Typo="Typo.caption" Class="hb-muted">Pensja, zwrot, stały przelew.</MudText>
                    </div>
                </div>

                <ActionForm OnSubmit="CreateIncomeDefinitionAsync" Class="recurring-form">
                    <MudTextField @bind-Value="_newIncomeDefinition.Name"
                                  MaxLength="64"
                                  Label="Nazwa"
                                  Variant="Variant.Outlined"
                                  Error="@(!string.IsNullOrWhiteSpace(_createIncomeNameError))"
                                  ErrorText="@_createIncomeNameError"/>
                    <MudTextField T="string"
                                  @bind-Value="_createIncomeAmountInput"
                                  Label="Kwota"
                                  Variant="Variant.Outlined"
                                  InputMode="DecimalInputMode"
                                  Immediate="true"
                                  Adornment="Adornment.End"
                                  AdornmentText="PLN"
                                  Error="@(!string.IsNullOrWhiteSpace(_createIncomeAmountError))"
                                  ErrorText="@_createIncomeAmountError"/>
                    <MudNumericField T="int"
                                     @bind-Value="_newIncomeDefinition.DayOfMonth"
                                     Label="Dzień miesiąca"
                                     Variant="Variant.Outlined"
                                     Min="1"
                                     Max="31"
                                     Error="@(!string.IsNullOrWhiteSpace(_createIncomeDayError))"
                                     ErrorText="@_createIncomeDayError"/>
                    <MudSelect T="int"
                               @bind-Value="_newIncomeDefinition.AccountId"
                               Label="Konto"
                               Variant="Variant.Outlined"
                               Disabled="@(_accounts.Count == 0)"
                               Error="@(!string.IsNullOrWhiteSpace(_createIncomeAccountError))"
                               ErrorText="@_createIncomeAccountError">
                        @foreach (var account in _accounts)
                        {
                            <MudSelectItem Value="@account.Id">@account.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                               StartIcon="@Icons.Material.Filled.Add" Disabled="@(_isBusy || _accounts.Count == 0)">
                        Dodaj wpływ
                    </MudButton>
                </ActionForm>
            </section>

            <section class="recurring-create-box" aria-labelledby="recurring-expense-form-title">
                <div class="recurring-form-heading">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Warning"/>
                    <div>
                        <MudText Typo="Typo.subtitle2" id="recurring-expense-form-title">Nowy wydatek</MudText>
                        <MudText Typo="Typo.caption" Class="hb-muted">Rachunek, abonament, regularny koszt.</MudText>
                    </div>
                </div>

                <ActionForm OnSubmit="CreateExpenseDefinitionAsync" Class="recurring-form">
                    <MudTextField @bind-Value="_newExpenseDefinition.Name"
                                  MaxLength="160"
                                  Label="Nazwa"
                                  Variant="Variant.Outlined"
                                  Error="@(!string.IsNullOrWhiteSpace(_createExpenseNameError))"
                                  ErrorText="@_createExpenseNameError"/>
                    <MudSelect T="int"
                               Value="_newExpenseDefinition.CategoryId"
                               ValueChanged="OnCreateExpenseCategoryChanged"
                               Label="Kategoria"
                               Variant="Variant.Outlined"
                               Disabled="@(_categories.Count == 0)"
                               Error="@(!string.IsNullOrWhiteSpace(_createExpenseCategoryError))"
                               ErrorText="@_createExpenseCategoryError">
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem Value="@category.Id">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int?"
                               @bind-Value="_newExpenseDefinition.TagId"
                               Label="Tag"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Class="hb-select-ellipsis">
                        @foreach (var tag in CategoryTagSelector.GetSelectableRootTags(_categories, _newExpenseDefinition.CategoryId, _newExpenseDefinition.TagId))
                        {
                            <MudSelectItem T="int?" Value="@tag.Id">@tag.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string"
                                  @bind-Value="_createExpenseAmountInput"
                                  Label="Kwota"
                                  Variant="Variant.Outlined"
                                  InputMode="DecimalInputMode"
                                  Immediate="true"
                                  Adornment="Adornment.End"
                                  AdornmentText="PLN"
                                  Error="@(!string.IsNullOrWhiteSpace(_createExpenseAmountError))"
                                  ErrorText="@_createExpenseAmountError"/>
                    <MudSwitch @bind-Value="_newExpenseDefinition.ShowRemainingInUI"
                               Color="Color.Primary"
                               Label="Pokazuj pozostałą kwotę w budżecie"/>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                               StartIcon="@Icons.Material.Filled.Add" Disabled="@(_isBusy || _categories.Count == 0)">
                        Dodaj wydatek
                    </MudButton>
                </ActionForm>
            </section>
        </div>
    </MudPaper>

    <MudPaper Class="hb-panel recurring-panel">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="recurring-section-heading">
            <div>
                <MudText Typo="Typo.h6">Cykliczne wpływy</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">Stałe przychody, które możesz dodać do bieżącego miesiąca.</MudText>
            </div>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">
                @FormatMoney(_overview.ActiveIncomeAmount)
            </MudChip>
        </MudStack>

        <MudTable Items="_incomeRows" Dense="true" Hover="true" Class="recurring-table">
            <HeaderContent>
                <MudTh>Nazwa</MudTh>
                <MudTh>Kwota</MudTh>
                <MudTh>Dzień</MudTh>
                <MudTh>Konto</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Class="recurring-actions-cell">Akcje</MudTh>
            </HeaderContent>
            <NoRecordsContent>
                <div class="recurring-empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Info"/>
                    <MudText Typo="Typo.subtitle2">Brak cyklicznych wpływów.</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">Dodaj pierwszy stały wpływ, aby szybciej otwierać kolejne miesiące.</MudText>
                </div>
            </NoRecordsContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="Nazwa">
                    <MudText Typo="Typo.body2" Class="recurring-row-title">@item.Name</MudText>
                </MudTd>
                <MudTd DataLabel="Kwota">
                    <span class="recurring-positive">@FormatMoney(item.Amount)</span>
                </MudTd>
                <MudTd DataLabel="Dzień">@item.DayOfMonth</MudTd>
                <MudTd DataLabel="Konto">@item.AccountName</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="@(item.IsActive ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                        @(item.IsActive ? "Aktywna" : "Nieaktywna")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Akcje" Class="recurring-actions-cell">
                    <div class="recurring-actions-row">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       aria-label="@($"Edytuj wpływ {item.Name}")"
                                       title="@($"Edytuj wpływ {item.Name}")"
                                       OnClick="() => OpenIncomeEditDialogAsync(item)"/>
                        <MudIconButton Icon="@(item.IsActive ? Icons.Material.Filled.PauseCircle : Icons.Material.Filled.PlayCircle)"
                                       Color="@(item.IsActive ? Color.Warning : Color.Success)"
                                       aria-label="@($"{(item.IsActive ? "Dezaktywuj" : "Aktywuj")} wpływ {item.Name}")"
                                       title="@($"{(item.IsActive ? "Dezaktywuj" : "Aktywuj")} wpływ {item.Name}")"
                                       OnClick="() => ToggleIncomeDefinitionActiveAsync(item)"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Today"
                                       Color="Color.Info"
                                       Disabled="@(!item.IsActive)"
                                       aria-label="@($"Dodaj wpływ {item.Name} do aktualnego miesiąca")"
                                       title="@($"Dodaj wpływ {item.Name} do aktualnego miesiąca")"
                                       OnClick="() => AddRegularIncomeToCurrentMonthAsync(item.Id)"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       aria-label="@($"Usuń wpływ {item.Name}")"
                                       title="@($"Usuń wpływ {item.Name}")"
                                       OnClick="() => DeleteIncomeDefinitionPermanentlyAsync(item)"/>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <MudPaper Class="hb-panel recurring-panel">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="recurring-section-heading">
            <div>
                <MudText Typo="Typo.h6">Cykliczne wydatki</MudText>
                <MudText Typo="Typo.body2" Class="hb-muted">Rachunki i koszty stałe uporządkowane tak, jak mają pojawiać się w planie.</MudText>
            </div>
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">
                @FormatMoney(_overview.ActiveExpenseAmount)
            </MudChip>
        </MudStack>

        <MudTable Items="_expenseRows" Dense="true" Hover="true" Class="recurring-table">
            <HeaderContent>
                <MudTh Class="recurring-order-cell">Kolejność</MudTh>
                <MudTh>Nazwa</MudTh>
                <MudTh>Kategoria</MudTh>
                <MudTh>Tag</MudTh>
                <MudTh>Kwota</MudTh>
                <MudTh>Pozostałe</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Class="recurring-actions-cell">Akcje</MudTh>
            </HeaderContent>
            <NoRecordsContent>
                <div class="recurring-empty-state">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Info"/>
                    <MudText Typo="Typo.subtitle2">Brak cyklicznych wydatków.</MudText>
                    <MudText Typo="Typo.body2" Class="hb-muted">Dodaj stałe koszty, aby szybciej kontrolować zobowiązania miesiąca.</MudText>
                </div>
            </NoRecordsContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="Kolejność" Class="recurring-order-cell">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption">@item.Order</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                       Size="Size.Small"
                                       Class="manual-order-action"
                                       Disabled="@IsFirstExpenseDefinition(item.Id)"
                                       aria-label="@($"Przenieś wydatek {item.Name} wyżej")"
                                       title="@($"Przenieś wydatek {item.Name} wyżej")"
                                       OnClick="() => MoveExpenseDefinitionAsync(item.Id, -1)"/>
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                       Size="Size.Small"
                                       Class="manual-order-action"
                                       Disabled="@IsLastExpenseDefinition(item.Id)"
                                       aria-label="@($"Przenieś wydatek {item.Name} niżej")"
                                       title="@($"Przenieś wydatek {item.Name} niżej")"
                                       OnClick="() => MoveExpenseDefinitionAsync(item.Id, 1)"/>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Nazwa">
                    <MudText Typo="Typo.body2" Class="recurring-row-title">@item.Name</MudText>
                </MudTd>
                <MudTd DataLabel="Kategoria">@item.CategoryName</MudTd>
                <MudTd DataLabel="Tag">@(item.TagName ?? "-")</MudTd>
                <MudTd DataLabel="Kwota">
                    <span class="recurring-negative">@FormatMoney(item.Amount)</span>
                </MudTd>
                <MudTd DataLabel="Pozostałe">
                    <MudChip T="string" Color="@(item.ShowRemainingInUI ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                        @(item.ShowRemainingInUI ? "Tak" : "Nie")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="@(item.IsActive ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                        @(item.IsActive ? "Aktywna" : "Nieaktywna")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Akcje" Class="recurring-actions-cell">
                    <div class="recurring-actions-row">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       aria-label="@($"Edytuj wydatek {item.Name}")"
                                       title="@($"Edytuj wydatek {item.Name}")"
                                       OnClick="() => OpenExpenseEditDialogAsync(item)"/>
                        <MudIconButton Icon="@(item.IsActive ? Icons.Material.Filled.PauseCircle : Icons.Material.Filled.PlayCircle)"
                                       Color="@(item.IsActive ? Color.Warning : Color.Success)"
                                       aria-label="@($"{(item.IsActive ? "Dezaktywuj" : "Aktywuj")} wydatek {item.Name}")"
                                       title="@($"{(item.IsActive ? "Dezaktywuj" : "Aktywuj")} wydatek {item.Name}")"
                                       OnClick="() => ToggleExpenseDefinitionActiveAsync(item)"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Today"
                                       Color="Color.Info"
                                       Disabled="@(!item.IsActive)"
                                       aria-label="@($"Dodaj wydatek {item.Name} do aktualnego miesiąca")"
                                       title="@($"Dodaj wydatek {item.Name} do aktualnego miesiąca")"
                                       OnClick="() => AddRegularExpenseToCurrentMonthAsync(item.Id)"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       aria-label="@($"Usuń wydatek {item.Name}")"
                                       title="@($"Usuń wydatek {item.Name}")"
                                       OnClick="() => DeleteExpenseDefinitionPermanentlyAsync(item)"/>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

