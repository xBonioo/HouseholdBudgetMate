@page "/regular-incomes"
@using System.Globalization
@using HouseholdBudgetMate.Abstractions.Contracts.Accounts.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Incomes.Dto
@using HouseholdBudgetMate.Abstractions.Contracts.Incomes.Requests
@using HouseholdBudgetMate.Abstractions.Interfaces
@using MudBlazor

@inject IIncomeService IncomeService
@inject IAccountService AccountService
@inject ISnackbar Snackbar

<MudOverlay Visible="@_isLoading" Absolute="true" DarkBackground="true">
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true"/>
</MudOverlay>

<MudStack Spacing="3" Class="pa-4">
    <MudPaper Class="hb-page-header">
        <MudText Typo="Typo.h4">Wpływy regularne</MudText>
        <MudText Typo="Typo.body2" Class="hb-muted">
            Zdefiniuj stale lub cykliczne wpływy (np. wypłata, dodatki socjalne), które beda automatycznie dodawane do
            miesięcy.
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Nowa definicja</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField
                    @bind-Value="_newDefinition.Name"
                    MaxLength="64"
                    Label="Nazwa"
                    Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="decimal"
                                 @bind-Value="_newDefinition.Amount"
                                 Label="Kwota"
                                 Variant="Variant.Outlined"
                                 Min="0"
                                 Culture="_culture"
                                 Immediate="true"/>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="int"
                                 @bind-Value="_newDefinition.DayOfMonth"
                                 Label="Dzień miesiąca"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Max="31"/>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="int"
                           @bind-Value="_newDefinition.AccountId"
                           Label="Konto"
                           Variant="Variant.Outlined">
                    @foreach (var account in _accounts)
                    {
                        <MudSelectItem Value="@account.Id">@account.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="1" Class="d-flex align-center justify-end">
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    OnClick="CreateDefinitionAsync">Dodaj
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 hb-panel">
        <MudText Typo="Typo.h6" Class="mb-2">Lista definicji</MudText>

        @if (_definitions.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="hb-muted">Brak definicji.</MudText>
        }
        else
        {
            <MudTable Items="_definitions" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Nazwa</MudTh>
                    <MudTh>Kwota</MudTh>
                    <MudTh>Dzień</MudTh>
                    <MudTh>Konto</MudTh>
                    <MudTh>Aktywna</MudTh>
                    <MudTh>Akcje</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @if (_editDefinition?.Id == item.Id)
                    {
                        <MudTd>
                            <MudTextField
                                @bind-Value="_editDefinition.Name"
                                Variant="Variant.Outlined"/>
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="decimal"
                                             @bind-Value="_editDefinition.Amount"
                                             Variant="Variant.Outlined"
                                             Min="0"
                                             Culture="_culture"/>
                        </MudTd>
                        <MudTd>
                            <MudNumericField T="int"
                                             @bind-Value="_editDefinition.DayOfMonth"
                                             Variant="Variant.Outlined"
                                             Min="1"
                                             Max="31"/>
                        </MudTd>
                        <MudTd>
                            <MudSelect T="int"
                                       @bind-Value="_editDefinition.AccountId"
                                       Variant="Variant.Outlined">
                                @foreach (var account in _accounts)
                                {
                                    <MudSelectItem Value="@account.Id">@account.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudSwitch
                                @bind-Value="_editDefinition.IsActive"
                                Color="Color.Primary"/>
                        </MudTd>
                        <MudTd>
                            <MudButton
                                Variant="Variant.Filled"
                                Color="Color.Primary"
                                Size="Size.Small"
                                OnClick="SaveEditAsync">Zapisz
                            </MudButton>
                            <MudButton
                                Variant="Variant.Text"
                                Size="Size.Small"
                                OnClick="CancelEdit">Anuluj
                            </MudButton>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd>@item.Name</MudTd>
                        <MudTd>@item.Amount.ToString("0.00", _culture) zł</MudTd>
                        <MudTd>@item.DayOfMonth</MudTd>
                        <MudTd>@item.AccountName</MudTd>
                        <MudTd>
                            <MudChip T="string"
                                     Color="@(item.IsActive ? Color.Success : Color.Default)">@(item.IsActive ? "Tak" : "Nie")</MudChip>
                        </MudTd>
                        <MudTd>
                            <MudButton
                                Variant="Variant.Outlined"
                                Color="Color.Primary"
                                Size="Size.Small"
                                OnClick="() => StartEdit(item)">Edytuj
                            </MudButton>
                            <MudButton
                                Variant="Variant.Outlined"
                                Color="Color.Error"
                                Size="Size.Small"
                                OnClick="() => DeleteDefinitionAsync(item.Id)">Usun
                            </MudButton>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudStack>

@code {
    private bool _isLoading;
    private readonly CultureInfo _culture = new("pl-PL");
    private List<RegularIncomeDefinitionDto> _definitions = [];
    private List<AccountDto> _accounts = [];

    private readonly CreateRegularIncomeDefinitionRequest _newDefinition = new()
    {
        DayOfMonth = 1
    };

    private UpdateRegularIncomeDefinitionRequest? _editDefinition;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            _accounts = (await AccountService.GetAllAsync(CancellationToken.None)).Where(x => !x.IsArchived).ToList();
            _definitions = (await IncomeService.GetRegularDefinitionsAsync(CancellationToken.None)).ToList();

            if (_newDefinition.AccountId == 0 && _accounts.Count > 0)
            {
                _newDefinition.AccountId = _accounts[0].Id;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateDefinitionAsync()
    {
        try
        {
            await IncomeService.CreateRegularDefinitionAsync(_newDefinition, CancellationToken.None);

            _newDefinition.Name = string.Empty;
            _newDefinition.Amount = 0;
            _newDefinition.DayOfMonth = 1;

            await LoadAsync();
            Snackbar.Add("Dodano definicje.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void StartEdit(RegularIncomeDefinitionDto definition)
    {
        _editDefinition = new UpdateRegularIncomeDefinitionRequest
        {
            Id = definition.Id,
            Name = definition.Name,
            Amount = definition.Amount,
            DayOfMonth = definition.DayOfMonth,
            AccountId = definition.AccountId,
            IsActive = definition.IsActive
        };
    }

    private void CancelEdit()
    {
        _editDefinition = null;
    }

    private async Task SaveEditAsync()
    {
        if (_editDefinition is null)
        {
            return;
        }

        try
        {
            await IncomeService.UpdateRegularDefinitionAsync(_editDefinition, CancellationToken.None);
            _editDefinition = null;
            await LoadAsync();
            Snackbar.Add("Zapisano definicje.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteDefinitionAsync(int id)
    {
        try
        {
            await IncomeService.DeleteRegularDefinitionAsync(new DeleteRegularIncomeDefinitionRequest { Id = id }, CancellationToken.None);
            await LoadAsync();
            Snackbar.Add("Usunieto definicje.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

}

