@page "/setup"
@layout SetupLayout
@using Microsoft.AspNetCore.Components.Forms
@using HouseholdBudgetMate.Abstractions.Enums
@using HouseholdBudgetMate.Web.Setup
@using MudBlazor

@inject ISetupConfigurationService SetupConfigurationService
@inject RuntimeConfigurationState RuntimeConfigurationState
@inject NavigationManager NavigationManager

<DirtyStateMonitor @ref="_dirtyStateMonitor"
                   CurrentState="GetDirtyState()"
                   Label="pierwsza konfiguracja"/>

<MudPaper Class="pa-4 hb-panel">
    <MudText Typo="Typo.h4">Pierwsza konfiguracja aplikacji</MudText>
    <MudText Typo="Typo.body2" Class="mt-1 mb-4">
        Uzupełnij dane połączenia z PostgreSQL. Plik config.json zostanie zapisany w @RuntimeConfigurationState.ConfigFilePath.
    </MudText>

    <EditForm EditContext="_editContext">
        <DataAnnotationsValidator/>
    </EditForm>

    <ActionForm OnSubmit="SaveAsync">
        <MudStack Spacing="2">
            <MudTextField T="string" Label="Host" @bind-Value="_model.Host" For="@(() => _model.Host)" Required="true"/>
            <MudNumericField T="int" Label="Port" @bind-Value="_model.Port" For="@(() => _model.Port)" Min="1" Max="65535" Required="true"/>
            <MudTextField T="string" Label="Login" @bind-Value="_model.Username" For="@(() => _model.Username)" Required="true"/>
            <MudTextField T="string" Label="Hasło" @bind-Value="_model.Password" For="@(() => _model.Password)" InputType="InputType.Password" Required="true"/>
            <MudTextField T="string" Label="Nazwa bazy" @bind-Value="_model.Database" For="@(() => _model.Database)" Required="true"/>
            <MudDivider Class="my-2"/>
            <MudText Typo="Typo.subtitle2">Pierwszy użytkownik aplikacji</MudText>
            <MudTextField T="string" Label="Nazwa użytkownika" @bind-Value="_model.AppUsername" For="@(() => _model.AppUsername)" Required="true"/>
            <PinKeypadInput Label="PIN do aplikacji" @bind-Value="_model.AppPin" For="@(() => _model.AppPin)" Required="true"/>
            <MudSwitch T="bool" Value="IsSharedBudgetMode" ValueChanged="SetSharedBudgetMode" Color="Color.Primary" Label="Budżet wspólny"/>
            <MudTextField T="string"
                          Label="Udostępnij użytkownikom"
                          @bind-Value="_model.SharedWithUserIds"
                          Placeholder="np. spouse-user, parent-user"/>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="_isSaving">
                @(_isSaving ? "Łączenie i migracja..." : "Zapisz i uruchom")
            </MudButton>
        </MudStack>
    </ActionForm>

    <MudDivider Class="my-4"/>
    <MudText Typo="Typo.caption">Ścieżka pliku konfiguracji: @RuntimeConfigurationState.ConfigFilePath</MudText>
</MudPaper>

@if (_isSaving)
{
    <div class="setup-loading-backdrop">
        <MudPaper Class="pa-6 setup-loading-panel" Elevation="4">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
                <MudText Typo="Typo.subtitle1">Trwa łączenie z bazą i wykonywanie migracji...</MudText>
                <MudText Typo="Typo.body2">To może potrwać chwilę, nie zamykaj aplikacji.</MudText>
            </MudStack>
        </MudPaper>
    </div>
}

<style>
    .setup-loading-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .setup-loading-panel {
        width: min(90vw, 540px);
        text-align: center;
    }
</style>

@code {
    private readonly SetupInputModel _model = new();
    private EditContext _editContext = null!;
    private DirtyStateMonitor? _dirtyStateMonitor;
    private bool _isSaving;
    private string? _errorMessage;

    private bool IsSharedBudgetMode => _model.HouseholdMode == HouseholdMode.SharedBudget;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);

        if (RuntimeConfigurationState.IsConfigured)
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task SaveAsync()
    {
        if (!_editContext.Validate())
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var result = await SetupConfigurationService.SaveConfigurationAsync(_model, CancellationToken.None);
            if (!result.IsSuccess)
            {
                _errorMessage = result.ErrorMessage;
                return;
            }

            _dirtyStateMonitor?.Reset(GetDirtyState());
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void SetSharedBudgetMode(bool isShared)
    {
        _model.HouseholdMode = isShared
            ? HouseholdMode.SharedBudget
            : HouseholdMode.SeparateBudget;
    }

    private object GetDirtyState() => new
    {
        _model.Host,
        _model.Port,
        _model.Username,
        _model.Password,
        _model.Database,
        _model.AppUsername,
        _model.AppPin,
        _model.HouseholdMode,
        _model.SharedWithUserIds
    };
}
