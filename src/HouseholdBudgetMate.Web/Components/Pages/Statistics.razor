    private void InitializeLifetimeRange()
    {
        if (_availableHistoryMonths.Count == 0)
        {
            _historyMinDate = null;
            _historyMaxDate = null;
            _historySearchFromDate = null;
            _historySearchToDate = null;
            _lifetimeFromDate = null;
            _lifetimeToDate = null;
            return;
        }

        var first = _availableHistoryMonths
            .OrderBy(x => x.Year)
            .ThenBy(x => x.Month)
            .First();

        var last = _availableHistoryMonths
            .OrderByDescending(x => x.Year)
            .ThenByDescending(x => x.Month)
            .First();

        _historyMinDate = new DateOnly(first.Year, first.Month, 1);
        _historyMaxDate = new DateOnly(last.Year, last.Month, 1);

        ResetLifetimeRangeToSelectedYear();
        _historySearchFromDate ??= _historyMinDate;
        _historySearchToDate ??= _historyMaxDate;

        // Pre-select all categories
        _selectedLifetimeCategoryIds = _categories.Select(c => c.Id).ToHashSet();
    }

