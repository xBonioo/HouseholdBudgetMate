    private void ResetLifetimeRangeToSelectedYear()
    {
        _lifetimeFromDate = ClampToHistoryRange(GetDateOnly(GetLifetimeFromDateTime()));
        _lifetimeToDate = ClampToHistoryRange(GetDateOnly(GetLifetimeToDateTime()));

        if (_lifetimeFromDate.HasValue && _lifetimeToDate.HasValue && _lifetimeFromDate > _lifetimeToDate)
        {
            _lifetimeFromDate = _lifetimeToDate;
        }
    }

    private DateOnly? ClampToHistoryRange(DateOnly? value)
    {
        if (!value.HasValue)
        {
            return null;
        }

        var date = value.Value;
        if (_historyMinDate.HasValue && date < _historyMinDate.Value)
        {
            return _historyMinDate;
        }

        if (_historyMaxDate.HasValue && date > _historyMaxDate.Value)
        {
            return _historyMaxDate;
        }

        return date;
    }

