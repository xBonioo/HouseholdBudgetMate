    #region Charts — user-defined date range

    private static readonly string[] _polishMonthsShort =
        ["Sty", "Lut", "Mar", "Kwi", "Maj", "Cze", "Lip", "Sie", "Wrz", "Paź", "Lis", "Gru"];

    private DateOnly? _chartFromDate;
    private DateOnly? _chartToDate;
    private HashSet<int> _chartSelectedCategoryIds = [];
    private Dictionary<int, YearStatisticsDto> _chartYearStats = new();
    private string[] _barLabels = [];
    private ChartDataset[] _barDatasets = [];
    private ChartDataset[] _lineDatasets = [];

    private void InitializeChartRange()
    {
        var now = DateTimeProvider.GetLocalDateOnly();
        _chartFromDate = ClampToHistoryRange(new DateOnly(_selectedYear, 1, 1));
        _chartToDate   = _selectedYear < now.Year
            ? ClampToHistoryRange(new DateOnly(_selectedYear, 12, DateTime.DaysInMonth(_selectedYear, 12)))
            : ClampToHistoryRange(new DateOnly(now.Year, now.Month, now.Day));
        if (_chartFromDate.HasValue && _chartToDate.HasValue && _chartFromDate > _chartToDate)
            _chartFromDate = _chartToDate;

        // Pre-select all categories so user deselects rather than selects.
        _chartSelectedCategoryIds = _categories.Select(c => c.Id).ToHashSet();
    }

    private DateTime? GetChartFromDateTime() => _chartFromDate?.ToDateTime(TimeOnly.MinValue);
    private DateTime? GetChartToDateTime()   => _chartToDate?.ToDateTime(TimeOnly.MinValue);

    private Task OnChartFromDateChanged(DateTime? value)
    {
        _chartFromDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : _historyMinDate;
        if (_chartToDate.HasValue && _chartFromDate.HasValue && _chartFromDate.Value > _chartToDate.Value)
            _chartToDate = _chartFromDate;
        return Task.CompletedTask;
    }

    private Task OnChartToDateChanged(DateTime? value)
    {
        _chartToDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : _historyMaxDate;
        if (_chartFromDate.HasValue && _chartToDate.HasValue && _chartToDate.Value < _chartFromDate.Value)
