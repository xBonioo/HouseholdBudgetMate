    private async Task LoadStatisticsAsync()
    {
        _isLoading = true;

        try
        {
            _statistics = await ExpenseService.GetYearStatisticsAsync(_selectedYear, CancellationToken.None);
            if (!_statistics.AvailableYears.Contains(_selectedYear) && _statistics.AvailableYears.Count > 0)
            {
                _selectedYear = _statistics.AvailableYears[0];
                _statistics = await ExpenseService.GetYearStatisticsAsync(_selectedYear, CancellationToken.None);
            }

            if (_selectedCategoryId.HasValue && !_statistics.CategoryStatistics.Any(x => x.CategoryId == _selectedCategoryId.Value))
            {
                _selectedCategoryId = null;
                _expandedTagIds.Clear();
            }

            SyncAnnualPlanInputs();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _statistics = new YearStatisticsDto
            {
                Year = _selectedYear,
                AvailableYears = [_selectedYear],
                PopulatedMonths = []
            };
            SyncAnnualPlanInputs();
        }
        finally
        {
            _isLoading = false;
        }
    }

