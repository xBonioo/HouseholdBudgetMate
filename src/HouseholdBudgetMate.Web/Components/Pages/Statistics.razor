    private List<CategoryTagYearStatisticsDto> GetVisibleTagRows(int categoryId)
    {
        var allRows = _categoryRangeStatistics.CategoryTagStatistics
            .Where(x => x.CategoryId == categoryId)
            .ToList();

        if (allRows.Count == 0)
        {
            return [];
        }

        var childrenByParent = allRows
            .Where(x => x.TagId.HasValue)
            .ToLookup(x => x.ParentTagId);

        var rootRows = allRows
            .Where(x => !x.ParentTagId.HasValue)
            .OrderByDescending(x => x.TotalSpent)
            .ThenBy(x => x.TagName)
            .ToList();

        var result = new List<CategoryTagYearStatisticsDto>();
        foreach (var root in rootRows)
        {
            result.Add(root);
            AppendExpandedChildren(root, childrenByParent, result);
        }

        return result;
    }

    private void AppendExpandedChildren(
        CategoryTagYearStatisticsDto parent,
        ILookup<int?, CategoryTagYearStatisticsDto> childrenByParent,
        List<CategoryTagYearStatisticsDto> result)
    {
        if (!parent.TagId.HasValue || !_expandedTagIds.Contains(parent.TagId.Value))
        {
            return;
        }

        var children = childrenByParent[parent.TagId]
            .OrderByDescending(x => x.TotalSpent)
            .ThenBy(x => x.TagName)
            .ToList();

        if (children.Count == 0)
        {
            return;
        }

        foreach (var child in children)
        {
            result.Add(child);
            AppendExpandedChildren(child, childrenByParent, result);
        }
    }

