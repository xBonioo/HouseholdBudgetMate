    private async Task LoadChartDataAsync(CancellationToken ct)
    {
        if (_chartFromDate is null || _chartToDate is null) return;
        try
        {
            var months = GetChartMonths();
            var years  = months.Select(m => m.Year).Distinct();
            _chartYearStats.Clear();
            foreach (var year in years)
                _chartYearStats[year] = await ExpenseService.GetYearStatisticsAsync(year, ct);

            BuildBarChartData();
            BuildLineChartData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private IReadOnlyList<(int Year, int Month)> GetChartMonths()
    {
        if (_chartFromDate is null || _chartToDate is null) return [];
        var result = new List<(int, int)>();
        var d   = new DateOnly(_chartFromDate.Value.Year, _chartFromDate.Value.Month, 1);
        var end = new DateOnly(_chartToDate.Value.Year,   _chartToDate.Value.Month,   1);
        while (d <= end)
        {
            result.Add((d.Year, d.Month));
            d = d.AddMonths(1);
        }
        return result;
    }

    private YearMonthlyFinanceDto? GetFinanceForMonth(int year, int month)
        => _chartYearStats.TryGetValue(year, out var stats)
            ? stats.MonthlyFinance.FirstOrDefault(x => x.Month == month)
            : null;

    private void BuildBarChartData()
    {
        var months  = GetChartMonths();
        _barLabels  = months.Select(m => $"{_polishMonthsShort[m.Month - 1]} '{m.Year % 100:00}").ToArray();

        var spent   = months.Select(m => GetFinanceForMonth(m.Year, m.Month)?.SpentAmount   ?? 0m).ToArray();
        var planned = months.Select(m => GetFinanceForMonth(m.Year, m.Month)?.PlannedAmount ?? 0m).ToArray();

        _barDatasets =
        [
            new ChartDataset("Wydane",      spent,   null,      null,      "bar"),
            new ChartDataset("Zaplanowane", planned, "#0EA5E9", "#0EA5E9", "line"),
        ];
    }

    private void BuildLineChartData()
    {
        var months = GetChartMonths();

        // (year, month, categoryId) -> amount
        var lookup = new Dictionary<(int Year, int Month, int CategoryId), decimal>();
        foreach (var (_, stats) in _chartYearStats)
        {
            for (var i = 0; i < stats.PopulatedMonths.Count; i++)
            {
                var month = stats.PopulatedMonths[i];
                foreach (var cat in stats.CategoryBreakdown)
                {
                    var amount = i < cat.MonthlySpent.Count ? cat.MonthlySpent[i] : 0m;
                    if (amount > 0)
                        lookup[(stats.Year, month, cat.CategoryId)] = amount;
                }
            }
        }

        var monthSet  = months.ToHashSet();
        var catTotals = new Dictionary<int, (string Name, decimal Total)>();
        foreach (var ((year, month, catId), amount) in lookup)
        {
            if (!monthSet.Contains((year, month))) continue;
            if (!_chartSelectedCategoryIds.Contains(catId)) continue;
            var name = GetChartCategoryName(catId);
            catTotals[catId] = catTotals.TryGetValue(catId, out var prev)
                ? (prev.Name, prev.Total + amount)
                : (name, amount);
        }

        var catColorMap = _categories.ToDictionary(c => c.Id, c => c.Color);

        var limit = int.MaxValue;
        _lineDatasets = catTotals
            .OrderByDescending(x => x.Value.Total)
            .Take(limit)
            .Select(kvp =>
            {
                var data = months
                    .Select(m => lookup.GetValueOrDefault((m.Year, m.Month, kvp.Key), 0m))
                    .ToArray();
                var color = catColorMap.GetValueOrDefault(kvp.Key, "#6366F1");
                return new ChartDataset(kvp.Value.Name, data, null, color, "line");
            })
            .ToArray();
    }

    private string GetChartCategoryName(int categoryId)
    {
        foreach (var (_, stats) in _chartYearStats)
        {
            var cat = stats.CategoryBreakdown.FirstOrDefault(c => c.CategoryId == categoryId);
            if (cat is not null) return cat.CategoryName;
        }
        return _categories.FirstOrDefault(c => c.Id == categoryId)?.Name ?? "Nieznana";
    }

