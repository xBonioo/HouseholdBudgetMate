    private string GetYearSummaryTitle()
    {
        var period = GetYearSummaryPeriod();
        var rangeLabel = period.MonthsCount > 0
            ? $" · {GetMonthName(period.StartMonth)}–{GetMonthName(period.EndMonth)}"
            : string.Empty;

        return $"Podsumowanie roczne (rok {_selectedYear}{rangeLabel})";
    }

    private YearSummaryPeriod GetYearSummaryPeriod()
    {
        var months = _statistics.MonthlyFinance
            .Select(x => x.Month)
            .Where(x => x is >= 1 and <= 12)
            .OrderBy(x => x)
            .ToList();

        if (months.Count == 0)
        {
            return new YearSummaryPeriod(1, 1, 0);
        }

        var today = DateTimeProvider.GetLocalDateOnly();
        var startMonth = months[0];
        var endMonth = _selectedYear == today.Year
            ? Math.Max(startMonth, today.Month)
            : months[^1];

        return new YearSummaryPeriod(startMonth, endMonth, endMonth - startMonth + 1);
    }

    private IReadOnlyList<YearSummaryRow> GetYearSummaryRows()
    {
        var period = GetYearSummaryPeriod();
        var monthsCount = Math.Max(period.MonthsCount, 1);
        var relevantMonths = _statistics.MonthlyFinance
            .Where(x => x.Month >= period.StartMonth && x.Month <= period.EndMonth);
        var rows = relevantMonths.ToList();
        var totalIncome = rows.Sum(x => x.IncomeAmount);
        var totalSpent = rows.Sum(x => x.SpentAmount);
        var totalSaved = rows.Sum(x => x.SavedAmount);

        return
        [
            new YearSummaryRow("Wpływy", totalIncome, totalIncome / monthsCount),
            new YearSummaryRow("Wydatki", totalSpent, totalSpent / monthsCount),
            new YearSummaryRow("Zaoszczędzone", totalSaved, totalSaved / monthsCount)
        ];
    }

