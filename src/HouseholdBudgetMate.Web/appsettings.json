{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Application": {
    "Name": "HouseholdBudgetMate",
    "Title": "Household Budget Mate",
    "ServiceName": "HouseholdBudgetMate",
    "Timezone": "Central European Standard Time",
    "MigrateDatabaseOnStart": true,
    "LogCleanupTask": true,
    "LogRetentionDays": 30,
    "SeedDataToDatabase": false
  },
  "Blazor": {
    "DetailedErrors": false
  },
  "FileStorage": {
    "EnablePublicFileServing": false
  },
  "WebHosting": {
    "HttpPort": 5000,
    "HttpsPort": 5001,
    "EnableLanAccess": true,
    "OpenBrowserOnStartup": false
  },
  "AllowedHosts": "*"
}
